{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:tooling:bounded-ci-migration-slice:v0.1",
  "title": "UU-AAP Bounded CI Migration Slice v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "version",
    "origin_frontier",
    "historical_workflow",
    "baseline_path",
    "target_component_id",
    "migrated_step_name",
    "current_step_name",
    "parent_manifest_paths",
    "component_ids",
    "rollback_commands",
    "expected_parent_command_count",
    "expected_slice_command_count",
    "expected_parent_plan_digest",
    "claims",
    "non_effects"
  ],
  "properties": {
    "artifact_type": { "const": "UU-AAP-Bounded-CI-Migration-Slice" },
    "version": { "const": "0.1" },
    "origin_frontier": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "historical_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "frontier", "blob_sha"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "frontier": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "baseline_path": { "type": "string", "minLength": 1 },
    "target_component_id": { "type": "string", "minLength": 1 },
    "migrated_step_name": { "type": "string", "minLength": 1 },
    "current_step_name": { "type": "string", "minLength": 1 },
    "parent_manifest_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "component_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "rollback_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/command" }
    },
    "expected_parent_command_count": { "type": "integer", "minimum": 1 },
    "expected_slice_command_count": { "type": "integer", "minimum": 1 },
    "expected_parent_plan_digest": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bulk_ci_migration_authorized", "authority_created", "compatibility_proven", "substitutability_proven"],
      "properties": {
        "bulk_ci_migration_authorized": { "const": false },
        "authority_created": { "const": false },
        "compatibility_proven": { "const": false },
        "substitutability_proven": { "const": false }
      }
    },
    "non_effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args"],
      "properties": {
        "executable": { "enum": ["node", "python", "python3"] },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
