{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:tooling:generated-conformance-execution-receipt:v0.1",
  "title": "UU-AAP Generated Conformance Execution Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "version", "runner_origin_frontier", "target_component_id", "mode",
    "source_workflow", "plan_digest", "planned_command_count", "attempted_command_count",
    "succeeded_command_count", "failed_command_count", "stopped_early",
    "repository_changed_after_run", "result", "commands", "claims", "non_effects"
  ],
  "properties": {
    "artifact_type": { "const": "UU-AAP-Generated-Conformance-Execution-Receipt" },
    "version": { "const": "0.1" },
    "runner_origin_frontier": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "target_component_id": { "type": "string", "minLength": 1 },
    "mode": { "const": "PREDECESSOR_ONLY" },
    "source_workflow": {
      "type": "object", "additionalProperties": false, "required": ["path", "blob_sha"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "plan_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "planned_command_count": { "type": "integer", "minimum": 1 },
    "attempted_command_count": { "type": "integer", "minimum": 0 },
    "succeeded_command_count": { "type": "integer", "minimum": 0 },
    "failed_command_count": { "type": "integer", "minimum": 0 },
    "stopped_early": { "type": "boolean" },
    "repository_changed_after_run": { "type": "boolean" },
    "result": { "enum": ["SUCCESS", "FAILED", "REPOSITORY_MUTATED"] },
    "commands": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "sequence", "component_id", "executable", "args", "exit_code", "signal", "success",
          "stdout_sha256", "stderr_sha256", "stdout_bytes", "stderr_bytes", "error_code"
        ],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "component_id": { "type": "string", "minLength": 1 },
          "executable": { "enum": ["node", "python", "python3"] },
          "args": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "exit_code": { "type": ["integer", "null"] },
          "signal": { "type": ["string", "null"] },
          "success": { "type": "boolean" },
          "stdout_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "stderr_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "stdout_bytes": { "type": "integer", "minimum": 0 },
          "stderr_bytes": { "type": "integer", "minimum": 0 },
          "error_code": { "type": ["string", "null"] }
        }
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": [
        "all_commands_succeeded", "compatibility_proven", "semantic_truth_established",
        "authority_created", "external_effect_authorized", "ci_narrowing_authorized",
        "product_runtime_activated"
      ],
      "properties": {
        "all_commands_succeeded": { "type": "boolean" },
        "compatibility_proven": { "const": false },
        "semantic_truth_established": { "const": false },
        "authority_created": { "const": false },
        "external_effect_authorized": { "const": false },
        "ci_narrowing_authorized": { "const": false },
        "product_runtime_activated": { "const": false }
      }
    },
    "non_effects": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
