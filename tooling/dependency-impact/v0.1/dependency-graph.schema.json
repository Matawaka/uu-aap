{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:tooling:dependency-graph:v0.1",
  "title": "UU-AAP Dependency Graph v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "version",
    "components",
    "edges",
    "unresolved_required_dependencies",
    "cycles",
    "non_effects"
  ],
  "properties": {
    "artifact_type": { "const": "UU-AAP-Dependency-Graph" },
    "version": { "const": "0.1" },
    "components": { "type": "array", "items": { "type": "object" } },
    "edges": { "type": "array", "items": { "type": "object" } },
    "unresolved_required_dependencies": { "type": "array", "items": { "type": "object" } },
    "cycles": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" } }
    },
    "non_effects": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
