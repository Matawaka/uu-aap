{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:tooling:impact-result:v0.1",
  "title": "UU-AAP Impact Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "version",
    "change",
    "directly_changed_components",
    "affected_components",
    "conformance_commands",
    "unresolved_required_dependencies",
    "non_effects"
  ],
  "properties": {
    "artifact_type": { "const": "UU-AAP-Impact-Result" },
    "version": { "const": "0.1" },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "values"],
      "properties": {
        "kind": { "enum": ["COMPONENT", "PATH"] },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "directly_changed_components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "affected_components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "conformance_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "executable", "args"],
        "properties": {
          "component_id": { "type": "string" },
          "executable": { "enum": ["node", "python", "python3"] },
          "args": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "unresolved_required_dependencies": { "type": "array", "items": { "type": "object" } },
    "non_effects": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
