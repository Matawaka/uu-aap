{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/proposals/ccrp/schema/collision-result.c1.schema.json",
  "title": "CCRP/C1 Collision Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "ccrp_version",
    "conformance_level",
    "result_id",
    "evaluated_at",
    "operation_refs",
    "current_revision",
    "collision_type",
    "blocking",
    "reason_codes",
    "source_intents_preserved",
    "resolution_status",
    "claims"
  ],
  "properties": {
    "artifact_type": {"const": "CCRPCollisionResult"},
    "artifact_version": {"const": "0.1-experimental"},
    "ccrp_version": {"const": "0.1"},
    "conformance_level": {"const": "CCRP/C1"},
    "result_id": {"type": "string", "pattern": "^urn:ccrp:collision-result:"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "operation_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^urn:ccrp:operation:"}
    },
    "current_revision": {"type": "string", "minLength": 1},
    "collision_type": {
      "enum": [
        "no_collision",
        "stale_base",
        "duplicate_operation",
        "wrong_context",
        "exclusive_operation_collision"
      ]
    },
    "blocking": {"type": "boolean"},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_intents_preserved": {"const": true},
    "resolution_status": {"enum": ["not_required", "unresolved"]},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collision_checked",
        "collision_detected",
        "collision_resolved",
        "execution_admitted",
        "current_execution_owner_established",
        "lease_established",
        "materialization_permitted",
        "canonical_state_established",
        "poai_authority_established",
        "universal_canonicality_established",
        "truth_certified",
        "causal_proof_certified",
        "legal_responsibility_determined",
        "moral_correctness_established",
        "legal_effect_established",
        "poai_v_conformance_established"
      ],
      "properties": {
        "collision_checked": {"const": true},
        "collision_detected": {"type": "boolean"},
        "collision_resolved": {"const": false},
        "execution_admitted": {"const": false},
        "current_execution_owner_established": {"const": false},
        "lease_established": {"const": false},
        "materialization_permitted": {"const": false},
        "canonical_state_established": {"const": false},
        "poai_authority_established": {"const": false},
        "universal_canonicality_established": {"const": false},
        "truth_certified": {"const": false},
        "causal_proof_certified": {"const": false},
        "legal_responsibility_determined": {"const": false},
        "moral_correctness_established": {"const": false},
        "legal_effect_established": {"const": false},
        "poai_v_conformance_established": {"const": false}
      }
    }
  }
}
