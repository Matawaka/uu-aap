{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/proposals/ccrp/schema/work-context.c0.schema.json",
  "title": "CCRP/C0 Work Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "ccrp_version",
    "conformance_level",
    "context_id",
    "origin",
    "intent",
    "target_scope",
    "base_revision",
    "epoch",
    "fencing_token",
    "state",
    "owner",
    "lease",
    "blocking_conflicts",
    "last_canonical_revision",
    "provenance",
    "claims"
  ],
  "properties": {
    "artifact_type": {"const": "CCRPWorkContext"},
    "artifact_version": {"const": "0.1-experimental"},
    "ccrp_version": {"const": "0.1"},
    "conformance_level": {"const": "CCRP/C0"},
    "context_id": {"type": "string", "pattern": "^urn:ccrp:context:"},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "session_id"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1}
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "revision", "digest"],
      "properties": {
        "intent_id": {"type": "string", "pattern": "^urn:ccrp:intent:"},
        "revision": {"type": "integer", "minimum": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "target_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "base_revision": {"type": "string", "minLength": 1},
    "epoch": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "state": {"const": "declared"},
    "owner": {"type": "null"},
    "lease": {"type": "null"},
    "blocking_conflicts": {"type": "array", "maxItems": 0},
    "last_canonical_revision": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_identified",
        "execution_admitted",
        "current_execution_owner_established",
        "lease_established",
        "canonical_state_established",
        "poai_authority_established",
        "universal_canonicality_established",
        "truth_certified",
        "causal_proof_certified",
        "legal_responsibility_determined",
        "moral_correctness_established",
        "legal_effect_established",
        "poai_v_conformance_established"
      ],
      "properties": {
        "context_identified": {"const": true},
        "execution_admitted": {"const": false},
        "current_execution_owner_established": {"const": false},
        "lease_established": {"const": false},
        "canonical_state_established": {"const": false},
        "poai_authority_established": {"const": false},
        "universal_canonicality_established": {"const": false},
        "truth_certified": {"const": false},
        "causal_proof_certified": {"const": false},
        "legal_responsibility_determined": {"const": false},
        "moral_correctness_established": {"const": false},
        "legal_effect_established": {"const": false},
        "poai_v_conformance_established": {"const": false}
      }
    }
  }
}
