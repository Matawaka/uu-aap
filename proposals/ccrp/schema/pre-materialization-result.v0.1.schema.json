{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/proposals/ccrp/schema/pre-materialization-result.v0.1.schema.json",
  "title": "PoAI + CCRP Pre-Materialization Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "mode",
    "decision_id",
    "evaluated_at",
    "requested_action",
    "requested_target",
    "policy_ref",
    "authority_verification_ref",
    "ccrp_execution_admission_ref",
    "ccrp_operation_ref",
    "decision",
    "reason_codes",
    "checks",
    "source_artifacts_preserved",
    "claims"
  ],
  "properties": {
    "artifact_type": {"const": "PoAICCRPPreMaterializationResult"},
    "artifact_version": {"const": "0.1-experimental"},
    "mode": {"const": "dry_run_ci_only"},
    "decision_id": {"type": "string", "pattern": "^urn:poai-ccrp:pre-materialization:"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "requested_action": {"const": "poai.successor.materialization.execute"},
    "requested_target": {"type": "string", "minLength": 1},
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "digest"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^urn:poai:materialization-policy:"},
        "policy_version": {"type": "integer", "minimum": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "authority_verification_ref": {"type": "string", "pattern": "^urn:poai:authority-verification:"},
    "ccrp_execution_admission_ref": {"type": "string", "pattern": "^urn:ccrp:execution-admission-result:"},
    "ccrp_operation_ref": {"type": "string", "pattern": "^urn:ccrp:operation:"},
    "decision": {"enum": ["permitted", "not_permitted"]},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_valid",
        "authority_result_valid",
        "authority_result_established",
        "issuer_entitlement_established",
        "materialization_authority_established",
        "authority_scope_exact",
        "authority_target_exact",
        "policy_binding_exact",
        "ccrp_admission_valid",
        "ccrp_execution_admitted",
        "ccrp_current_owner_established",
        "ccrp_lease_established",
        "ccrp_operation_ref_exact",
        "ccrp_action_exact",
        "ccrp_target_exact",
        "ccrp_revision_binding_exact",
        "ccrp_did_not_self_permit_materialization"
      ],
      "properties": {
        "policy_valid": {"type": "boolean"},
        "authority_result_valid": {"type": "boolean"},
        "authority_result_established": {"type": "boolean"},
        "issuer_entitlement_established": {"type": "boolean"},
        "materialization_authority_established": {"type": "boolean"},
        "authority_scope_exact": {"type": "boolean"},
        "authority_target_exact": {"type": "boolean"},
        "policy_binding_exact": {"type": "boolean"},
        "ccrp_admission_valid": {"type": "boolean"},
        "ccrp_execution_admitted": {"type": "boolean"},
        "ccrp_current_owner_established": {"type": "boolean"},
        "ccrp_lease_established": {"type": "boolean"},
        "ccrp_operation_ref_exact": {"type": "boolean"},
        "ccrp_action_exact": {"type": "boolean"},
        "ccrp_target_exact": {"type": "boolean"},
        "ccrp_revision_binding_exact": {"type": "boolean"},
        "ccrp_did_not_self_permit_materialization": {"type": "boolean"}
      }
    },
    "source_artifacts_preserved": {"const": true},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "poai_authority_input_established",
        "ccrp_execution_admission_input_established",
        "pre_materialization_permit_established",
        "materialization_permitted",
        "materialization_event_recorded",
        "successor_record_published",
        "repository_mutation_performed",
        "automatic_browser_action_performed",
        "canonical_state_established",
        "policy_relative_canonicality_established",
        "universal_canonicality_established",
        "truth_certified",
        "causal_proof_certified",
        "legal_responsibility_determined",
        "moral_correctness_established",
        "legal_authority_established",
        "legal_effect_established",
        "poai_v_conformance_established"
      ],
      "properties": {
        "poai_authority_input_established": {"type": "boolean"},
        "ccrp_execution_admission_input_established": {"type": "boolean"},
        "pre_materialization_permit_established": {"type": "boolean"},
        "materialization_permitted": {"type": "boolean"},
        "materialization_event_recorded": {"const": false},
        "successor_record_published": {"const": false},
        "repository_mutation_performed": {"const": false},
        "automatic_browser_action_performed": {"const": false},
        "canonical_state_established": {"const": false},
        "policy_relative_canonicality_established": {"const": false},
        "universal_canonicality_established": {"const": false},
        "truth_certified": {"const": false},
        "causal_proof_certified": {"const": false},
        "legal_responsibility_determined": {"const": false},
        "moral_correctness_established": {"const": false},
        "legal_authority_established": {"const": false},
        "legal_effect_established": {"const": false},
        "poai_v_conformance_established": {"const": false}
      }
    }
  }
}
