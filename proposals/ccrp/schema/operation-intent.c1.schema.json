{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/proposals/ccrp/schema/operation-intent.c1.schema.json",
  "title": "CCRP/C1 Operation Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "ccrp_version",
    "conformance_level",
    "operation_id",
    "context_ref",
    "action",
    "target",
    "concurrency_class",
    "base_revision",
    "observed_current_revision",
    "idempotency_key",
    "read_set",
    "write_set",
    "created_at",
    "claims"
  ],
  "properties": {
    "artifact_type": {"const": "CCRPOperationIntent"},
    "artifact_version": {"const": "0.1-experimental"},
    "ccrp_version": {"const": "0.1"},
    "conformance_level": {"const": "CCRP/C1"},
    "operation_id": {"type": "string", "pattern": "^urn:ccrp:operation:"},
    "context_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "actor_id",
        "session_id",
        "intent_id",
        "intent_revision",
        "intent_digest"
      ],
      "properties": {
        "context_id": {"type": "string", "pattern": "^urn:ccrp:context:"},
        "actor_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "intent_id": {"type": "string", "pattern": "^urn:ccrp:intent:"},
        "intent_revision": {"type": "integer", "minimum": 1},
        "intent_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "action": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "concurrency_class": {
      "enum": ["commutative", "mergeable", "exclusive"]
    },
    "base_revision": {"type": "string", "minLength": 1},
    "observed_current_revision": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "read_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "write_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_bound",
        "collision_checked",
        "execution_admitted",
        "current_execution_owner_established",
        "lease_established",
        "materialization_permitted",
        "canonical_state_established",
        "poai_authority_established",
        "universal_canonicality_established",
        "truth_certified",
        "causal_proof_certified",
        "legal_responsibility_determined",
        "moral_correctness_established",
        "legal_effect_established",
        "poai_v_conformance_established"
      ],
      "properties": {
        "context_bound": {"const": true},
        "collision_checked": {"const": false},
        "execution_admitted": {"const": false},
        "current_execution_owner_established": {"const": false},
        "lease_established": {"const": false},
        "materialization_permitted": {"const": false},
        "canonical_state_established": {"const": false},
        "poai_authority_established": {"const": false},
        "universal_canonicality_established": {"const": false},
        "truth_certified": {"const": false},
        "causal_proof_certified": {"const": false},
        "legal_responsibility_determined": {"const": false},
        "moral_correctness_established": {"const": false},
        "legal_effect_established": {"const": false},
        "poai_v_conformance_established": {"const": false}
      }
    }
  }
}
