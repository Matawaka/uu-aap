{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/proposals/ccrp/schema/coordination-state.c4.schema.json",
  "title": "CCRP/C4 Coordination State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "ccrp_version",
    "conformance_level",
    "state_id",
    "context_id",
    "origin_ref",
    "intent_ref",
    "coordination_status",
    "owner",
    "epoch",
    "fencing_token",
    "active_lease_ref",
    "historical_lease_refs",
    "operation_scope",
    "target_scope",
    "last_canonical_revision",
    "last_transition_ref",
    "claims"
  ],
  "properties": {
    "artifact_type": {"const": "CCRPCoordinationState"},
    "artifact_version": {"const": "0.1-experimental"},
    "ccrp_version": {"const": "0.1"},
    "conformance_level": {"const": "CCRP/C4"},
    "state_id": {"type": "string", "pattern": "^urn:ccrp:coordination-state:"},
    "context_id": {"type": "string", "pattern": "^urn:ccrp:context:"},
    "origin_ref": {"$ref": "#/$defs/owner"},
    "intent_ref": {"$ref": "#/$defs/intent"},
    "coordination_status": {"enum": ["active", "paused"]},
    "owner": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/owner"}]},
    "epoch": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "active_lease_ref": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^urn:ccrp:lease:"}
      ]
    },
    "historical_lease_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^urn:ccrp:lease:"}
    },
    "operation_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "target_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "last_canonical_revision": {"type": "string", "minLength": 1},
    "last_transition_ref": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^urn:ccrp:coordination-transition:"}
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cross_context_coordination_state_established",
        "pause_barrier_established",
        "current_execution_owner_established",
        "execution_admitted",
        "materialization_permitted",
        "canonical_state_established",
        "poai_authority_established",
        "policy_relative_canonicality_established",
        "universal_canonicality_established",
        "truth_certified",
        "causal_proof_certified",
        "legal_responsibility_determined",
        "moral_correctness_established",
        "legal_authority_established",
        "legal_effect_established",
        "poai_v_conformance_established"
      ],
      "properties": {
        "cross_context_coordination_state_established": {"const": true},
        "pause_barrier_established": {"type": "boolean"},
        "current_execution_owner_established": {"type": "boolean"},
        "execution_admitted": {"const": false},
        "materialization_permitted": {"const": false},
        "canonical_state_established": {"const": false},
        "poai_authority_established": {"const": false},
        "policy_relative_canonicality_established": {"const": false},
        "universal_canonicality_established": {"const": false},
        "truth_certified": {"const": false},
        "causal_proof_certified": {"const": false},
        "legal_responsibility_determined": {"const": false},
        "moral_correctness_established": {"const": false},
        "legal_authority_established": {"const": false},
        "legal_effect_established": {"const": false},
        "poai_v_conformance_established": {"const": false}
      }
    }
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "session_id"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1}
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "intent_revision", "intent_digest"],
      "properties": {
        "intent_id": {"type": "string", "pattern": "^urn:ccrp:intent:"},
        "intent_revision": {"type": "integer", "minimum": 1},
        "intent_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"coordination_status": {"const": "paused"}}},
      "then": {
        "properties": {
          "active_lease_ref": {"const": null},
          "claims": {
            "properties": {
              "pause_barrier_established": {"const": true},
              "current_execution_owner_established": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"coordination_status": {"const": "active"}}},
      "then": {
        "properties": {
          "active_lease_ref": {"type": "string", "pattern": "^urn:ccrp:lease:"},
          "claims": {
            "properties": {
              "pause_barrier_established": {"const": false},
              "current_execution_owner_established": {"const": true}
            }
          }
        }
      }
    }
  ]
}
