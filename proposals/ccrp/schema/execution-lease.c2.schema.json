{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/proposals/ccrp/schema/execution-lease.c2.schema.json",
  "title": "CCRP/C2 Execution Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "artifact_version",
    "ccrp_version",
    "conformance_level",
    "lease_id",
    "execution_lineage_id",
    "context_ref",
    "epoch",
    "fencing_token",
    "operation_scope",
    "target_scope",
    "issued_revision",
    "issued_at",
    "expires_at",
    "status",
    "supersedes_lease_ref",
    "superseded_by_lease_ref",
    "claims"
  ],
  "properties": {
    "artifact_type": {"const": "CCRPExecutionLease"},
    "artifact_version": {"const": "0.1-experimental"},
    "ccrp_version": {"const": "0.1"},
    "conformance_level": {"const": "CCRP/C2"},
    "lease_id": {"type": "string", "pattern": "^urn:ccrp:lease:"},
    "execution_lineage_id": {"type": "string", "pattern": "^urn:ccrp:execution-lineage:"},
    "context_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "actor_id",
        "session_id",
        "intent_id",
        "intent_revision",
        "intent_digest"
      ],
      "properties": {
        "context_id": {"type": "string", "pattern": "^urn:ccrp:context:"},
        "actor_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "intent_id": {"type": "string", "pattern": "^urn:ccrp:intent:"},
        "intent_revision": {"type": "integer", "minimum": 1},
        "intent_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "epoch": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "operation_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "target_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "issued_revision": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active", "superseded", "expired"]},
    "supersedes_lease_ref": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^urn:ccrp:lease:"}
      ]
    },
    "superseded_by_lease_ref": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^urn:ccrp:lease:"}
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_established",
        "current_execution_owner_established",
        "execution_admitted",
        "materialization_permitted",
        "canonical_state_established",
        "poai_authority_established",
        "historical_provenance_preserved",
        "universal_canonicality_established",
        "truth_certified",
        "causal_proof_certified",
        "legal_responsibility_determined",
        "moral_correctness_established",
        "legal_effect_established",
        "poai_v_conformance_established"
      ],
      "properties": {
        "lease_established": {"const": true},
        "current_execution_owner_established": {"type": "boolean"},
        "execution_admitted": {"const": false},
        "materialization_permitted": {"const": false},
        "canonical_state_established": {"const": false},
        "poai_authority_established": {"const": false},
        "historical_provenance_preserved": {"const": true},
        "universal_canonicality_established": {"const": false},
        "truth_certified": {"const": false},
        "causal_proof_certified": {"const": false},
        "legal_responsibility_determined": {"const": false},
        "moral_correctness_established": {"const": false},
        "legal_effect_established": {"const": false},
        "poai_v_conformance_established": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "active"}}},
      "then": {
        "properties": {
          "claims": {
            "properties": {
              "current_execution_owner_established": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["superseded", "expired"]}}},
      "then": {
        "properties": {
          "claims": {
            "properties": {
              "current_execution_owner_established": {"const": false}
            }
          }
        }
      }
    }
  ]
}
