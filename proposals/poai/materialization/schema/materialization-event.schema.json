{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/proposals/poai/materialization/schema/materialization-event.schema.json",
  "title": "PoAI Materialization Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_version", "materialization_event_id", "recorded_at", "source_record_ref", "successor_proposal_ref", "candidate_successor", "materialization_policy", "authority_evaluation", "contest_or_stay", "conflict_state", "preservation_check", "verification_results", "declared_disposition", "canonicality_claim", "claims"],
  "properties": {
    "artifact_type": {"const": "PoAIMaterializationEvent"},
    "artifact_version": {"const": "0.1-experimental"},
    "materialization_event_id": {"type": "string", "pattern": "^urn:poai:materialization:"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "source_record_ref": {"type": "object", "additionalProperties": false, "required": ["record_id", "record_version"], "properties": {"record_id": {"type": "string", "minLength": 1}, "record_version": {"type": "integer", "minimum": 1}}},
    "successor_proposal_ref": {"type": "string", "minLength": 1},
    "candidate_successor": {"$ref": "#/$defs/boundArtifact"},
    "materialization_policy": {"type": "object", "additionalProperties": false, "required": ["policy_id", "policy_version", "digest"], "properties": {"policy_id": {"type": "string", "minLength": 1}, "policy_version": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "authority_evaluation": {"type": "object", "additionalProperties": false, "required": ["subject", "scope", "target", "valid_from", "valid_until", "delegation_mode", "delegated_from", "issuer_entitlement_verified", "authority_verified", "evidence_refs"], "properties": {"subject": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "valid_from": {"type": "string", "format": "date-time"}, "valid_until": {"type": ["string", "null"], "format": "date-time"}, "delegation_mode": {"enum": ["non_delegable", "delegable"]}, "delegated_from": {"type": ["string", "null"]}, "issuer_entitlement_verified": {"type": "boolean"}, "authority_verified": {"type": "boolean"}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "contest_or_stay": {"type": "object", "additionalProperties": false, "required": ["active_stay", "refs"], "properties": {"active_stay": {"type": "boolean"}, "refs": {"type": "array", "items": {"type": "string"}}}},
    "conflict_state": {"type": "object", "additionalProperties": false, "required": ["status", "candidate_refs"], "properties": {"status": {"enum": ["none", "unresolved", "resolved"]}, "candidate_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "preservation_check": {"type": "object", "additionalProperties": false, "required": ["decision_boundary_unchanged", "future_target_unchanged", "availability_unchanged", "consideration_unchanged", "authority_mapping_unchanged"], "properties": {"decision_boundary_unchanged": {"type": "boolean"}, "future_target_unchanged": {"type": "boolean"}, "availability_unchanged": {"type": "boolean"}, "consideration_unchanged": {"type": "boolean"}, "authority_mapping_unchanged": {"type": "boolean"}}},
    "verification_results": {"type": "object", "additionalProperties": {"type": "boolean"}, "minProperties": 1},
    "declared_disposition": {"enum": ["materialized", "rejected", "deferred", "stayed", "conflicted", "indeterminate"]},
    "canonicality_claim": {"type": "object", "additionalProperties": false, "required": ["status", "scope", "policy_ref", "materialization_event_ref"], "properties": {"status": {"enum": ["unmaterialized", "materialized", "contested", "superseded", "unresolved"]}, "scope": {"type": "string", "minLength": 1}, "policy_ref": {"type": "string", "minLength": 1}, "materialization_event_ref": {"type": "string", "minLength": 1}}},
    "claims": {"type": "object", "additionalProperties": false, "required": ["materialization_event_recorded", "policy_evaluation_passed", "policy_relative_canonicality_established", "universal_canonicality_established", "truth_certified", "causal_proof_certified", "legal_responsibility_determined", "moral_correctness_established", "poai_v_conformance_established"], "properties": {"materialization_event_recorded": {"type": "boolean"}, "policy_evaluation_passed": {"type": "boolean"}, "policy_relative_canonicality_established": {"type": "boolean"}, "universal_canonicality_established": {"const": false}, "truth_certified": {"const": false}, "causal_proof_certified": {"const": false}, "legal_responsibility_determined": {"const": false}, "moral_correctness_established": {"const": false}, "poai_v_conformance_established": {"const": false}}}
  },
  "$defs": {
    "digest": {"type": "object", "additionalProperties": false, "required": ["canonicalization", "digest_algorithm", "digest_encoding", "value"], "properties": {"canonicalization": {"const": "RFC8785-JCS"}, "digest_algorithm": {"const": "SHA-256"}, "digest_encoding": {"const": "hex"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "boundArtifact": {"type": "object", "additionalProperties": false, "required": ["record_id", "record_version", "digest"], "properties": {"record_id": {"type": "string", "minLength": 1}, "record_version": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/digest"}}}
  }
}
