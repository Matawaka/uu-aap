{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/proposals/poai/authority/schema/authority-root.schema.json",
  "title": "PoAI Authority Root",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_version", "root_id", "root_version", "root_mode", "governance_scope", "target", "accepted_actions", "controller_rule", "root_evidence_rule", "effective_from", "effective_until", "delegation_policy", "policy_control_rule", "transition", "claims"],
  "properties": {
    "artifact_type": {"const": "PoAIAuthorityRoot"},
    "artifact_version": {"const": "0.1-experimental"},
    "root_id": {"type": "string", "pattern": "^urn:poai:authority-root:"},
    "root_version": {"type": "integer", "minimum": 1},
    "root_mode": {"enum": ["self_governed_resource", "institutional_charter", "contractual_root", "registry_root", "statutory_root", "quorum_root"]},
    "governance_scope": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "accepted_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "controller_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "controller_id", "controller_key_ref"],
      "properties": {
        "mode": {"const": "single_controller"},
        "controller_id": {"type": "string", "minLength": 1},
        "controller_key_ref": {"type": "string", "minLength": 1}
      }
    },
    "root_evidence_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "resource", "accepted_evidence_types"],
      "properties": {
        "mode": {"enum": ["repository_control_publication", "charter", "contract", "registry", "statutory_instrument", "quorum"]},
        "resource": {"type": "string", "minLength": 1},
        "accepted_evidence_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "effective_from": {"type": "string", "format": "date-time"},
    "effective_until": {"type": ["string", "null"], "format": "date-time"},
    "delegation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_depth"],
      "properties": {
        "mode": {"enum": ["non_delegable", "delegable"]},
        "max_depth": {"type": "integer", "minimum": 0}
      }
    },
    "policy_control_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_scope"],
      "properties": {"required_scope": {"const": "poai.materialization.policy.control"}}
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "previous_root_ref", "authorized_by_previous_controller", "authorization_evidence_refs"],
      "properties": {
        "status": {"enum": ["genesis", "superseding", "revoked"]},
        "previous_root_ref": {"type": ["string", "null"]},
        "authorized_by_previous_controller": {"type": ["boolean", "null"]},
        "authorization_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_identity_verified", "legal_authority_established", "universal_authority_established", "truth_certified", "causal_proof_certified", "legal_responsibility_determined", "moral_correctness_established", "poai_v_conformance_established"],
      "properties": {
        "legal_identity_verified": {"const": false},
        "legal_authority_established": {"const": false},
        "universal_authority_established": {"const": false},
        "truth_certified": {"const": false},
        "causal_proof_certified": {"const": false},
        "legal_responsibility_determined": {"const": false},
        "moral_correctness_established": {"const": false},
        "poai_v_conformance_established": {"const": false}
      }
    },
    "notes": {"type": ["string", "null"]}
  }
}
