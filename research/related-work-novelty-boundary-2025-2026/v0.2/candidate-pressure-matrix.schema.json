{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:matawaka:research:novelty-pressure-matrix:2025-2026:v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "predecessor", "candidates"],
  "properties": {
    "schema": {"const": "matawaka.novelty-pressure-matrix/2025-2026/v0.2"},
    "predecessor": {"const": "80850c1fb3da81b5af40049b35473e4c50123218"},
    "candidates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "v01_claim", "result", "pressure_sources", "pressure_reason", "surviving_claim", "forbidden_claims", "required_next_evidence", "novelty_established"],
      "properties": {
        "id": {"enum": ["SNE_HEC", "COMMON_NON_EFFECTS", "AVAILABLE_CONSIDERED_AUTHORITY", "TYPED_CONTINUITY", "CROSS_DOMAIN_REUSE"]},
        "v01_claim": {"type": "string", "minLength": 1},
        "result": {"enum": ["SURVIVES_BOUNDED_PRESSURE", "MATERIALLY_NARROWED", "DEFEATED_AS_NOVELTY_CANDIDATE", "INSUFFICIENT_EVIDENCE"]},
        "pressure_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "pressure_reason": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "surviving_claim": {"type": ["string", "null"]},
        "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_next_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "novelty_established": {"const": false}
      }
    }
  }
}
