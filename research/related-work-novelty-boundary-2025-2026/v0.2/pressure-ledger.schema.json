{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:matawaka:research:novelty-pressure-ledger:2025-2026:v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "audit_as_of", "predecessor", "sources"],
  "properties": {
    "schema": {"const": "matawaka.novelty-pressure-ledger/2025-2026/v0.2"},
    "audit_as_of": {"const": "2026-09-07"},
    "predecessor": {"const": "80850c1fb3da81b5af40049b35473e4c50123218"},
    "sources": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "first_public_date", "status", "url", "date_basis", "pressure_targets", "overlap", "non_overlap"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "title": {"type": "string", "minLength": 1},
        "first_public_date": {"type": "string", "format": "date"},
        "status": {"enum": ["INDIVIDUAL_INTERNET_DRAFT", "PREPRINT", "SSRN_PREPRINT", "PUBLIC_GITHUB_IMPLEMENTATION", "INDUSTRY_RESEARCH_PUBLICATION"]},
        "url": {"type": "string", "format": "uri"},
        "date_basis": {"type": "string", "minLength": 1},
        "pressure_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["SNE_HEC", "COMMON_NON_EFFECTS", "AVAILABLE_CONSIDERED_AUTHORITY", "TYPED_CONTINUITY", "CROSS_DOMAIN_REUSE"]}
        },
        "overlap": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "non_overlap": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
