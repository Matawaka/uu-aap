{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:matawaka:research:foundational-pressure-matrix:v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "predecessor", "claims"],
  "properties": {
    "schema": {"const": "matawaka.foundational-pressure-matrix/v0.3"},
    "predecessor": {"const": "8aabf16b791ac3564c8178c4bf1e325bba5df59e"},
    "claims": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "v02_claim", "result", "foundational_sources", "pressure_reason", "surviving_claim", "engineering_value", "forbidden_claims", "required_next_evidence", "novelty_established"],
      "properties": {
        "id": {"enum": ["SNE_HEC", "COMMON_NON_EFFECTS", "AVAILABLE_CONSIDERED_AUTHORITY", "TYPED_CONTINUITY", "CROSS_DOMAIN_REUSE"]},
        "v02_claim": {"type": "string", "minLength": 1},
        "result": {"enum": ["SURVIVES_FOUNDATIONAL_PRESSURE", "MATERIALLY_NARROWED", "DEFEATED_AS_FOUNDATIONAL_NOVELTY_CANDIDATE", "INSUFFICIENT_EVIDENCE"]},
        "foundational_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "pressure_reason": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "surviving_claim": {"type": ["string", "null"]},
        "engineering_value": {"type": "string", "minLength": 1},
        "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_next_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "novelty_established": {"const": false}
      }
    }
  }
}
