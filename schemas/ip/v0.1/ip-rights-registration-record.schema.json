{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/schemas/ip/v0.1/ip-rights-registration-record.schema.json",
  "title": "UU-AAP IP Rights Registration Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "record_id",
    "state",
    "object",
    "evidence_anchor",
    "rights_review",
    "public_disclosure",
    "patentability",
    "registration_intent"
  ],
  "properties": {
    "record_version": {"const": "0.1"},
    "record_id": {"type": "string", "minLength": 1},
    "state": {
      "enum": [
        "DISCOVERED",
        "CLASSIFIED",
        "EVIDENCE_ANCHORED",
        "RIGHTS_REVIEW",
        "RIGHTS_CLEARED",
        "PATENT_SCREEN",
        "READY_TO_FILE",
        "FILED",
        "OFFICE_ACTION",
        "REGISTERED",
        "REFUSED",
        "WITHDRAWN",
        "SUPERSEDED"
      ]
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "title", "version", "classes"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "COPYRIGHT_EXPRESSION",
              "SOFTWARE",
              "DATABASE",
              "TECHNICAL_SOLUTION",
              "TRADEMARK_CANDIDATE",
              "THIRD_PARTY_OR_RESTRICTED",
              "NON_PROTECTABLE_ABSTRACTION"
            ]
          }
        },
        "description": {"type": "string"}
      }
    },
    "evidence_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit_sha", "paths", "digest_algorithm", "package_digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tag": {"type": ["string", "null"]},
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "digest_algorithm": {"enum": ["SHA-256", "SHA-512"]},
        "package_digest": {"type": "string", "minLength": 32},
        "claimed_creation_date": {"type": ["string", "null"], "format": "date"},
        "first_public_disclosure": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "rights_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authors", "right_holders", "third_party_status"],
      "properties": {
        "status": {"enum": ["NOT_STARTED", "IN_REVIEW", "CLEARED", "BLOCKED"]},
        "authors": {
          "type": "array",
          "items": {"$ref": "#/$defs/rightsParty"}
        },
        "right_holders": {
          "type": "array",
          "items": {"$ref": "#/$defs/rightsParty"}
        },
        "third_party_status": {"enum": ["CLEARED", "EXCLUDED", "PRESENT", "UNKNOWN"]},
        "unresolved_items": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "public_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["NOT_PUBLIC", "PUBLIC", "PARTIALLY_PUBLIC", "UNKNOWN"]},
        "earliest_known_at": {"type": ["string", "null"], "format": "date-time"},
        "evidence_ref": {"type": ["string", "null"]}
      }
    },
    "patentability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": [
            "NOT_PATENT_CANDIDATE",
            "PATENT_CANDIDATE_REVIEW_REQUIRED",
            "PATENT_FILING_FIRST",
            "PATENT_DECLINED_THEN_PUBLISH",
            "ALREADY_PUBLIC_DISCLOSURE_REVIEW_REQUIRED"
          ]
        },
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "reviewer_or_authority": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "registration_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jurisdiction", "route", "decision"],
      "properties": {
        "jurisdiction": {"type": "string", "minLength": 2},
        "route": {
          "enum": [
            "ROSPATENT_PROGRAM",
            "ROSPATENT_DATABASE",
            "RUSSIAN_TRADEMARK",
            "PATENT_REVIEW",
            "NO_FILING",
            "OTHER"
          ]
        },
        "decision": {"enum": ["PLANNED", "DEFERRED", "DECLINED", "FILED"]},
        "rationale": {"type": ["string", "null"]},
        "target_filing_date": {"type": ["string", "null"], "format": "date"}
      }
    },
    "filing": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "application_number": {"type": ["string", "null"]},
        "filing_date": {"type": ["string", "null"], "format": "date"},
        "fee_rub": {"type": ["number", "null"], "minimum": 0},
        "package_digest": {"type": ["string", "null"]},
        "external_receipt_ref": {"type": ["string", "null"]}
      }
    },
    "outcome": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "registration_number": {"type": ["string", "null"]},
        "decision_date": {"type": ["string", "null"], "format": "date"},
        "status": {"enum": ["REGISTERED", "REFUSED", "WITHDRAWN", "PENDING"]},
        "successor_record_id": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "rightsParty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "basis"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "basis": {
          "enum": [
            "AUTHOR_OWNED",
            "COAUTHORED",
            "EMPLOYEE_WORK",
            "COMMISSIONED_WITH_EXCLUSIVE_RIGHT",
            "ASSIGNED_EXCLUSIVE_RIGHT",
            "LICENSED_ONLY",
            "PUBLIC_DOMAIN_OR_NO_COPYRIGHT",
            "THIRD_PARTY",
            "UNKNOWN"
          ]
        },
        "contribution_scope": {"type": ["string", "null"]},
        "evidence_ref": {"type": ["string", "null"]}
      }
    }
  }
}
