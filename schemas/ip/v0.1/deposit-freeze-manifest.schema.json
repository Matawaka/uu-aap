{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/schemas/ip/v0.1/deposit-freeze-manifest.schema.json",
  "title": "UU-AAP Deposit Freeze Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "object_id",
    "title_ru",
    "title_en",
    "freeze_frontier",
    "first_public_disclosure",
    "patent_screen",
    "programming_languages",
    "program_size_bytes",
    "deposit_support_size_bytes",
    "deposit_total_size_bytes",
    "canonicalization",
    "package_digest_algorithm",
    "package_digest",
    "files",
    "abstract_ru",
    "abstract_characters"
  ],
  "properties": {
    "record_version": {"const": "0.1"},
    "object_id": {"type": "string", "minLength": 1},
    "title_ru": {"type": "string", "minLength": 1},
    "title_en": {"type": "string", "minLength": 1},
    "freeze_frontier": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "first_public_disclosure": {"type": "string", "format": "date-time"},
    "patent_screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["software_registration_scope", "public_disclosure_status", "separate_patent_track_issue", "technical_patent_rights_effect"],
      "properties": {
        "software_registration_scope": {"const": "PROGRAM_EXPRESSION_ONLY"},
        "public_disclosure_status": {"const": "ALREADY_PUBLIC"},
        "separate_patent_track_issue": {"type": "integer", "minimum": 1},
        "technical_patent_rights_effect": {"const": "PRESERVED_FOR_SEPARATE_REVIEW"}
      }
    },
    "programming_languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "program_size_bytes": {"type": "integer", "minimum": 1},
    "deposit_support_size_bytes": {"type": "integer", "minimum": 0},
    "deposit_total_size_bytes": {"type": "integer", "minimum": 1},
    "canonicalization": {"const": "UU-AAP-DEPOSIT-INVENTORY-v0.1"},
    "package_digest_algorithm": {"const": "SHA-256"},
    "package_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "size_bytes", "git_blob_sha1", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["PROGRAM_SOURCE", "IDENTIFYING_SCHEMA", "CONFORMANCE_FIXTURE"]},
          "size_bytes": {"type": "integer", "minimum": 1},
          "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "abstract_ru": {"type": "string", "minLength": 1, "maxLength": 900},
    "abstract_characters": {"type": "integer", "minimum": 1, "maximum": 900}
  }
}
