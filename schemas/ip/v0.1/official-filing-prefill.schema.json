{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/schemas/ip/v0.1/official-filing-prefill.schema.json",
  "title": "UU-AAP Official Filing Prefill v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prefill_version",
    "object_id",
    "authority",
    "object_type",
    "public_fixed_fields",
    "private_required_fields",
    "route_guidance",
    "unresolved_form_fields",
    "privacy_boundary"
  ],
  "properties": {
    "prefill_version": {"const": "0.1"},
    "object_id": {"type": "string", "minLength": 1},
    "authority": {"const": "ROSPATENT"},
    "object_type": {"const": "PROGRAM_FOR_COMPUTER"},
    "public_fixed_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_ru",
        "creation_year",
        "programming_language",
        "program_size_bytes",
        "frozen_package_digest",
        "applicant_count",
        "author_count",
        "gis_component"
      ],
      "properties": {
        "title_ru": {"type": "string", "minLength": 1},
        "creation_year": {"type": "integer", "minimum": 1900},
        "programming_language": {"type": "string", "minLength": 1},
        "program_size_bytes": {"type": "integer", "minimum": 1},
        "frozen_package_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "applicant_count": {"const": 1},
        "author_count": {"const": 1},
        "gis_component": {"const": false}
      }
    },
    "private_required_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicant", "author"],
      "properties": {
        "applicant": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "author": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "route_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_route", "reason", "signature_status"],
      "properties": {
        "recommended_route": {"enum": ["EPGU", "FIPS", "PAPER"]},
        "reason": {"type": "string", "minLength": 1},
        "signature_status": {"enum": ["LIVE_ROUTE_CONFIRMATION_REQUIRED", "CONFIRMED"]}
      }
    },
    "unresolved_form_fields": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "privacy_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_personal_identifiers", "safe_for_public_repository"],
      "properties": {
        "contains_personal_identifiers": {"const": false},
        "safe_for_public_repository": {"const": true}
      }
    }
  }
}
