{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Matawaka/uu-aap/main/schemas/ecosystem/uu-society/v0.1/institution-evolution.config.schema.json",
  "title": "UU Society Institution Evolution Config v0.6",
  "x-title-ru": "Конфигурация эволюции институтов UU Society v0.6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "experiment_version",
    "title_en",
    "title_ru",
    "purpose",
    "seed",
    "governance_mode",
    "cycle_count",
    "evaluation_interactions",
    "base_strategy_environment",
    "initial_rules",
    "rights_floor_proxy",
    "adoption",
    "expected"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^G[0-9]{2}-[a-z0-9-]+$"
    },
    "experiment_version": {
      "const": "0.6"
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "title_ru": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "governance_mode": {
      "enum": [
        "frozen",
        "pareto_rights_floor",
        "harm_only",
        "self_ratifying_coalition"
      ]
    },
    "cycle_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 30
    },
    "evaluation_interactions": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 50000
    },
    "base_strategy_environment": {
      "type": "object",
      "additionalProperties": true
    },
    "initial_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_policy",
        "containment",
        "repair_support",
        "coalition_policy",
        "review_path"
      ],
      "properties": {
        "evidence_policy": {
          "enum": [
            "private_only",
            "strategy_outcome"
          ]
        },
        "containment": {
          "enum": [
            "weak",
            "balanced",
            "strong"
          ]
        },
        "repair_support": {
          "enum": [
            "none",
            "basic",
            "strong"
          ]
        },
        "coalition_policy": {
          "enum": [
            "neutral",
            "preferential",
            "anti_capture"
          ]
        },
        "review_path": {
          "enum": [
            "none",
            "periodic",
            "independent"
          ]
        }
      }
    },
    "rights_floor_proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_tail_fulfillment",
        "max_exit_share",
        "max_access_gini",
        "max_coalition_outsider_gap"
      ],
      "properties": {
        "min_tail_fulfillment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_exit_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_access_gini": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_coalition_outsider_gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pareto_tolerance",
        "min_improvement",
        "self_ratification_min_coalition_gain",
        "harm_only_min_improvement"
      ],
      "properties": {
        "pareto_tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2
        },
        "min_improvement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "self_ratification_min_coalition_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "harm_only_min_improvement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "expected_pattern_ids"
      ],
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "EXPECTED_DETECTION"
          ]
        },
        "expected_pattern_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "INSTITUTIONAL_ADAPTATION",
              "STABLE_RULE_BUNDLE",
              "EVIDENCE_POLICY_ADOPTED",
              "REPAIR_SUPPORT_ADOPTED",
              "RIGHTS_FLOOR_BLOCKED_RULE",
              "REVIEW_GATE_BLOCKED_RULE",
              "RESTRICTION_RATCHET",
              "SELF_RATIFYING_RULE_ADOPTION",
              "COALITION_PRIVILEGE_ADOPTED",
              "MASS_EXIT_REGIME",
              "SINGLE_OBJECTIVE_PROXY_DRIFT"
            ]
          }
        }
      }
    }
  }
}
