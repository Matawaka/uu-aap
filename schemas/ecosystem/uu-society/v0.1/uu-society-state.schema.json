{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Matawaka/uu-aap/main/schemas/ecosystem/uu-society/v0.1/uu-society-state.schema.json",
  "title": "UU Society State Snapshot v0.1",
  "x-title-ru": "Снимок состояния UU Society v0.1",
  "description": "Experimental machine-readable state model for UU Society. It describes evidence-bounded social-economic state; it does not grant authority or create legal effect.",
  "x-description-ru": "Экспериментальная машиночитаемая модель состояния UU Society. Описывает доказательно ограниченное социально-экономическое состояние; не создаёт полномочий и юридических последствий.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "snapshot_id",
    "observed_at",
    "status",
    "constitutional_floor",
    "governance_cells",
    "actors",
    "personal_anchors",
    "intents",
    "needs",
    "capabilities",
    "resources",
    "evidence_events",
    "trust_states",
    "risk_harm_envelopes",
    "matches",
    "commitments",
    "arae_states",
    "action_leases",
    "actions",
    "outcomes",
    "receipts",
    "contributions",
    "repairs",
    "disputes",
    "failure_patterns"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "model_id": {
      "const": "urn:uu-aap:uu-society:model:0.1"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^urn:uu-aap:uu-society:snapshot:"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "const": "experimental_formal_model"
    },
    "constitutional_floor": {
      "$ref": "#/$defs/constitutionalFloor"
    },
    "governance_cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/governanceCell"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "personal_anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/personalAnchor"
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/intent"
      }
    },
    "needs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/need"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "evidence_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceEvent"
      }
    },
    "trust_states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trustState"
      }
    },
    "risk_harm_envelopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/riskHarmEnvelope"
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/match"
      }
    },
    "commitments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commitment"
      }
    },
    "arae_states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/araeState"
      }
    },
    "action_leases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionLease"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "contributions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contribution"
      }
    },
    "repairs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repair"
      }
    },
    "disputes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dispute"
      }
    },
    "failure_patterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failurePattern"
      }
    }
  },
  "$defs": {
    "entityHeader": {
      "type": "object",
      "required": [
        "id",
        "state",
        "created_at",
        "updated_at",
        "provenance_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:uu-aap:uu-society:[a-z0-9-]+:"
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "refList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^urn:uu-aap:uu-society:"
      }
    },
    "constitutionalFloor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_floor_id",
        "trust_independent",
        "protected_capabilities",
        "appeal_required_for_adverse_restriction"
      ],
      "properties": {
        "rights_floor_id": {
          "type": "string",
          "minLength": 1
        },
        "trust_independent": {
          "const": true
        },
        "protected_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "appeal_required_for_adverse_restriction": {
          "const": true
        }
      }
    },
    "governanceCell": {
      "type": "object",
      "x-title-en": "GovernanceCell",
      "x-title-ru": "Ячейка управления",
      "allOf": [
        {
          "$ref": "#/$defs/entityHeader"
        },
        {
          "type": "object",
          "required": [
            "jurisdiction",
            "rule_refs",
            "appeal_route_refs"
          ],
          "properties": {
            "state": {
              "enum": [
                "proposed",
                "active",
                "suspended",
                "retired"
              ]
            },
            "jurisdiction": {
              "type": "string",
              "minLength": 1
            },
            "rule_refs": {
              "$ref": "#/$defs/refList"
            },
            "parent_cell_refs": {
              "$ref": "#/$defs/refList"
            },
            "appeal_route_refs": {
              "$ref": "#/$defs/refList"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "actor": {
      "type": "object",
      "x-title-en": "Actor",
      "x-title-ru": "Субъект",
      "allOf": [
        {
          "$ref": "#/$defs/entityHeader"
        },
        {
          "type": "object",
          "required": [
            "actor_type"
          ],
          "properties": {
            "state": {
              "enum": [
                "active",
                "limited",
                "dormant",
                "withdrawn",
                "disputed"
              ]
            },
            "actor_type": {
              "enum": [
                "PERSON",
                "ORGANIZATION",
                "PUBLIC_BODY",
                "AGENT"
              ]
            },
            "governance_cell_refs": {
              "$ref": "#/$defs/refList"
            },
            "personal_anchor_ref": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^urn:uu-aap:uu-society:personal-anchor:"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "personalAnchor": {
      "type": "object",
      "x-title-en": "PersonalAnchor",
      "x-title-ru": "Личностный якорь",
      "allOf": [
        {
          "$ref": "#/$defs/entityHeader"
        },
        {
          "type": "object",
          "required": [
            "actor_ref",
            "evidence_refs",
            "scope",
            "freshness_at"
          ],
          "properties": {
            "state": {
              "enum": [
                "insufficient",
                "partial",
                "sufficient_for_declared_scope",
                "disputed",
                "dormant"
              ]
            },
            "actor_ref": {
              "type": "string",
              "pattern": "^urn:uu-aap:uu-society:actor:"
            },
            "evidence_refs": {
              "$ref": "#/$defs/refList"
            },
            "current_control_evidence_refs": {
              "$ref": "#/$defs/refList"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "freshness_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "intent": {
      "type": "object",
      "x-title-en": "Intent",
      "x-title-ru": "Намерение",
      "allOf": [
        {
          "$ref": "#/$defs/entityHeader"
        },
        {
          "type": "object",
          "required": [
            "actor_ref",
            "purpose",
            "scope",
            "beneficiary_refs",
            "constraints",
            "privacy_boundary"
          ],
          "properties": {
            "state": {
              "enum": [
                "declared",
                "active",
                "satisfied",
                "withdrawn",
                "expired",
                "disputed"
              ]
            },
            "actor_ref": {
              "type": "string",
              "pattern": "^urn:uu-aap:uu-society:actor:"
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "beneficiary_refs": {
              "$ref": "#/$defs/refList"
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "privacy_boundary": {
              "enum": [
                "private",
                "counterparty",
                "cell",
                "federated",
                "public"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "need": {
      "type": "object",
      "x-title-en": "Need",
      "x-title-ru": "Потребность",
      "allOf": [
        {
          "$ref": "#/$defs/entityHeader"
        },
        {
          "type": "object",
          "required": [
            "actor_ref",
            "desired_state",
            "rights_floor_relevant"
          ],
          "properties": {
            "state": {
              "enum": [
                "declared",
                "matched",
                "partially_satisfied",
                "satisfied",
                "withdrawn",
                "expired"
              ]
            },
            "actor_ref": {
              "type": "string",
              "pattern": "^urn:uu-aap:uu-society:actor:"
            },
            "desired_state": {
              "type": "string",
              "minLength": 1
            },
            "rights_floor_relevant": {
              "type": "boolean"
            },
            "deadline": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "acceptable_solution_classes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "capability": {
      "type": "object",
      "x-title-en": "Capability",
      "x-title-ru": "Способность",
      "allOf": [
        {
          "$ref": "#/$defs/entityHeader"
        },
        {
          "type": "object",
          "required": [
            "provider_ref",
            "transformation",
            "conditions",
            "evidence_refs"
          ],
          "properties": {
            "state": {
              "enum": [
                "declared",
                "available",
                "reserved",
                "unavailable",
                "withdrawn",
                "disputed"
              ]
            },
            "provider_ref": {
              "type": "string",
              "pattern": "^urn:uu-aap:uu-society:actor:"
            },
            "transformation": {
              "type": "string",
              "minLength": 1
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_refs": {
              "$ref": "#/$defs/refList"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "resource": {
      "type": "object",
      "x-title-en": "Resource",
      "x-title-ru": "Ресурс",
      "allOf": [
        {
          "$ref": "#/$defs/entityHeader"
        },
        {
          "type": "object",
          "required": [
            "steward_ref",
            "resource_type",
            "scarcity_class",
            "transfer_modes"
          ],
          "properties": {
            "state": {
              "enum": [
                "available",
                "reserved",
                "in_use",
                "depleted",
                "unavailable",
                "disputed"
              ]
            },
            "steward_ref": {
              "type": "string",
              "pattern": "^urn:uu-aap:uu-society:actor:"
            },
            "resource_type": {
              "enum": [
                "MONEY",
                "TIME",
                "KNOWLEDGE",
                "ATTENTION",
                "CARE",
                "PHYSICAL_OBJECT",
                "SPACE",
                "ENERGY",
                "COMPUTE",
                "DATA",
                "ACCESS",
                "TRANSPORT",
                "NETWORK",
                "CAPACITY",
                "OTHER"
              ]
            },
            "scarcity_class": {
              "enum": [
                "abundant",
                "constrained",
                "scarce",
                "critical"
              ]
            },
            "transfer_modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "transfer",
                  "consume",
                  "borrow",
                  "use",
                  "access",
                  "compute",
                  "share"
                ]
              }
            },
            "capacity": {
              "type": [
                "number",
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "evidenceEvent": {
      "type": "object",
      "x-title-en": "EvidenceEvent",
      "x-title-ru": "Доказательное событие",
      "allOf": [
        {
          "$ref": "#/$defs/entityHeader"
        },
        {
          "type": "object",
          "required": [
            "subject_refs",
            "event_type",
            "observed_at",
            "claim",
            "source_refs",
            "privacy_scope"
          ],
          "properties": {
            "state": {
              "enum": [
                "unverified",
                "observed",
                "attested",
                "cryptographically_bound",
                "disputed",
                "superseded"
              ]
            },
            "subject_refs": {
              "$ref": "#/$defs/refList"
            },
            "event_type": {
              "type": "string",
              "minLength": 1
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "claim": {
              "type": "string",
              "minLength": 1
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "privacy_scope": {
              "enum": [
                "private",
                "counterparty",
                "cell",
                "federated",
                "public"
              ]
            },
            "derived_from_refs": {
              "$ref": "#/$defs/refList"
            },
            "retention_until": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "trustState": {
      "type": "object",
      "x-title-en": "TrustState",
      "x-title-ru": "Состояние доверия",
      "allOf": [
        {
          "$ref": "#/$defs/entityHeader"
        },
        {
          "type": "object",
          "required": [
            "subject_ref",
            "context",
            "as_of",
            "dimensions"
          ],
          "properties": {
            "state": {
              "enum": [
                "unknown",
                "supporting",
                "mixed",
                "adverse",
                "disputed"
              ]
            },
            "subject_ref": {
              "type": "string",
              "pattern": "^urn:uu-aap:uu-society:actor:"
            },
            "context": {
              "type": "string",
              "minLength": 1
            },
            "as_of": {
              "type": "string",
              "format": "date-time"
            },
            "dimensions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dimension",
                  "evidence_posture",
                  "evidence_refs",
                  "scope"
                ],
                "properties": {
                  "dimension": {
                    "enum": [
                      "continuity",
                      "reliability",
                      "competence",
                      "care",
                      "stewardship",
                      "repair",
                      "other"
                    ]
                  },
                  "evidence_posture": {
                    "enum": [
                      "unknown",
                      "supporting",
                      "mixed",
                      "adverse"
                    ]
                  },
                  "evidence_refs": {
                    "$ref": "#/$defs/refList"
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "overall_numeric_score": {
              "const": null
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "riskHarmEnvelope": {
      "type": "object",
      "x-title-en": "RiskHarmEnvelope",
      "x-title-ru": "Конверт риска и вреда",
      "allOf": [
        {
          "$ref": "#/$defs/entityHeader"
        },
        {
          "type": "object",
          "required": [
            "interaction_refs",
            "harm_classes",
            "mitigations",
            "irreversible_effects_allowed"
          ],
          "properties": {
            "state": {
              "enum": [
                "draft",
                "assessed",
                "mitigated",
                "accepted",
                "rejected",
                "expired",
                "disputed"
              ]
            },
            "interaction_refs": {
              "$ref": "#/$defs/refList"
            },
            "harm_classes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "mitigations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "irreversible_effects_allowed": {
              "type": "boolean"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "match": {
      "type": "object",
      "x-title-en": "Match",
      "x-title-ru": "Сопоставление",
      "allOf": [
        {
          "$ref": "#/$defs/entityHeader"
        },
        {
          "type": "object",
          "required": [
            "need_ref",
            "capability_refs",
            "resource_refs",
            "participant_refs"
          ],
          "properties": {
            "state": {
              "enum": [
                "proposed",
                "accepted",
                "rejected",
                "expired",
                "executed",
                "cancelled"
              ]
            },
            "need_ref": {
              "type": "string",
              "pattern": "^urn:uu-aap:uu-society:need:"
            },
            "capability_refs": {
              "$ref": "#/$defs/refList"
            },
            "resource_refs": {
              "$ref": "#/$defs/refList"
            },
            "participant_refs": {
              "$ref": "#/$defs/refList"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "commitment": {
      "type": "object",
      "x-title-en": "Commitment",
      "x-title-ru": "Обязательство",
      "allOf": [
        {
          "$ref": "#/$defs/entityHeader"
        },
        {
          "type": "object",
          "required": [
            "participant_refs",
            "terms",
            "obligations",
            "exit_conditions",
            "dispute_route_refs"
          ],
          "properties": {
            "state": {
              "enum": [
                "proposed",
                "accepted",
                "active",
                "fulfilled",
                "breached",
                "withdrawn",
                "expired",
                "disputed"
              ]
            },
            "participant_refs": {
              "$ref": "#/$defs/refList"
            },
            "terms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "obligations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exit_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dispute_route_refs": {
              "$ref": "#/$defs/refList"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "araeState": {
      "type": "object",
      "x-title-en": "ARAEState",
      "x-title-ru": "Состояние ARAE",
      "allOf": [
        {
          "$ref": "#/$defs/entityHeader"
        },
        {
          "type": "object",
          "required": [
            "actor_ref",
            "intent_ref",
            "scope",
            "allowed_transition_types",
            "forbidden_transition_types",
            "evidence_refs",
            "valid_from",
            "valid_until"
          ],
          "properties": {
            "state": {
              "enum": [
                "draft",
                "active",
                "narrowed",
                "suspended",
                "expired",
                "superseded",
                "disputed"
              ]
            },
            "actor_ref": {
              "type": "string",
              "pattern": "^urn:uu-aap:uu-society:actor:"
            },
            "intent_ref": {
              "type": "string",
              "pattern": "^urn:uu-aap:uu-society:intent:"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "allowed_transition_types": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "forbidden_transition_types": {
              "type": "array",
