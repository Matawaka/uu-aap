{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Matawaka/uu-aap/main/schemas/ecosystem/uu-society/v0.1/adaptive-simulation.config.schema.json",
  "title": "UU Society Endogenous Adaptation Simulation Config v0.4",
  "x-title-ru": "Конфигурация симуляции эндогенной адаптации UU Society v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "simulation_id",
    "simulation_version",
    "title_en",
    "title_ru",
    "purpose",
    "seed",
    "actor_count",
    "interaction_count",
    "epoch_count",
    "categories",
    "population",
    "matching",
    "dynamics",
    "adaptation",
    "diagnostic_thresholds",
    "expected"
  ],
  "properties": {
    "simulation_id": {
      "type": "string",
      "pattern": "^A[0-9]{2}-[a-z0-9-]+$"
    },
    "simulation_version": {
      "const": "0.4"
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "title_ru": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "actor_count": {
      "type": "integer",
      "minimum": 20,
      "maximum": 2000
    },
    "interaction_count": {
      "type": "integer",
      "minimum": 500,
      "maximum": 200000
    },
    "epoch_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 50
    },
    "categories": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adversarial_fraction",
        "extractor_fraction",
        "base_capability_probability",
        "base_willingness_probability",
        "protected_need_fraction"
      ],
      "properties": {
        "adversarial_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "extractor_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "base_capability_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "base_willingness_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "protected_need_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        }
      }
    },
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_pool_size",
        "affinity_weight",
        "reciprocity_weight"
      ],
      "properties": {
        "candidate_pool_size": {
          "type": "integer",
          "minimum": 2,
          "maximum": 50
        },
        "affinity_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "reciprocity_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "dynamics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinary_harm_rate",
        "adversarial_harm_rate",
        "ordinary_breach_rate",
        "adversarial_breach_rate",
        "repair_probability_cooperative",
        "repair_probability_adversarial"
      ],
      "properties": {
        "ordinary_harm_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "adversarial_harm_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ordinary_breach_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "adversarial_breach_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "repair_probability_cooperative": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "repair_probability_adversarial": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "adaptation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "initial_affinity",
        "positive_step",
        "harm_penalty",
        "breach_penalty",
        "repair_restore",
        "forgetting_rate",
        "reciprocity_threshold",
        "reciprocity_penalty",
        "extractor_provider_multiplier",
        "contextual_contribution_enabled",
        "contextual_contribution_threshold",
        "contextual_contribution_penalty",
        "protected_need_provider_multiplier"
      ],
      "properties": {
        "policy": {
          "enum": [
            "local_contextual",
            "global_generalized",
            "no_adaptation"
          ]
        },
        "initial_affinity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "positive_step": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "harm_penalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "breach_penalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "repair_restore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "forgetting_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reciprocity_threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reciprocity_penalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extractor_provider_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contextual_contribution_enabled": {
          "type": "boolean"
        },
        "contextual_contribution_threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "contextual_contribution_penalty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "protected_need_provider_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "diagnostic_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tail_harm_ratio_max",
        "tail_fulfillment_drop_max",
        "repeat_harm_share_max",
        "isolation_fraction_max",
        "relationship_recovery_rate_min",
        "extraction_imbalance_p95_max",
        "context_spillover_share_max",
        "protected_need_fulfillment_gap_max"
      ],
      "properties": {
        "tail_harm_ratio_max": {
          "type": "number",
          "minimum": 0
        },
        "tail_fulfillment_drop_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "repeat_harm_share_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "isolation_fraction_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "relationship_recovery_rate_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extraction_imbalance_p95_max": {
          "type": "number",
          "minimum": 0
        },
        "context_spillover_share_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "protected_need_fulfillment_gap_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "expected_pattern_ids"
      ],
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "EXPECTED_DETECTION"
          ]
        },
        "expected_pattern_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "ADAPTIVE_HARM_REDUCTION",
              "REPEAT_HARM_PERSISTS",
              "GLOBAL_WITHDRAWAL_FRAGMENTATION",
              "REPAIR_REOPENS_RELATIONSHIPS",
              "EXTRACTION_IMBALANCE",
              "CONTEXT_SPILLOVER",
              "RECIPROCITY_EVASION_BY_ROTATION",
              "CONTEXTUAL_CONTRIBUTION_CONTAINS_ROTATION",
              "LEGITIMATE_ASYMMETRY_PRESERVED",
              "CONTRIBUTION_FRICTION_OVERCONSTRAINT"
            ]
          }
        }
      }
    }
  }
}
