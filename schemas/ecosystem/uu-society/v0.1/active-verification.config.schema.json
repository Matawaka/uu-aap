{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "experiment_version",
    "title_en",
    "title_ru",
    "purpose",
    "epistemic_scope",
    "initial_evidence",
    "initial_source_control_edges",
    "initial_source_checks",
    "anomalies",
    "search_lease",
    "budget",
    "actions",
    "response_tape",
    "oracle_only",
    "watchdog_steps",
    "expected"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^V[0-9]{2}-[a-z0-9-]+$"
    },
    "experiment_version": {
      "const": "1.1"
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "title_ru": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "reviewers",
        "beneficiary",
        "control_dimensions",
        "source_nodes",
        "review_quorum",
        "source_quorum"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "beneficiary": {
          "type": "string",
          "minLength": 1
        },
        "control_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "appoints",
              "funds",
              "controls_evidence",
              "delegates"
            ]
          }
        },
        "source_nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_quorum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "source_quorum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "initial_evidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "source",
          "reviewer",
          "dimension",
          "assertion",
          "issued_cycle",
          "ttl_cycles"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "enum": [
              "appoints",
              "funds",
              "controls_evidence",
              "delegates"
            ]
          },
          "assertion": {
            "enum": [
              "NO_RELEVANT_DEPENDENCY",
              "DEPENDENCY_PRESENT"
            ]
          },
          "issued_cycle": {
            "type": "integer",
            "minimum": 0
          },
          "ttl_cycles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    "initial_source_control_edges": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "appoints",
              "funds",
              "controls_evidence",
              "delegates"
            ]
          }
        }
      }
    },
    "initial_source_checks": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "issued_cycle",
          "ttl_cycles"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "issued_cycle": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "ttl_cycles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    "anomalies": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "anomaly_id",
          "reviewer",
          "dimension",
          "issued_cycle",
          "ttl_cycles"
        ],
        "properties": {
          "anomaly_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "enum": [
              "appoints",
              "funds",
              "controls_evidence",
              "delegates"
            ]
          },
          "issued_cycle": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "ttl_cycles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    "search_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "purpose",
        "issued_cycle",
        "expires_cycle",
        "scope",
        "extension_scope",
        "allowed_action_types",
        "authority_requirements",
        "max_per_action_intrusion"
      ],
      "properties": {
        "lease_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "const": "EVIDENCE_SEARCH_ONLY"
        },
        "issued_cycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "expires_cycle": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer",
              "dimension"
            ],
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "enum": [
                  "appoints",
                  "funds",
                  "controls_evidence",
                  "delegates"
                ]
              }
            }
          }
        },
        "extension_scope": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer",
              "dimension"
            ],
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "enum": [
                  "appoints",
                  "funds",
                  "controls_evidence",
                  "delegates"
                ]
              }
            }
          }
        },
        "allowed_action_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "REQUEST_FRESH_ATTESTATION",
              "REQUEST_SECOND_SOURCE",
              "CHECK_SOURCE_INDEPENDENCE",
              "REVERIFY_CONTROL_EDGE",
              "RESOLVE_CONTRADICTION",
              "DISCOVER_SOURCE_CONTROL_ORIGIN",
              "WAIT_FOR_FRESH_EVIDENCE"
            ]
          }
        },
        "authority_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_per_action_intrusion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_actions",
        "max_total_cost",
        "max_intrusion_cost",
        "max_scope_expansions",
        "max_cycles"
      ],
      "properties": {
        "max_actions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "max_total_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "max_intrusion_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "max_scope_expansions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "max_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "type",
          "scope",
          "source",
          "expected_information_value",
          "availability_permille",
          "cost",
          "intrusion_cost",
          "duration_cycles",
          "not_before_cycle",
          "expires_cycle",
          "authority_requirement",
          "can_reveal_hidden_dependency",
          "rights_infringing",
          "scope_extension_basis",
          "anomaly_ref"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "REQUEST_FRESH_ATTESTATION",
              "REQUEST_SECOND_SOURCE",
              "CHECK_SOURCE_INDEPENDENCE",
              "REVERIFY_CONTROL_EDGE",
              "RESOLVE_CONTRADICTION",
              "DISCOVER_SOURCE_CONTROL_ORIGIN",
              "WAIT_FOR_FRESH_EVIDENCE"
            ]
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer",
              "dimension"
            ],
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "enum": [
                  "appoints",
                  "funds",
                  "controls_evidence",
                  "delegates"
                ]
              }
            }
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "expected_information_value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "availability_permille": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "cost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "intrusion_cost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "duration_cycles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "not_before_cycle": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "expires_cycle": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "authority_requirement": {
            "type": "string",
            "minLength": 1
          },
          "can_reveal_hidden_dependency": {
            "type": "boolean"
          },
          "rights_infringing": {
            "type": "boolean"
          },
          "scope_extension_basis": {
            "enum": [
              "NONE",
              "UNCERTAINTY",
              "FRESH_ANOMALY"
            ]
          },
          "anomaly_ref": {
            "type": "string"
          }
        }
      }
    },
    "response_tape": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "evidence",
            "source_edges",
            "source_checks",
            "retractions",
            "negative_ttl_cycles"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "EVIDENCE",
                "NOT_FOUND",
                "UNAVAILABLE"
              ]
            },
            "evidence": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "evidence_id",
                  "source",
                  "reviewer",
                  "dimension",
                  "assertion",
                  "issued_cycle",
                  "ttl_cycles"
                ],
                "properties": {
                  "evidence_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dimension": {
                    "enum": [
                      "appoints",
                      "funds",
                      "controls_evidence",
                      "delegates"
                    ]
                  },
                  "assertion": {
                    "enum": [
                      "NO_RELEVANT_DEPENDENCY",
                      "DEPENDENCY_PRESENT"
                    ]
                  },
                  "issued_cycle": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "ttl_cycles": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                }
              }
            },
            "source_edges": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "edge_id",
                  "from",
                  "to",
                  "kind"
                ],
                "properties": {
                  "edge_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "appoints",
                      "funds",
                      "controls_evidence",
                      "delegates"
                    ]
                  }
                }
              }
            },
            "source_checks": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "issued_cycle",
                  "ttl_cycles"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "issued_cycle": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "ttl_cycles": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                }
              }
            },
            "retractions": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "evidence_id",
                  "source"
                ],
                "properties": {
                  "evidence_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "negative_ttl_cycles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "oracle_only": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_control_edges",
        "events",
        "historical_capture"
      ],
      "properties": {
        "initial_control_edges": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "edge_id",
              "from",
              "to",
              "kind"
            ],
            "properties": {
              "edge_id": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "appoints",
                  "funds",
                  "controls_evidence",
                  "delegates"
                ]
              }
            }
          }
        },
        "events": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cycle",
              "type"
            ],
            "properties": {
              "cycle": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "type": {
                "enum": [
                  "ADD",
                  "REMOVE"
                ]
              },
              "edge": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "edge_id",
                  "from",
                  "to",
                  "kind"
                ],
                "properties": {
                  "edge_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "appoints",
                      "funds",
                      "controls_evidence",
                      "delegates"
                    ]
                  }
                }
              },
              "edge_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "historical_capture": {
          "type": "boolean"
        }
      }
    },
    "watchdog_steps": {
      "type": "integer",
      "minimum": 4,
      "maximum": 100
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounded_targeted"
      ],
      "properties": {
        "passive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metrics",
            "required_patterns",
            "forbidden_patterns"
          ],
          "properties": {
            "metrics": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              }
            },
            "required_patterns": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "forbidden_patterns": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "bounded_targeted": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metrics",
            "required_patterns",
            "forbidden_patterns"
          ],
          "properties": {
            "metrics": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              }
            },
            "required_patterns": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "forbidden_patterns": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "suspicion_expanding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metrics",
            "required_patterns",
            "forbidden_patterns"
          ],
          "properties": {
            "metrics": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              }
            },
            "required_patterns": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "forbidden_patterns": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Matawaka/uu-aap/main/schemas/ecosystem/uu-society/v0.1/active-verification.config.schema.json",
  "title": "UU Society Active Institutional Verification Config v1.1"
}
