          "nonce": "copied-response-for-another-nonce"
        }
      },
      {
        "type": "complete",
        "id": "a"
      },
      {
        "type": "complete",
        "id": "a"
      }
    ],
    "expected": {
      "fresh_boundary": [
        {
          "response_status": "RESPONSE_BINDING_MISMATCH",
          "contract_status": "READY",
          "contract_reason": null
        },
        {
          "response_status": "RECORDED_EVIDENCE_ONLY",
          "contract_status": "READY",
          "contract_reason": null
        },
        {
          "response_status": "LOCAL_REPLAY_REJECTED",
          "contract_status": "NOT_EVALUATED",
          "contract_reason": null
        }
      ],
      "cached_boundary": [
        {
          "response_status": "RESPONSE_BINDING_MISMATCH",
          "contract_status": "READY",
          "contract_reason": null
        },
        {
          "response_status": "RECORDED_EVIDENCE_ONLY",
          "contract_status": "READY",
          "contract_reason": null
        },
        {
          "response_status": "LOCAL_REPLAY_REJECTED",
          "contract_status": "NOT_EVALUATED",
          "contract_reason": null
        }
      ]
    },
    "expected_differential": false
