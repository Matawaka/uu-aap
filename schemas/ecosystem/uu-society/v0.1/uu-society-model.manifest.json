  "invariants": [
    {
      "id": "I-001",
      "key": "HUMAN_RIGHTS_NOT_EARNED_TRUST",
      "text_en": "Rights-floor access MUST NOT depend on TrustState or Contribution.",
      "text_ru": "Доступ к базовому уровню прав НЕ ДОЛЖЕН зависеть от TrustState или Contribution."
    },
    {
      "id": "I-002",
      "key": "DISSENT_NOT_MALICE",
      "text_en": "Dissent MUST NOT by itself be evidence of malicious intent.",
      "text_ru": "Несогласие само по себе НЕ ДОЛЖНО считаться доказательством злого намерения."
    },
    {
      "id": "I-003",
      "key": "ASYMMETRY_NOT_PARASITISM",
      "text_en": "Receiving more than one contributes MUST NOT alone establish exploitation.",
      "text_ru": "Получение большего, чем человек отдаёт, само по себе НЕ ДОКАЗЫВАЕТ паразитизм."
    },
    {
      "id": "I-004",
      "key": "EVIDENCE_NOT_VERDICT",
      "text_en": "Evidence changes uncertainty; it is not an automatic verdict.",
      "text_ru": "Evidence изменяет неопределённость, но не является автоматическим приговором."
    },
    {
      "id": "I-005",
      "key": "TRUST_NOT_UNIVERSAL_SCORE",
      "text_en": "Trust MUST remain contextual and MUST NOT collapse into a universal numeric social score.",
      "text_ru": "Доверие ДОЛЖНО оставаться контекстным и НЕ ДОЛЖНО сводиться к универсальному числовому социальному рейтингу."
    },
    {
      "id": "I-006",
      "key": "OPEN_INTERACTION_NOT_UNRESTRICTED_CONSEQUENCES",
      "text_en": "Open interaction does not imply unrestricted consequences.",
      "text_ru": "Открытое взаимодействие не означает неограниченные последствия."
    },
    {
      "id": "I-007",
      "key": "REVERSIBILITY_FIRST",
      "text_en": "Where comparable, reversible action SHOULD be preferred over irreversible action.",
      "text_ru": "При сопоставимых условиях СЛЕДУЕТ предпочитать обратимое действие необратимому."
    },
    {
      "id": "I-008",
      "key": "FAILURE_MEMORY_NOT_PERMANENT_STIGMA",
      "text_en": "System failure memory MUST NOT imply permanent stigma for a person.",
      "text_ru": "Память системы об ошибке НЕ ДОЛЖНА означать пожизненную стигму человека."
    },
    {
      "id": "I-009",
      "key": "MINIMUM_NECESSARY_KNOWLEDGE",
      "text_en": "Interactions SHOULD disclose only evidence necessary for the current purpose and scope.",
      "text_ru": "Взаимодействие ДОЛЖНО по возможности раскрывать только evidence, необходимое для текущей цели и scope."
    },
    {
      "id": "I-010",
      "key": "NO_SINGLE_INTERPRETER",
      "text_en": "No single actor SHOULD control identity, trust, value, normality and authority interpretation at once.",
      "text_ru": "Ни один субъект НЕ ДОЛЖЕН единолично контролировать интерпретацию идентичности, доверия, ценности, нормы и полномочий одновременно."
    },
    {
      "id": "I-011",
      "key": "CAPABILITY_NOT_OBLIGATION",
      "text_en": "Capability does not create an obligation to provide it.",
      "text_ru": "Наличие способности не создаёт обязанности её предоставлять."
    },
    {
      "id": "I-012",
      "key": "KNOWN_HISTORY_NOT_IDENTITY",
      "text_en": "Knowledge of historical personal data does not establish current agency.",
      "text_ru": "Знание исторических персональных данных не доказывает текущую агентность человека."
    },
    {
      "id": "I-013",
      "key": "FAILED_CHALLENGE_NOT_IMPOSTOR",
      "text_en": "A failed continuity challenge does not by itself establish impersonation or guilt.",
      "text_ru": "Неудачный continuity challenge сам по себе не доказывает подмену личности или виновность."
    },
    {
      "id": "I-014",
      "key": "PAST_AUTHORIZATION_NOT_CURRENT_AUTHORIZATION",
      "text_en": "Past authorization does not establish current authorization.",
      "text_ru": "Прошлое полномочие не доказывает наличие текущего полномочия."
    },
    {
      "id": "I-015",
      "key": "VIOLATION_NOT_HARM",
      "text_en": "Rule violation and harm are distinct dimensions.",
      "text_ru": "Нарушение правила и причинение вреда являются различными измерениями."
    }
  ],
  "interaction_rules": [
    {
      "id": "R-001",
      "when": [
        "Need.state=declared",
        "Match.state=proposed"
      ],
      "requires": [
        "participant consent before Commitment.state=accepted"
      ],
      "text_en": "A proposed match MUST NOT become an accepted commitment without participant consent.",
      "text_ru": "Предложенное сопоставление НЕ ДОЛЖНО становиться принятым обязательством без согласия участников."
    },
    {
      "id": "R-002",
      "when": [
        "Action.state transitions to admitted or in_progress"
      ],
      "requires": [
        "ActionLease.state=active",
        "current authority evidence",
        "current scope fit"
      ],
      "text_en": "Normal actions require a current active lease and scope-consistent authority evidence.",
      "text_ru": "Обычное действие требует текущего активного lease и evidence полномочия, соответствующего scope."
    },
    {
      "id": "R-003",
      "when": [
        "new adverse evidence appears"
      ],
      "requires": [
        "re-evaluate TrustState",
        "re-evaluate ARAE",
        "preserve constitutional_floor"
      ],
      "text_en": "Adverse evidence MAY narrow consequences but MUST NOT remove the constitutional rights floor.",
      "text_ru": "Неблагоприятное evidence МОЖЕТ сузить последствия, но НЕ ДОЛЖНО отменять конституционный уровень базовых прав."
    },
    {
      "id": "R-004",
      "when": [
        "harm is observed"
      ],
      "requires": [
        "contain harm",
        "protect affected actors",
        "record evidence",
        "offer dispute/repair path"
      ],
      "text_en": "Containment, evidence, repair and reintegration are distinct stages.",
      "text_ru": "Локализация вреда, evidence, восстановление и реинтеграция являются отдельными стадиями."
    },
    {
      "id": "R-005",
      "when": [
        "FailurePattern is created"
      ],
      "requires": [
        "person_stigma_allowed=false",
        "system-learning fields present"
      ],
      "text_en": "Failure knowledge belongs to system learning and MUST NOT automatically become permanent personal stigma.",
      "text_ru": "Знание о сбое относится к обучению системы и НЕ ДОЛЖНО автоматически превращаться в постоянную стигму человека."
    },
    {
      "id": "R-006",
      "when": [
        "Harm is observed or verified"
      ],
      "requires": [
        "evaluate harm independently from rule violation",
        "preserve evidence",
        "offer repair path when applicable"
      ],
      "text_en": "Observed harm MUST NOT by itself establish a rule violation; harm containment and repair are separate from rule adjudication.",
      "text_ru": "Наблюдаемый вред сам по себе НЕ ДОЛЖЕН устанавливать нарушение правила; локализация и восстановление вреда отделены от рассмотрения нарушения."
    },
    {
      "id": "R-007",
      "when": [
        "RuleViolation is observed or verified"
      ],
      "requires": [
        "evaluate actual harm independently"
      ],
      "text_en": "A rule violation MUST NOT by itself establish that harm occurred.",
      "text_ru": "Нарушение правила само по себе НЕ ДОЛЖНО устанавливать факт причинения вреда."
    }
  ],
