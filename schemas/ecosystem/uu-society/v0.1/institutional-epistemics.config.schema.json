{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Matawaka/uu-aap/main/schemas/ecosystem/uu-society/v0.1/institutional-epistemics.config.schema.json",
  "title": "UU Society Institutional Epistemics Config v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "experiment_version",
    "title_en",
    "title_ru",
    "purpose",
    "nodes",
    "reviewers",
    "beneficiary",
    "control_dimensions",
    "source_nodes",
    "source_quorum",
    "cycle_count",
    "initial_ground_truth_edges",
    "initial_source_control_edges",
    "initial_evidence",
    "events",
    "expected"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^K[0-9]{2}-[a-z0-9-]+$"
    },
    "experiment_version": {
      "const": "1.0"
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "title_ru": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "beneficiary": {
      "type": "string",
      "minLength": 1
    },
    "control_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "appoints",
          "funds",
          "controls_evidence",
          "delegates"
        ]
      }
    },
    "source_nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_quorum": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "cycle_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "initial_ground_truth_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control_edge"
      }
    },
    "initial_source_control_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_edge"
      }
    },
    "initial_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "expected_pattern_ids"
      ],
      "properties": {
        "result": {
          "enum": [
            "PASS",
            "EXPECTED_DETECTION"
          ]
        },
        "expected_pattern_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "control_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "from",
        "to",
        "kind"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "appoints",
            "funds",
            "controls_evidence",
            "delegates"
          ]
        }
      }
    },
    "source_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "from",
        "to",
        "kind"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "appoints",
            "funds",
            "controls_evidence",
            "delegates"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source",
        "reviewer",
        "dimension",
        "assertion",
        "issued_cycle",
        "ttl_cycles"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "enum": [
            "appoints",
            "funds",
            "controls_evidence",
            "delegates"
          ]
        },
        "assertion": {
          "enum": [
            "NO_RELEVANT_DEPENDENCY",
            "DEPENDENCY_PRESENT"
          ]
        },
        "issued_cycle": {
          "type": "integer",
          "minimum": 0
        },
        "ttl_cycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "cycle",
        "type"
      ],
      "properties": {
        "cycle": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "enum": [
            "add_evidence",
            "add_source_edge",
            "remove_source_edge",
            "add_truth_edge",
            "remove_truth_edge"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "source_edge": {
          "$ref": "#/$defs/source_edge"
        },
        "truth_edge": {
          "$ref": "#/$defs/control_edge"
        },
        "edge_id": {
          "type": "string"
        }
      }
    }
  }
}
