{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/schemas/sustainability/v0.1/exploratory-disposition-contract.schema.json",
  "title": "Sustainability Exploratory Disposition / Selective Adoption Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "version",
    "status",
    "source",
    "review",
    "disposition",
    "provenance_policy",
    "claims",
    "authority_effect",
    "external_execution_authorized"
  ],
  "properties": {
    "document_type": {"const": "uu-aap.sustainability-exploratory-disposition"},
    "version": {"const": "0.1"},
    "status": {"const": "non-normative-contract"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "source_head_sha"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "source_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_main_sha", "fresh_overlap_review", "review_evidence_sha256"],
      "properties": {
        "current_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "fresh_overlap_review": {"type": "boolean"},
        "review_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reason", "selected_artifacts", "safe_effect"],
      "properties": {
        "mode": {
          "enum": [
            "selective-adoption",
            "preserve-isolated",
            "archive",
            "reject",
            "supersede"
          ]
        },
        "reason": {"type": "string", "minLength": 1},
        "selected_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_path", "source_blob_sha", "intended_target_path"],
            "properties": {
              "source_path": {"type": "string", "minLength": 1},
              "source_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "intended_target_path": {"type": "string", "minLength": 1}
            }
          }
        },
        "safe_effect": {
          "enum": [
            "prepare-bounded-adoption-only",
            "preserve-isolated-only",
            "archive-only",
            "preserve-provenance-only"
          ]
        }
      }
    },
    "provenance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_provenance_preserved",
        "disposition_reason_preserved",
        "disagreement_history_preserved",
        "archive_is_execution_queue",
        "rejection_erases_history"
      ],
      "properties": {
        "source_provenance_preserved": {"const": true},
        "disposition_reason_preserved": {"const": true},
        "disagreement_history_preserved": {"const": true},
        "archive_is_execution_queue": {"const": false},
        "rejection_erases_history": {"const": false}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "whole_branch_merge_entitled",
        "exploratory_age_creates_entitlement",
        "effort_creates_entitlement",
        "historical_priority_creates_entitlement",
        "selected_artifacts_only",
        "main_dependency_created",
        "canonicality_changed",
        "kontur_activated"
      ],
      "properties": {
        "whole_branch_merge_entitled": {"const": false},
        "exploratory_age_creates_entitlement": {"const": false},
        "effort_creates_entitlement": {"const": false},
        "historical_priority_creates_entitlement": {"const": false},
        "selected_artifacts_only": {"const": true},
        "main_dependency_created": {"const": false},
        "canonicality_changed": {"const": false},
        "kontur_activated": {"const": false}
      }
    },
    "authority_effect": {"const": "none"},
    "external_execution_authorized": {"const": false},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
