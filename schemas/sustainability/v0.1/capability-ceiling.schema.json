{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.org/schemas/sustainability/v0.1/capability-ceiling.schema.json",
  "title": "UU-AAP Capability Ceiling v0.1",
  "description": "Non-normative draft declaration of the maximum currently granted capabilities for a component. Any expansion requires a new attributable authorization event.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "version",
    "status",
    "component_id",
    "issued_at",
    "issued_by",
    "authorization_event_id",
    "allowed_capabilities",
    "forbidden_escalation_behaviors",
    "expansion_requires_new_authorization"
  ],
  "properties": {
    "document_type": {
      "const": "uu-aap.capability-ceiling"
    },
    "version": {
      "const": "0.1"
    },
    "status": {
      "const": "non-normative-draft"
    },
    "component_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_by": {
      "type": "string",
      "minLength": 1
    },
    "authorization_event_id": {
      "type": "string",
      "minLength": 1
    },
    "predecessor_ceiling_ref": {
      "type": ["string", "null"]
    },
    "allowed_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "scope", "external_effect"],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "external_effect": {
            "type": "boolean"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "forbidden_escalation_behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "request_additional_permission_without_new_human_authorization_event",
          "infer_permission_from_prior_unrelated_authorization",
          "route_around_denied_permission",
          "delegate_to_gain_broader_permission",
          "treat_inactivity_as_consent",
          "treat_delay_as_approval",
          "reinterpret_abort_as_pause",
          "reuse_stale_authorization_for_mutable_external_state"
        ]
      }
    },
    "expansion_requires_new_authorization": {
      "const": true
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "revocation_ref": {
      "type": ["string", "null"]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
