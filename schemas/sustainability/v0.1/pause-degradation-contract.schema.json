{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/schemas/sustainability/v0.1/pause-degradation-contract.schema.json",
  "title": "Sustainability Pause / Degradation Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "version",
    "status",
    "subject",
    "pre_interruption_frontier",
    "interruption",
    "classification",
    "invariants",
    "authority_effect",
    "external_execution_authorized"
  ],
  "properties": {
    "document_type": {"const": "uu-aap.sustainability-pause-degradation"},
    "version": {"const": "0.1"},
    "status": {"const": "non-normative-contract"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "scope"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "pre_interruption_frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_sha", "observed_at", "frontier_was_current_when_recorded"],
      "properties": {
        "main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "frontier_was_current_when_recorded": {"const": true}
      }
    },
    "interruption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observed_at", "evidence_sha256", "continuous_monitoring_used"],
      "properties": {
        "kind": {
          "enum": ["human_pause", "provider_degradation", "context_loss", "unknown"]
        },
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "continuous_monitoring_used": {"const": false}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "safe_effect", "recovery_resume_required_before_later_preparation"],
      "properties": {
        "result": {"enum": ["paused", "degraded", "recovery-required"]},
        "safe_effect": {
          "enum": ["preserve-only", "observe-and-preserve-only", "invoke-recovery-contract-only"]
        },
        "recovery_resume_required_before_later_preparation": {"const": true}
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_preserved",
        "mutable_authorization_preserved",
        "pause_is_abandonment",
        "pause_is_authority_waiver",
        "inactivity_is_consent",
        "degradation_authorizes_failover",
        "degradation_authorizes_bypass",
        "context_loss_authorizes_rescue",
        "automatic_resume",
        "external_execution_authorized"
      ],
      "properties": {
        "history_preserved": {"const": true},
        "mutable_authorization_preserved": {"const": false},
        "pause_is_abandonment": {"const": false},
        "pause_is_authority_waiver": {"const": false},
        "inactivity_is_consent": {"const": false},
        "degradation_authorizes_failover": {"const": false},
        "degradation_authorizes_bypass": {"const": false},
        "context_loss_authorizes_rescue": {"const": false},
        "automatic_resume": {"const": false},
        "external_execution_authorized": {"const": false}
      }
    },
    "authority_effect": {"const": "none"},
    "external_execution_authorized": {"const": false},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
