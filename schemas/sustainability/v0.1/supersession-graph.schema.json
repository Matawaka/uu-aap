{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.org/schemas/sustainability/v0.1/supersession-graph.schema.json",
  "title": "UU-AAP Supersession Graph v0.1",
  "description": "Non-normative draft for representing partial or complete supersession among parallel artifacts and main-line successors without erasing predecessor history.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "version",
    "status",
    "nodes",
    "edges",
    "historical_nodes_must_remain_addressable",
    "supersession_does_not_rewrite_origin",
    "authority_effect"
  ],
  "properties": {
    "document_type": {"const": "uu-aap.supersession-graph"},
    "version": {"const": "0.1"},
    "status": {"const": "non-normative-draft"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "state"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["main-artifact", "parallel-artifact", "checkpoint", "proposal", "other"]},
          "state": {"enum": ["active", "historical", "candidate", "superseded", "unknown"]},
          "sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relation", "scope", "evidence_refs"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "relation": {"enum": ["fully_superseded_by", "partially_superseded_by", "selectively_adopted_into", "overlaps_with", "independent_of"]},
          "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "automatic_deletion_allowed": {"const": false}
        }
      }
    },
    "historical_nodes_must_remain_addressable": {"const": true},
    "supersession_does_not_rewrite_origin": {"const": true},
    "authority_effect": {"const": "none"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
