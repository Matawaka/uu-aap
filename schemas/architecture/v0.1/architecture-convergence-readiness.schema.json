{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/schemas/architecture/v0.1/architecture-convergence-readiness.schema.json",
  "title": "Architecture Convergence Readiness Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "canonical_predecessor_sha", "planes", "assessment", "claims"],
  "properties": {
    "schema_version": {"const": "architecture-convergence-readiness-v0.1"},
    "project_id": {"const": "Matawaka/uu-aap"},
    "canonical_predecessor_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "planes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plane_id", "required_paths", "present"],
        "properties": {
          "plane_id": {"enum": ["coordination", "authority-governance", "survival-rescue", "human-succession", "sustainability", "kontur"]},
          "required_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "present": {"const": true}
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "safe_effect"],
      "properties": {
        "state": {"enum": ["incomplete", "cross-plane-integration-review-eligible"]},
        "safe_effect": {"enum": ["no-action", "integration-review-only"]}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_declared_planes_present",
        "cross_plane_separation_preserved",
        "external_execution_authorized",
        "kontur_activation_authorized",
        "kontur_activated",
        "current_kontur_activation_frontier_verified",
        "repository_ownership_transferred",
        "canonical_origin_mutated",
        "legal_authority_established",
        "distributed_consensus_established",
        "universal_architecture_completeness_proven",
        "future_evolution_allowed"
      ],
      "properties": {
        "all_declared_planes_present": {"const": true},
        "cross_plane_separation_preserved": {"const": true},
        "external_execution_authorized": {"const": false},
        "kontur_activation_authorized": {"const": false},
        "kontur_activated": {"const": false},
        "current_kontur_activation_frontier_verified": {"const": false},
        "repository_ownership_transferred": {"const": false},
        "canonical_origin_mutated": {"const": false},
        "legal_authority_established": {"const": false},
        "distributed_consensus_established": {"const": false},
        "universal_architecture_completeness_proven": {"const": false},
        "future_evolution_allowed": {"const": true}
      }
    }
  }
}
