{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/protocols/registry/v0.1/registry.schema.json",
  "title": "UU-AAP Protocol Registry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "registry_id",
    "scope",
    "repository",
    "resolution_policy",
    "entries",
    "non_claims"
  ],
  "properties": {
    "$schema": {"const": "./registry.schema.json"},
    "artifact_type": {"const": "ProtocolRegistry"},
    "artifact_version": {"const": "0.1"},
    "registry_id": {"const": "urn:uu-aap:protocol-registry:v0.1"},
    "scope": {"const": "repository_scoped"},
    "repository": {"const": "github:Matawaka/uu-aap"},
    "resolution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "mutable_latest_alias",
        "implicit_upgrade",
        "ambiguity",
        "missing_version",
        "tag_drift",
        "manifest_blob_mismatch"
      ],
      "properties": {
        "selection": {"const": "exact_protocol_id_and_version_only"},
        "mutable_latest_alias": {"const": false},
        "implicit_upgrade": {"const": false},
        "ambiguity": {"const": "fail_closed"},
        "missing_version": {"const": "fail_closed"},
        "tag_drift": {"const": "fail_closed"},
        "manifest_blob_mismatch": {"const": "fail_closed"}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_uri",
        "protocol_id",
        "version",
        "status",
        "semantic_source_status",
        "release_tag",
        "release_commit",
        "release_tree",
        "release_manifest_path",
        "release_manifest_git_blob_sha",
        "publication_checkpoint_path",
        "publication_checkpoint_git_blob_sha",
        "conformance_levels"
      ],
      "properties": {
        "logical_uri": {"type": "string", "pattern": "^urn:uu-aap:protocol:[a-z0-9._-]+:[0-9A-Za-z._-]+$"},
        "protocol_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"const": "published"},
        "semantic_source_status": {"type": "string", "minLength": 1},
        "release_tag": {"type": "string", "minLength": 1},
        "release_commit": {"$ref": "#/$defs/sha1"},
        "release_tree": {"$ref": "#/$defs/sha1"},
        "release_manifest_path": {"$ref": "#/$defs/safePath"},
        "release_manifest_git_blob_sha": {"$ref": "#/$defs/sha1"},
        "publication_checkpoint_path": {"$ref": "#/$defs/safePath"},
        "publication_checkpoint_git_blob_sha": {"$ref": "#/$defs/sha1"},
        "conformance_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
