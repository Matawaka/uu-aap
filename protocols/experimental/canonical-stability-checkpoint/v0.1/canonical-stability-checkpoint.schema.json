{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.example/protocols/experimental/canonical-stability-checkpoint/v0.1/canonical-stability-checkpoint.schema.json",
  "title": "Canonical Stability Checkpoint v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema","artifact_type","artifact_version","checkpoint_id","canonical_frontier","predecessor_stability","representative_layers","claims","non_effects"],
  "properties": {
    "$schema": {"const": "./canonical-stability-checkpoint.schema.json"},
    "artifact_type": {"const": "CanonicalStabilityCheckpoint"},
    "artifact_version": {"const": "0.1"},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "canonical_frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository","branch","commit_sha","tree_sha"],
      "properties": {
        "repository": {"const": "Matawaka/uu-aap"},
        "branch": {"const": "main"},
        "commit_sha": {"const": "676b8c3bfc7d10595a17f4595a88bf477cf8fc48"},
        "tree_sha": {"const": "2477f354a8fd117108e7108ba4719f9129ef7fe6"}
      }
    },
    "predecessor_stability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr_number","profile_path","validator_path","post_merge_green_observed"],
      "properties": {
        "pr_number": {"const": 406},
        "profile_path": {"const": "protocols/experimental/cross-layer-invariant-stability/v0.1/fixture.json"},
        "validator_path": {"const": "protocols/experimental/cross-layer-invariant-stability/v0.1/validate.js"},
        "post_merge_green_observed": {"const": true}
      }
    },
    "representative_layers": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tested_frontier_bound","representative_stability_preserved","universal_correctness_proven","complete_historical_coverage_proven","external_runtime_state_proven","future_successor_authorized","release_ready","publication_claim"],
      "properties": {
        "tested_frontier_bound": {"const": true},
        "representative_stability_preserved": {"const": true},
        "universal_correctness_proven": {"const": false},
        "complete_historical_coverage_proven": {"const": false},
        "external_runtime_state_proven": {"const": false},
        "future_successor_authorized": {"const": false},
        "release_ready": {"const": false},
        "publication_claim": {"const": false}
      }
    },
    "non_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_or_tag_created","kontur_mutated","authority_transferred","action_authorized","action_performed","liability_established","permissions_changed","history_rewritten","canonical_origin_mutated"],
      "properties": {
        "release_or_tag_created": {"const": false},
        "kontur_mutated": {"const": false},
        "authority_transferred": {"const": false},
        "action_authorized": {"const": false},
        "action_performed": {"const": false},
        "liability_established": {"const": false},
        "permissions_changed": {"const": false},
        "history_rewritten": {"const": false},
        "canonical_origin_mutated": {"const": false}
      }
    }
  }
}
