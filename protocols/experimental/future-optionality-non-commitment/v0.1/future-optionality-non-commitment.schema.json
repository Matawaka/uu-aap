{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.example/protocols/experimental/future-optionality-non-commitment/v0.1/future-optionality-non-commitment.schema.json",
  "title": "Future Optionality / Non-Commitment Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema","artifact_type","artifact_version","receipt_id","future_representation","provenance","horizon","evidence_refs","probability","lifecycle","claims"],
  "properties": {
    "$schema": {"const": "./future-optionality-non-commitment.schema.json"},
    "artifact_type": {"const": "FutureOptionalityNonCommitmentReceipt"},
    "artifact_version": {"const": "0.1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "future_representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation_ref","representation_kind","target_ref","created_at"],
      "properties": {
        "representation_ref": {"type": "string", "minLength": 1},
        "representation_kind": {"enum": ["forecast","future_target","plan","successor_proposal","scenario"]},
        "target_ref": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref","origin_class"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "origin_class": {"enum": ["human","system","mixed","external","unknown"]}
      }
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at","ends_at","bounded"],
      "properties": {
        "starts_at": {"type": "string", "format": "date-time"},
        "ends_at": {"type": "string", "format": "date-time"},
        "bounded": {"const": true}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "probability": {"type": ["number","null"], "minimum": 0, "maximum": 1},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state","changed_at","successor_representation_ref","predecessor_provenance_preserved"],
      "properties": {
        "state": {"enum": ["active","superseded","abandoned","realized","expired"]},
        "changed_at": {"type": "string", "format": "date-time"},
        "successor_representation_ref": {"type": ["string","null"]},
        "predecessor_provenance_preserved": {"const": true}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_established","obligation_established","authorization_established","action_permit_established","required_successor_established","inevitability_established","fault_established","responsibility_established","liability_established","sanction_authorized","external_action_performed"],
      "properties": {
        "intent_established": {"const": false},
        "obligation_established": {"const": false},
        "authorization_established": {"const": false},
        "action_permit_established": {"const": false},
        "required_successor_established": {"const": false},
        "inevitability_established": {"const": false},
        "fault_established": {"const": false},
        "responsibility_established": {"const": false},
        "liability_established": {"const": false},
        "sanction_authorized": {"const": false},
        "external_action_performed": {"const": false}
      }
    }
  }
}
