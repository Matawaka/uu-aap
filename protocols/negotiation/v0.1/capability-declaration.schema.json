{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/protocols/negotiation/v0.1/capability-declaration.schema.json",
  "title": "Protocol Capability Declaration v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "declaration_id",
    "subject_id",
    "assertion_mode",
    "registry_id",
    "capabilities",
    "non_claims"
  ],
  "properties": {
    "$schema": {"const": "./capability-declaration.schema.json"},
    "artifact_type": {"const": "ProtocolCapabilityDeclaration"},
    "artifact_version": {"const": "0.1"},
    "declaration_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "assertion_mode": {"const": "self_declared"},
    "registry_id": {"const": "urn:uu-aap:protocol-registry:v0.1"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}(?:[-+][0-9A-Za-z.-]+)?$"},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "version",
        "logical_uri",
        "release_commit",
        "conformance_levels"
      ],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/version"},
        "logical_uri": {"type": "string", "pattern": "^urn:uu-aap:protocol:"},
        "release_commit": {"$ref": "#/$defs/sha1"},
        "conformance_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
