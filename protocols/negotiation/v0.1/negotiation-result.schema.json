{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/protocols/negotiation/v0.1/negotiation-result.schema.json",
  "title": "Protocol Capability Negotiation Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "declaration_id",
    "requirement_id",
    "status",
    "matches",
    "failures",
    "non_claims"
  ],
  "properties": {
    "$schema": {"const": "./negotiation-result.schema.json"},
    "artifact_type": {"const": "ProtocolCapabilityNegotiationResult"},
    "artifact_version": {"const": "0.1"},
    "declaration_id": {"type": "string", "minLength": 1},
    "requirement_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["declared_compatible", "incompatible"]},
    "matches": {
      "type": "array",
      "items": {"$ref": "#/$defs/match"}
    },
    "failures": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocol_id",
        "version",
        "logical_uri",
        "release_commit",
        "required_conformance_levels",
        "declared_conformance_levels",
        "missing_conformance_levels",
        "satisfied"
      ],
      "properties": {
        "kind": {"enum": ["capability", "dependency"]},
        "protocol_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "logical_uri": {"type": "string", "minLength": 1},
        "release_commit": {"$ref": "#/$defs/sha1"},
        "required_conformance_levels": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "declared_conformance_levels": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "missing_conformance_levels": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "satisfied": {"type": "boolean"}
      }
    }
  }
}
