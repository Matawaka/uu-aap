{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/protocols/negotiation/v0.1/capability-requirement.schema.json",
  "title": "Protocol Capability Requirement v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "requirement_id",
    "registry_id",
    "requirements",
    "dependency_requirements",
    "matching_policy",
    "non_claims"
  ],
  "properties": {
    "$schema": {"const": "./capability-requirement.schema.json"},
    "artifact_type": {"const": "ProtocolCapabilityRequirement"},
    "artifact_version": {"const": "0.1"},
    "requirement_id": {"type": "string", "minLength": 1},
    "registry_id": {"const": "urn:uu-aap:protocol-registry:v0.1"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "dependency_requirements": {
      "type": "array",
      "items": {"$ref": "#/$defs/requirement"}
    },
    "matching_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_selection",
        "implicit_upgrade",
        "infer_conformance_hierarchy",
        "missing_requirement"
      ],
      "properties": {
        "version_selection": {"const": "exact_only"},
        "implicit_upgrade": {"const": false},
        "infer_conformance_hierarchy": {"const": false},
        "missing_requirement": {"const": "incompatible"}
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}(?:[-+][0-9A-Za-z.-]+)?$"},
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "version",
        "logical_uri",
        "required_conformance_levels"
      ],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "version": {"$ref": "#/$defs/version"},
        "logical_uri": {"type": "string", "pattern": "^urn:uu-aap:protocol:"},
        "required_conformance_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
