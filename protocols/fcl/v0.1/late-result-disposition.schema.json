{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.org/protocols/fcl/v0.1/late-result-disposition.schema.json",
  "title": "FCL v0.1 LateResultDisposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "disposition_type", "source_run_id", "source_run_epoch", "current_run_epoch", "source_terminal_state", "stale_epoch", "status", "active_reply_admitted", "external_effect_admitted", "authority_reacquisition_admitted", "retained_as_diagnostic", "result_ref", "arrived_at"],
  "properties": {
    "protocol": {"const": "FCL"},
    "version": {"const": "0.1"},
    "disposition_type": {"const": "LateResultDisposition"},
    "source_run_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "source_run_epoch": {"type": "integer", "minimum": 0},
    "current_run_epoch": {"type": "integer", "minimum": 0},
    "source_terminal_state": {"const": "TIMED_OUT_CLOSED"},
    "stale_epoch": {"type": "boolean"},
    "status": {"const": "REJECTED_CLOSED_RUN"},
    "active_reply_admitted": {"const": false},
    "external_effect_admitted": {"const": false},
    "authority_reacquisition_admitted": {"const": false},
    "retained_as_diagnostic": {"const": true},
    "result_ref": {"type": "string", "minLength": 1},
    "arrived_at": {"type": "string", "format": "date-time"}
  }
}
