{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.org/protocols/fcl/v0.1/continuation-capsule.schema.json",
  "title": "FCL v0.1 ContinuationCapsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "capsule_type", "predecessor", "successor", "intent_ref", "last_checkpoint_ref", "completed_refs", "unresolved_work", "constraints", "non_effects", "created_at"],
  "properties": {
    "protocol": {"const": "FCL"},
    "version": {"const": "0.1"},
    "capsule_type": {"const": "ContinuationCapsule"},
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "run_epoch", "terminal_state", "terminal_receipt_fingerprint"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
        "run_epoch": {"type": "integer", "minimum": 0},
        "terminal_state": {"const": "TIMED_OUT_CLOSED"},
        "terminal_receipt_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "run_epoch"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
        "run_epoch": {"type": "integer", "minimum": 0}
      }
    },
    "intent_ref": {"type": "string", "minLength": 1},
    "last_checkpoint_ref": {"type": ["string", "null"]},
    "completed_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unresolved_work": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "non_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
