{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.org/protocols/fcl/v0.1/core-authority-binding/core-authority-binding-input.schema.json",
  "title": "FCL to Core AuthorityReceipt Binding Input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol","version","profile","binding_id","origin","fcl_authority_evaluation","core_intent_receipt","issued_at"],
  "properties": {
    "protocol": {"const": "FCL"},
    "version": {"const": "0.1"},
    "profile": {"const": "core-authority-binding-v0.1"},
    "binding_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository","revision","tree"],
      "properties": {
        "repository": {"const": "Matawaka/uu-aap"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "fcl_authority_evaluation": {"type": "object"},
    "core_intent_receipt": {"type": "object"},
    "issued_at": {"type": "string", "format": "date-time"}
  }
}
