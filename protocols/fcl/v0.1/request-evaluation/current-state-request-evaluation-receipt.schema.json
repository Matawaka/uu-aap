{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.org/protocols/fcl/v0.1/request-evaluation/current-state-request-evaluation-receipt.schema.json",
  "title": "FCL Current-State Request Evaluation Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol","version","receipt_type","evaluation_id","request_id","request_receipt_fingerprint","original_source_view_fingerprint","current_view_fingerprint","exact_source_view_match","requested_control","request_run_id","request_run_epoch","request_chain_id","intent_ref","current_run_id","current_run_epoch","current_chain_id","current_intent_ref","current_display_state","current_offered_control","current_continuity_mode","current_evidence_at_or_after_request","execution_context_match","display_state_match","control_match","semantic_anchor_match","classification","current_state_revalidated","forwardable_to_authority_gate","authority_evaluation_required","absence_of_intervening_progress_proven","request_effect_authorized","interrupt_completed","continuation_receipt_created","successor_run_created","runtime_state_transitioned","progress_created","liveness_proven","action_permit_established","execution_admitted","authority_established","hidden_reasoning_included","next_safe_action","request_requested_at","current_view_rendered_at","evaluated_at","fingerprint_sha256"],
  "properties": {
    "protocol":{"const":"FCL"},"version":{"const":"0.1"},"receipt_type":{"const":"CurrentStateRequestEvaluationReceipt"},
    "evaluation_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,95}$"},"request_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,95}$"},
    "request_receipt_fingerprint":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"original_source_view_fingerprint":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"current_view_fingerprint":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "exact_source_view_match":{"type":"boolean"},"requested_control":{"enum":["REQUEST_INTERRUPT","REQUEST_SUCCESSOR"]},
    "request_run_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,95}$"},"request_run_epoch":{"type":"integer","minimum":0},"request_chain_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,95}$"},"intent_ref":{"type":"string","minLength":1},
    "current_run_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,95}$"},"current_run_epoch":{"type":"integer","minimum":0},"current_chain_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,95}$"},"current_intent_ref":{"type":"string","minLength":1},
    "current_display_state":{"enum":["ACTIVE","WAITING","STALL_SUSPECTED","CONTINUATION_AVAILABLE","CONTINUED_ON_SUCCESSOR"]},"current_offered_control":{"enum":["NONE","REQUEST_INTERRUPT","REQUEST_SUCCESSOR"]},"current_continuity_mode":{"enum":["SAME_RUN","SUCCESSOR_OF_CLOSED_RUN"]},
    "current_evidence_at_or_after_request":{"type":"boolean"},"execution_context_match":{"type":"boolean"},"display_state_match":{"type":"boolean"},"control_match":{"type":"boolean"},"semantic_anchor_match":{"type":"boolean"},
    "classification":{"enum":["CURRENT_EQUIVALENT_STATE","STALE_EXECUTION_CONTEXT","STALE_DISPLAY_STATE","STALE_CONTROL_WITHDRAWN","INSUFFICIENT_CURRENT_EVIDENCE"]},
    "current_state_revalidated":{"type":"boolean"},"forwardable_to_authority_gate":{"type":"boolean"},"authority_evaluation_required":{"type":"boolean"},
    "absence_of_intervening_progress_proven":{"const":false},"request_effect_authorized":{"const":false},"interrupt_completed":{"const":false},"continuation_receipt_created":{"const":false},"successor_run_created":{"const":false},"runtime_state_transitioned":{"const":false},"progress_created":{"const":false},"liveness_proven":{"const":false},"action_permit_established":{"const":false},"execution_admitted":{"const":false},"authority_established":{"const":false},"hidden_reasoning_included":{"const":false},
    "next_safe_action":{"enum":["EVALUATE_AUTHORITY_FOR_REQUEST","OBTAIN_CURRENT_STATE_EVIDENCE","DO_NOT_FORWARD_STALE_REQUEST"]},"request_requested_at":{"type":"string","format":"date-time"},"current_view_rendered_at":{"type":"string","format":"date-time"},"evaluated_at":{"type":"string","format":"date-time"},"fingerprint_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
