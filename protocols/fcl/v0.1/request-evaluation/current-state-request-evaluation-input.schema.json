{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.org/protocols/fcl/v0.1/request-evaluation/current-state-request-evaluation-input.schema.json",
  "title": "FCL Current-State Request Evaluation Input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "profile", "evaluation_id", "origin", "request_receipt", "current_view", "evaluated_at"],
  "properties": {
    "protocol": {"const": "FCL"},
    "version": {"const": "0.1"},
    "profile": {"const": "current-state-request-evaluation-v0.1"},
    "evaluation_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "tree"],
      "properties": {
        "repository": {"const": "Matawaka/uu-aap"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "request_receipt": {"$ref": "../control-request/user-control-request-receipt.schema.json"},
    "current_view": {"$ref": "../runtime-ui/runtime-ui-view-model-receipt.schema.json"},
    "evaluated_at": {"type": "string", "format": "date-time"}
  }
}
