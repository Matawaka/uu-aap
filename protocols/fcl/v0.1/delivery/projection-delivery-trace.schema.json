{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.org/protocols/fcl/v0.1/delivery/projection-delivery-trace.schema.json",
  "title": "FCL Projection Delivery Trace v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "profile", "session_id", "origin", "events", "assessed_at"],
  "properties": {
    "protocol": {"const": "FCL"},
    "version": {"const": "0.1"},
    "profile": {"const": "projection-delivery-v0.1"},
    "session_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "tree"],
      "properties": {
        "repository": {"const": "Matawaka/uu-aap"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delivery_sequence", "event_kind", "connection_generation", "received_at", "transport_event_ref",
          "display_predecessor_projection_fingerprint", "transport_progress_claim", "projection"
        ],
        "properties": {
          "delivery_sequence": {"type": "integer", "minimum": 0},
          "event_kind": {"enum": ["PROJECTION_DELIVERY", "TRANSPORT_HEARTBEAT", "TRANSPORT_ACK", "RECONNECT"]},
          "connection_generation": {"type": "integer", "minimum": 0},
          "received_at": {"type": "string", "format": "date-time"},
          "transport_event_ref": {"type": "string", "minLength": 1},
          "display_predecessor_projection_fingerprint": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            ]
          },
          "transport_progress_claim": {"const": false},
          "projection": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "../progress/progress-projection-receipt.schema.json"}
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"event_kind": {"const": "PROJECTION_DELIVERY"}}},
            "then": {"properties": {"projection": {"$ref": "../progress/progress-projection-receipt.schema.json"}}}
          },
          {
            "if": {"properties": {"event_kind": {"enum": ["TRANSPORT_HEARTBEAT", "TRANSPORT_ACK", "RECONNECT"]}}},
            "then": {
              "properties": {
                "projection": {"const": null},
                "display_predecessor_projection_fingerprint": {"const": null}
              }
            }
          }
        ]
      }
    },
    "assessed_at": {"type": "string", "format": "date-time"}
  }
}
