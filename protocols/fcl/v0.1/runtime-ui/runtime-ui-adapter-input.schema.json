{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://uu-aap.org/protocols/fcl/v0.1/runtime-ui/runtime-ui-adapter-input.schema.json","title":"FCL Runtime UI Adapter Input v0.1","type":"object","additionalProperties":false,"required":["protocol","version","profile","adapter_id","origin","source_type","delivery_assessment","handoff_receipt","render_constraints","rendered_at"],"properties":{"protocol":{"const":"FCL"},"version":{"const":"0.1"},"profile":{"const":"runtime-ui-adapter-v0.1"},"adapter_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,95}$"},"origin":{"type":"object","additionalProperties":false,"required":["repository","revision","tree"],"properties":{"repository":{"const":"Matawaka/uu-aap"},"revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},"tree":{"type":"string","pattern":"^[0-9a-f]{40}$"}}},"source_type":{"enum":["DELIVERY_ASSESSMENT","SUCCESSOR_HANDOFF"]},"delivery_assessment":{"oneOf":[{"type":"null"},{"$ref":"../delivery/projection-delivery-assessment-receipt.schema.json"}]},"handoff_receipt":{"oneOf":[{"type":"null"},{"$ref":"../handoff/successor-ui-handoff-receipt.schema.json"}]},"render_constraints":{"type":"object","additionalProperties":false,"required":["spinner_progress_admitted","transport_liveness_admitted","control_effect_authority_admitted"],"properties":{"spinner_progress_admitted":{"const":false},"transport_liveness_admitted":{"const":false},"control_effect_authority_admitted":{"const":false}}},"rendered_at":{"type":"string","format":"date-time"}},"allOf":[{"if":{"properties":{"source_type":{"const":"DELIVERY_ASSESSMENT"}}},"then":{"properties":{"delivery_assessment":{"$ref":"../delivery/projection-delivery-assessment-receipt.schema.json"},"handoff_receipt":{"type":"null"}}}},{"if":{"properties":{"source_type":{"const":"SUCCESSOR_HANDOFF"}}},"then":{"properties":{"delivery_assessment":{"type":"null"},"handoff_receipt":{"$ref":"../handoff/successor-ui-handoff-receipt.schema.json"}}}}]}
