{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://uu-aap.org/protocols/fcl/v0.1/authority-evaluation/authority-evaluation-receipt.schema.json",
  "title":"FCL Authority Evaluation Receipt v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["protocol","version","receipt_type","authority_evaluation_id","request_evaluation_id","request_evaluation_fingerprint","request_id","requested_control","current_run_id","current_run_epoch","current_chain_id","intent_ref","effect_actor_subject","required_scope","required_target","poai_verification_id","poai_authority_result_binding_sha256","poai_verified_at","poai_verification_required_scope","poai_verification_target","classification","request_current","poai_authority_result_valid","poai_status_established","issuer_entitlement_chain_valid","root_accepted_by_policy","scope_match","target_match","subject_match","authority_evidence_fresh","preexisting_request_scoped_authority_observed","forwardable_to_core_authority_adapter","authority_granted_by_evaluator","authority_expanded_by_evaluator","core_authority_receipt_created","request_effect_authorized","action_permit_established","execution_admitted","interrupt_completed","continuation_receipt_created","successor_run_created","runtime_state_transitioned","progress_created","liveness_proven","legal_identity_verified","legal_authority_established","universal_authority_established","legal_effect_established","truth_certified","causal_proof_certified","legal_responsibility_determined","liability_established","private_reasoning_included","next_safe_action","evaluated_at","fingerprint_sha256"],
  "properties":{
    "protocol":{"const":"FCL"},"version":{"const":"0.1"},"receipt_type":{"const":"FCLAuthorityEvaluationReceipt"},
    "authority_evaluation_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,95}$"},
    "request_evaluation_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,95}$"},
    "request_evaluation_fingerprint":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "request_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,95}$"},
    "requested_control":{"enum":["REQUEST_INTERRUPT","REQUEST_SUCCESSOR"]},
    "current_run_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,95}$"},
    "current_run_epoch":{"type":"integer","minimum":0},
    "current_chain_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{2,95}$"},
    "intent_ref":{"type":"string","minLength":1},
    "effect_actor_subject":{"type":"object","additionalProperties":false,"required":["id","key_ref"],"properties":{"id":{"type":"string","minLength":1},"key_ref":{"type":"string","minLength":1}}},
    "required_scope":{"enum":["fcl.run.interrupt","fcl.run.successor.create"]},
    "required_target":{"type":"string","pattern":"^urn:uu-aap:fcl:run:[a-z][a-z0-9-]{2,95}:epoch:[0-9]+$"},
    "poai_verification_id":{"type":"string","pattern":"^urn:poai:authority-verification:"},
    "poai_authority_result_binding_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "poai_verified_at":{"type":"string","format":"date-time"},
    "poai_verification_required_scope":{"type":"string","minLength":1},
    "poai_verification_target":{"type":"string","minLength":1},
    "classification":{"enum":["PREEXISTING_SCOPED_AUTHORITY_ESTABLISHED","REQUEST_NOT_CURRENT","AUTHORITY_NOT_ESTABLISHED","AUTHORITY_SCOPE_MISMATCH","AUTHORITY_TARGET_MISMATCH","AUTHORITY_SUBJECT_MISMATCH","AUTHORITY_EVIDENCE_TOO_OLD","AUTHORITY_EVIDENCE_TIME_INVALID"]},
    "request_current":{"type":"boolean"},"poai_authority_result_valid":{"const":true},"poai_status_established":{"type":"boolean"},"issuer_entitlement_chain_valid":{"type":"boolean"},"root_accepted_by_policy":{"type":"boolean"},"scope_match":{"type":"boolean"},"target_match":{"type":"boolean"},"subject_match":{"type":"boolean"},"authority_evidence_fresh":{"type":"boolean"},"preexisting_request_scoped_authority_observed":{"type":"boolean"},"forwardable_to_core_authority_adapter":{"type":"boolean"},
    "authority_granted_by_evaluator":{"const":false},"authority_expanded_by_evaluator":{"const":false},"core_authority_receipt_created":{"const":false},"request_effect_authorized":{"const":false},"action_permit_established":{"const":false},"execution_admitted":{"const":false},"interrupt_completed":{"const":false},"continuation_receipt_created":{"const":false},"successor_run_created":{"const":false},"runtime_state_transitioned":{"const":false},"progress_created":{"const":false},"liveness_proven":{"const":false},"legal_identity_verified":{"const":false},"legal_authority_established":{"const":false},"universal_authority_established":{"const":false},"legal_effect_established":{"const":false},"truth_certified":{"const":false},"causal_proof_certified":{"const":false},"legal_responsibility_determined":{"const":false},"liability_established":{"const":false},"private_reasoning_included":{"const":false},
    "next_safe_action":{"enum":["BIND_CORE_AUTHORITY_RECEIPT","DO_NOT_FORWARD_STALE_REQUEST","OBTAIN_MATCHING_AUTHORITY_EVIDENCE","REVERIFY_AUTHORITY"]},
    "evaluated_at":{"type":"string","format":"date-time"},
    "fingerprint_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
