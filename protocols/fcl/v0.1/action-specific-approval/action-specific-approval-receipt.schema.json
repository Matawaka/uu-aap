{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.org/protocols/fcl/v0.1/action-specific-approval/action-specific-approval-receipt.schema.json",
  "title": "FCL Action-Specific Approval Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol","version","receipt_type","approval_id","request_id","requested_control","request_fingerprint",
    "core_action_permit_hash","core_coordination_receipt_hash","target_binding_hash","source_run_id","source_run_epoch",
    "source_chain_id","intent_ref","approval_event_id","approval_event_kind","approval_event_occurred_at","approval_binding",
    "explicit_approval_recorded","permit_preexisted_approval","permit_unconsumed_at_approval","approval_required_before_authorize",
    "request_reinterpreted_as_approval","authority_created","authority_expanded","coordination_created","action_permit_created",
    "action_permit_consumed","execution_authorized","execution_admitted","pre_action_bundle_created","lifecycle_authorize_admitted",
    "lifecycle_execute_ready","interrupt_completed","continuation_receipt_created","successor_run_created","runtime_state_transitioned",
    "approval_reusable","approval_generalized","future_action_permission_created","general_authority_created","legal_authority_established",
    "universal_authority_established","legal_effect_established","truth_certified","causality_proven","liability_established",
    "private_reasoning_included","next_safe_action","issued_at","fingerprint_sha256"
  ],
  "properties": {
    "protocol": {"const": "FCL"},
    "version": {"const": "0.1"},
    "receipt_type": {"const": "FCLActionSpecificApprovalReceipt"},
    "approval_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "request_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "requested_control": {"enum": ["REQUEST_INTERRUPT","REQUEST_SUCCESSOR"]},
    "request_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "core_action_permit_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "core_coordination_receipt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target_binding_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_run_epoch": {"type": "integer", "minimum": 0},
    "source_chain_id": {"type": "string", "minLength": 1},
    "intent_ref": {"type": "string", "minLength": 1},
    "approval_event_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "approval_event_kind": {"enum": ["POINTER_ACTIVATION","KEYBOARD_ACTIVATION","VOICE_ACTIVATION","ACCESSIBILITY_ACTIVATION"]},
    "approval_event_occurred_at": {"type": "string", "format": "date-time"},
    "approval_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["approval_id","kind","scope_bound","subject_id","operation","action_scope","authority_scope","target_binding_hash","issued_at","valid_until","one_shot","content_hash"],
      "properties": {
        "approval_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
        "kind": {"const": "action_specific"},
        "scope_bound": {"const": true},
        "subject_id": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "action_scope": {"type": "string", "minLength": 1},
        "authority_scope": {"type": "string", "minLength": 1},
        "target_binding_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "issued_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "one_shot": {"const": true},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "explicit_approval_recorded": {"const": true},
    "permit_preexisted_approval": {"const": true},
    "permit_unconsumed_at_approval": {"const": true},
    "approval_required_before_authorize": {"const": true},
    "request_reinterpreted_as_approval": {"const": false},
    "authority_created": {"const": false},
    "authority_expanded": {"const": false},
    "coordination_created": {"const": false},
    "action_permit_created": {"const": false},
    "action_permit_consumed": {"const": false},
    "execution_authorized": {"const": false},
    "execution_admitted": {"const": false},
    "pre_action_bundle_created": {"const": false},
    "lifecycle_authorize_admitted": {"const": false},
    "lifecycle_execute_ready": {"const": false},
    "interrupt_completed": {"const": false},
    "continuation_receipt_created": {"const": false},
    "successor_run_created": {"const": false},
    "runtime_state_transitioned": {"const": false},
    "approval_reusable": {"const": false},
    "approval_generalized": {"const": false},
    "future_action_permission_created": {"const": false},
    "general_authority_created": {"const": false},
    "legal_authority_established": {"const": false},
    "universal_authority_established": {"const": false},
    "legal_effect_established": {"const": false},
    "truth_certified": {"const": false},
    "causality_proven": {"const": false},
    "liability_established": {"const": false},
    "private_reasoning_included": {"const": false},
    "next_safe_action": {"const": "ASSEMBLE_PRE_ACTION_EVIDENCE_BUNDLE"},
    "issued_at": {"type": "string", "format": "date-time"},
    "fingerprint_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
