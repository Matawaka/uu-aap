{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.example/protocols/fcl/v0.1/capability-identity-mapping/receipt.schema.json",
  "title": "FCL Capability Identity Mapping Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "version", "receipt_type", "mapping_id", "origin",
    "authority_evaluation_id", "authority_evaluation_fingerprint",
    "request_id", "requested_control", "current_run_id", "current_run_epoch",
    "current_chain_id", "intent_ref", "fcl_required_scope", "fcl_required_target",
    "selection_id", "selection_content_hash", "selected_capability_id",
    "selected_descriptor_id", "selected_descriptor_content_hash", "selected_adapter_id",
    "selected_operation", "selected_operation_projection_hash", "descriptor_authority_scope",
    "mapping_status", "assertions", "non_effects", "next_safe_action",
    "mapped_at", "fingerprint_sha256"
  ],
  "properties": {
    "protocol": { "const": "FCL" },
    "version": { "const": "0.1" },
    "receipt_type": { "const": "FCLCapabilityIdentityMappingReceipt" },
    "mapping_id": { "type": "string", "minLength": 1 },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "tree"],
      "properties": {
        "repository": { "const": "Matawaka/uu-aap" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "authority_evaluation_id": { "type": "string", "minLength": 1 },
    "authority_evaluation_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "request_id": { "type": "string", "minLength": 1 },
    "requested_control": { "enum": ["REQUEST_INTERRUPT", "REQUEST_SUCCESSOR"] },
    "current_run_id": { "type": "string", "minLength": 1 },
    "current_run_epoch": { "type": "integer", "minimum": 0 },
    "current_chain_id": { "type": "string", "minLength": 1 },
    "intent_ref": { "type": "string", "minLength": 1 },
    "fcl_required_scope": { "enum": ["fcl.run.interrupt", "fcl.run.successor.create"] },
    "fcl_required_target": { "type": "string", "minLength": 1 },
    "selection_id": { "type": "string", "minLength": 1 },
    "selection_content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "selected_capability_id": { "type": "string", "minLength": 1 },
    "selected_descriptor_id": { "type": "string", "minLength": 1 },
    "selected_descriptor_content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "selected_adapter_id": { "type": "string", "minLength": 1 },
    "selected_operation": { "type": "string", "minLength": 1 },
    "selected_operation_projection_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "descriptor_authority_scope": { "enum": ["fcl.run.interrupt", "fcl.run.successor.create"] },
    "mapping_status": { "const": "EXACT" },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor_validated", "selection_validated", "authority_evaluation_validated",
        "selection_result_selected", "descriptor_ref_exact", "capability_exact",
        "operation_exact", "authority_scope_exact", "provider_neutral", "discovery_only",
        "external_effect_contract_preserved", "action_specific_approval_required",
        "fresh_availability_probe_required", "exact_target_binding_required",
        "predecessor_freshness_required", "fail_closed_target_guard_required",
        "one_shot_supported", "expiry_required", "separate_observer_required"
      ],
      "properties": {
        "descriptor_validated": { "const": true },
        "selection_validated": { "const": true },
        "authority_evaluation_validated": { "const": true },
        "selection_result_selected": { "const": true },
        "descriptor_ref_exact": { "const": true },
        "capability_exact": { "const": true },
        "operation_exact": { "const": true },
        "authority_scope_exact": { "const": true },
        "provider_neutral": { "const": true },
        "discovery_only": { "const": true },
        "external_effect_contract_preserved": { "const": true },
        "action_specific_approval_required": { "const": true },
        "fresh_availability_probe_required": { "const": true },
        "exact_target_binding_required": { "const": true },
        "predecessor_freshness_required": { "const": true },
        "fail_closed_target_guard_required": { "const": true },
        "one_shot_supported": { "const": true },
        "expiry_required": { "const": true },
        "separate_observer_required": { "const": true }
      }
    },
    "non_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_created_by_mapping", "availability_observed", "availability_claim_created",
        "intent_created", "authority_granted", "authority_expanded", "approval_created",
        "action_permit_created", "action_permit_consumed", "pre_action_bundle_created",
        "authorize_admitted", "execution_admitted", "action_performed",
        "interrupt_completed", "successor_run_created", "runtime_state_transitioned",
        "future_permission_created", "legal_effect_established", "truth_certified",
        "causality_proven", "liability_established", "private_reasoning_included"
      ],
      "properties": {
        "selection_created_by_mapping": { "const": false },
        "availability_observed": { "const": false },
        "availability_claim_created": { "const": false },
        "intent_created": { "const": false },
        "authority_granted": { "const": false },
        "authority_expanded": { "const": false },
        "approval_created": { "const": false },
        "action_permit_created": { "const": false },
        "action_permit_consumed": { "const": false },
        "pre_action_bundle_created": { "const": false },
        "authorize_admitted": { "const": false },
        "execution_admitted": { "const": false },
        "action_performed": { "const": false },
        "interrupt_completed": { "const": false },
        "successor_run_created": { "const": false },
        "runtime_state_transitioned": { "const": false },
        "future_permission_created": { "const": false },
        "legal_effect_established": { "const": false },
        "truth_certified": { "const": false },
        "causality_proven": { "const": false },
        "liability_established": { "const": false },
        "private_reasoning_included": { "const": false }
      }
    },
    "next_safe_action": { "const": "BUILD_SOURCE_VERIFIED_PRE_ACTION_EVIDENCE_CONTEXT" },
    "mapped_at": { "type": "string", "format": "date-time" },
    "fingerprint_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
