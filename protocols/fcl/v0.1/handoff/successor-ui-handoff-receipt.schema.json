{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.org/protocols/fcl/v0.1/handoff/successor-ui-handoff-receipt.schema.json",
  "title": "FCL Successor UI Handoff Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "receipt_type", "handoff_id", "predecessor_session_id", "predecessor_chain_id", "predecessor_run_id", "predecessor_run_epoch", "predecessor_terminal_projection_fingerprint", "predecessor_terminal_receipt_fingerprint", "predecessor_terminal_preserved", "continuation_receipt_fingerprint", "successor_chain_id", "successor_run_id", "successor_run_epoch", "successor_projection_fingerprint", "display_predecessor_projection_fingerprint", "intent_ref", "checkpoint_ref", "human_status", "predecessor_terminal_visible", "successor_primary_display", "predecessor_resurrection_admitted", "predecessor_authority_reacquired", "run_identity_reused", "intent_continuity_preserved", "checkpoint_continuity_preserved", "hidden_reasoning_transferred", "authority_transferred_by_handoff", "successor_requires_fresh_authority", "execution_admitted", "authority_established", "next_safe_action", "handoff_at", "fingerprint_sha256"],
  "properties": {
    "protocol": {"const": "FCL"},
    "version": {"const": "0.1"},
    "receipt_type": {"const": "SuccessorUIHandoffReceipt"},
    "handoff_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "predecessor_session_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "predecessor_chain_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "predecessor_run_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "predecessor_run_epoch": {"type": "integer", "minimum": 0},
    "predecessor_terminal_projection_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "predecessor_terminal_receipt_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "predecessor_terminal_preserved": {"const": true},
    "continuation_receipt_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "successor_chain_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "successor_run_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "successor_run_epoch": {"type": "integer", "minimum": 1},
    "successor_projection_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "display_predecessor_projection_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "intent_ref": {"type": "string", "minLength": 1},
    "checkpoint_ref": {"type": ["string", "null"]},
    "human_status": {"const": "CONTINUED_ON_SUCCESSOR"},
    "predecessor_terminal_visible": {"const": true},
    "successor_primary_display": {"const": true},
    "predecessor_resurrection_admitted": {"const": false},
    "predecessor_authority_reacquired": {"const": false},
    "run_identity_reused": {"const": false},
    "intent_continuity_preserved": {"const": true},
    "checkpoint_continuity_preserved": {"const": true},
    "hidden_reasoning_transferred": {"const": false},
    "authority_transferred_by_handoff": {"const": false},
    "successor_requires_fresh_authority": {"const": true},
    "execution_admitted": {"const": false},
    "authority_established": {"const": false},
    "next_safe_action": {"const": "WAIT_FOR_SUCCESSOR_PROGRESS"},
    "handoff_at": {"type": "string", "format": "date-time"},
    "fingerprint_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
