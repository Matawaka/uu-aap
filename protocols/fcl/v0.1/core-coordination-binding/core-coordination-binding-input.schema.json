{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.org/protocols/fcl/v0.1/core-coordination-binding/core-coordination-binding-input.schema.json",
  "title": "FCL Core CoordinationReceipt Binding Input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "profile",
    "coordination_id",
    "origin",
    "fcl_authority_evaluation",
    "core_state_receipt",
    "core_availability_claim",
    "core_intent_receipt",
    "core_authority_receipt",
    "issued_at"
  ],
  "properties": {
    "protocol": {"const": "FCL"},
    "version": {"const": "0.1"},
    "profile": {"const": "core-coordination-binding-v0.1"},
    "coordination_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "tree"],
      "properties": {
        "repository": {"const": "Matawaka/uu-aap"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "fcl_authority_evaluation": {"type": "object"},
    "core_state_receipt": {"type": "object"},
    "core_availability_claim": {"type": "object"},
    "core_intent_receipt": {"type": "object"},
    "core_authority_receipt": {"type": "object"},
    "issued_at": {"type": "string", "format": "date-time"}
  }
}
