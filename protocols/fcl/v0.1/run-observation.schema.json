{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.org/protocols/fcl/v0.1/run-observation.schema.json",
  "title": "FCL v0.1 Run Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "profile", "run_id", "run_epoch", "intent_ref", "lease", "intent_acknowledged", "current_phase", "last_progress_at", "progress_kind", "waiting_on", "next_observable_event", "external_effect_authority", "checkpoint_ref", "evaluated_at"],
  "properties": {
    "protocol": {"const": "FCL"},
    "version": {"const": "0.1"},
    "profile": {"const": "feedback-continuity-v0.1"},
    "run_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "run_epoch": {"type": "integer", "minimum": 0},
    "intent_ref": {"type": "string", "minLength": 1},
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starts_at", "stall_after_seconds", "expires_at"],
      "properties": {
        "starts_at": {"type": "string", "format": "date-time"},
        "stall_after_seconds": {"type": "integer", "minimum": 1},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "intent_acknowledged": {"type": "boolean"},
    "current_phase": {"type": "string", "minLength": 1},
    "last_progress_at": {"type": "string", "format": "date-time"},
    "progress_kind": {"enum": ["INTENT_ACK", "CHECKPOINT_COMMIT", "TOOL_OBSERVATION", "DEPENDENCY_WAIT", "SUBRESULT_COMMIT"]},
    "waiting_on": {"type": ["string", "null"]},
    "next_observable_event": {"type": "string", "minLength": 1},
    "external_effect_authority": {"type": "boolean"},
    "checkpoint_ref": {"type": ["string", "null"]},
    "evaluated_at": {"type": "string", "format": "date-time"}
  }
}
