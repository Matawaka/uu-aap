{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:schema:consequence-observation-source-adapter-receipt:0.1",
  "title": "ConsequenceObservationSourceAdapterReceipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "artifact_type", "artifact_version", "receipt_id", "evaluated_at",
    "policy_binding", "assessment_binding", "ingress_receipt_binding", "claim_binding",
    "source_evidence_binding", "producer_observation_binding", "frontier_entry_binding",
    "responsibility_event_head", "semantic_frontier", "effect_frontier", "runtime_context",
    "profile_decision", "claims"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "artifact_type": {"const": "ConsequenceObservationSourceAdapterReceipt"},
    "artifact_version": {"const": "0.1"},
    "receipt_id": {"type": "string", "pattern": "^urn:uu-aap:consequence-observation-source-adapter-receipt:[0-9a-f]{24}$"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "policy_binding": {"$ref": "#/$defs/binding"},
    "assessment_binding": {"$ref": "#/$defs/binding"},
    "ingress_receipt_binding": {"$ref": "#/$defs/binding"},
    "claim_binding": {"$ref": "#/$defs/binding"},
    "source_evidence_binding": {"$ref": "#/$defs/binding"},
    "producer_observation_binding": {"$ref": "#/$defs/binding"},
    "frontier_entry_binding": {"$ref": "#/$defs/binding"},
    "responsibility_event_head": {"type": "object"},
    "semantic_frontier": {"type": "object"},
    "effect_frontier": {"type": "object"},
    "runtime_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_class", "event_name", "repository", "workflow_name", "run_id",
        "run_attempt", "sha", "ref", "event_payload_digest"
      ],
      "properties": {
        "context_class": {"enum": ["candidate_pull_request", "main_push"]},
        "event_name": {"enum": ["pull_request", "push"]},
        "repository": {"const": "Matawaka/uu-aap"},
        "workflow_name": {"const": "ConsequenceObservation Source Adapter validation"},
        "run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "run_attempt": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "ref": {"type": "string", "minLength": 1},
        "event_payload_digest": {"$ref": "#/$defs/rawDigest"}
      }
    },
    "profile_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "policy_relative", "source_specific_observation_semantics_qualified",
        "typed_successor_source_eligible", "candidate_evidence", "main_bound_evidence",
        "successor_append_executed", "successor_append_may_proceed",
        "requires_separate_successor_append_operation"
      ],
      "properties": {
        "status": {"const": "eligible_as_typed_successor_source"},
        "policy_relative": {"const": true},
        "source_specific_observation_semantics_qualified": {"const": true},
        "typed_successor_source_eligible": {"const": true},
        "candidate_evidence": {"type": "boolean"},
        "main_bound_evidence": {"type": "boolean"},
        "successor_append_executed": {"const": false},
        "successor_append_may_proceed": {"const": false},
        "requires_separate_successor_append_operation": {"const": true}
      },
      "allOf": [
        {
          "if": {"properties": {"candidate_evidence": {"const": true}}},
          "then": {"properties": {"main_bound_evidence": {"const": false}}}
        },
        {
          "if": {"properties": {"main_bound_evidence": {"const": true}}},
          "then": {"properties": {"candidate_evidence": {"const": false}}}
        }
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_policy_applied", "predecessor_assessment_deferred_profile_verified",
        "exact_producer_profile_matched", "source_specific_observation_semantics_qualified",
        "typed_successor_source_eligible", "stronger_claims_withheld",
        "provider_identity_cryptographically_attested", "github_remote_truth_certified",
        "new_external_consequence_observed", "consequence_truth_certified",
        "generalized_external_consequence_causality_established", "causal_proof_certified",
        "responsibility_for_consequence_attributed", "responsibility_for_outcome_adjudicated",
        "legal_liability_established", "legal_effect_established", "moral_blame_assigned",
        "truth_certified", "successor_append_executed", "successor_append_may_proceed",
        "global_replay_protection_established", "distributed_consensus_established",
        "poai_materialization_event_recorded", "universal_canonicality_established"
      ],
      "properties": {
        "adapter_policy_applied": {"const": true},
        "predecessor_assessment_deferred_profile_verified": {"const": true},
        "exact_producer_profile_matched": {"const": true},
        "source_specific_observation_semantics_qualified": {"const": true},
        "typed_successor_source_eligible": {"const": true},
        "stronger_claims_withheld": {"const": true},
        "provider_identity_cryptographically_attested": {"const": false},
        "github_remote_truth_certified": {"const": false},
        "new_external_consequence_observed": {"const": false},
        "consequence_truth_certified": {"const": false},
        "generalized_external_consequence_causality_established": {"const": false},
        "causal_proof_certified": {"const": false},
        "responsibility_for_consequence_attributed": {"const": false},
        "responsibility_for_outcome_adjudicated": {"const": false},
        "legal_liability_established": {"const": false},
        "legal_effect_established": {"const": false},
        "moral_blame_assigned": {"const": false},
        "truth_certified": {"const": false},
        "successor_append_executed": {"const": false},
        "successor_append_may_proceed": {"const": false},
        "global_replay_protection_established": {"const": false},
        "distributed_consensus_established": {"const": false},
        "poai_materialization_event_recorded": {"const": false},
        "universal_canonicality_established": {"const": false}
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "digest_algorithm", "digest_encoding", "value"],
      "properties": {
        "canonicalization": {"const": "RFC8785-JCS"},
        "digest_algorithm": {"const": "SHA-256"},
        "digest_encoding": {"const": "hex"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "rawDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "digest_algorithm", "digest_encoding", "value"],
      "properties": {
        "canonicalization": {"const": "raw-bytes"},
        "digest_algorithm": {"const": "SHA-256"},
        "digest_encoding": {"const": "hex"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "artifact_ref", "digest"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
