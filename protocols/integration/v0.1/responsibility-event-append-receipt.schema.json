{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/protocols/integration/v0.1/responsibility-event-append-receipt.schema.json",
  "title": "UU-AAP ResponsibilityEventAppendReceipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "artifact_type", "artifact_version", "append_receipt_id", "appended_at",
    "base_chain_binding", "base_head", "source_reobservation_binding", "appended_event",
    "extended_head", "extension_digest", "replay_semantics", "verification", "claims"
  ],
  "properties": {
    "$schema": {"const": "./responsibility-event-append-receipt.schema.json"},
    "artifact_type": {"const": "ResponsibilityEventAppendReceipt"},
    "artifact_version": {"const": "0.1"},
    "append_receipt_id": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event-append-receipt:"},
    "appended_at": {"type": "string", "format": "date-time"},
    "base_chain_binding": {"$ref": "#/$defs/chainBinding"},
    "base_head": {"$ref": "#/$defs/baseHead"},
    "source_reobservation_binding": {"$ref": "#/$defs/reobservationBinding"},
    "appended_event": {"$ref": "#/$defs/appendedEvent"},
    "extended_head": {"$ref": "#/$defs/extendedHead"},
    "extension_digest": {"$ref": "#/$defs/digest"},
    "replay_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "distinct_duplicate_identity_permitted", "global_replay_protection_established"],
      "properties": {
        "mode": {"const": "deterministic_idempotent_same_inputs"},
        "distinct_duplicate_identity_permitted": {"const": false},
        "global_replay_protection_established": {"const": false}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_chain_exact", "base_head_exact", "source_reobservation_exact", "source_reobservation_verified",
        "semantic_frontier_exact", "effect_frontier_exact", "append_sequence_exact",
        "predecessor_event_digest_exact", "appended_event_digest_exact", "extended_head_exact",
        "extension_digest_exact", "local_stage_order_preserved", "historical_assurance_preserved",
        "scalar_scoring_absent", "base_chain_mutated"
      ],
      "properties": {
        "base_chain_exact": {"const": true},
        "base_head_exact": {"const": true},
        "source_reobservation_exact": {"const": true},
        "source_reobservation_verified": {"const": true},
        "semantic_frontier_exact": {"const": true},
        "effect_frontier_exact": {"const": true},
        "append_sequence_exact": {"const": true},
        "predecessor_event_digest_exact": {"const": true},
        "appended_event_digest_exact": {"const": true},
        "extended_head_exact": {"const": true},
        "extension_digest_exact": {"const": true},
        "local_stage_order_preserved": {"const": true},
        "historical_assurance_preserved": {"const": true},
        "scalar_scoring_absent": {"const": true},
        "base_chain_mutated": {"const": false}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "append_only_extension_established", "base_chain_immutable_preserved",
        "responsibility_event_chain_reobservation_appended", "chain_integrity_reobserved",
        "new_external_consequence_observed", "generalized_external_consequence_causality_established",
        "universal_causal_truth_established", "causal_proof_certified",
        "responsibility_for_outcome_adjudicated", "legal_responsibility_determined",
        "legal_liability_established", "legal_effect_established", "moral_blame_assigned",
        "moral_correctness_established", "truth_certified",
        "complete_global_wall_clock_chronology_established",
        "remote_branch_or_ref_canonicality_established", "poai_materialization_event_recorded",
        "poai_successor_record_identity_inferred", "universal_canonicality_established",
        "poai_v_conformance_established"
      ],
      "properties": {
        "append_only_extension_established": {"const": true},
        "base_chain_immutable_preserved": {"const": true},
        "responsibility_event_chain_reobservation_appended": {"const": true},
        "chain_integrity_reobserved": {"const": true},
        "new_external_consequence_observed": {"const": false},
        "generalized_external_consequence_causality_established": {"const": false},
        "universal_causal_truth_established": {"const": false},
        "causal_proof_certified": {"const": false},
        "responsibility_for_outcome_adjudicated": {"const": false},
        "legal_responsibility_determined": {"const": false},
        "legal_liability_established": {"const": false},
        "legal_effect_established": {"const": false},
        "moral_blame_assigned": {"const": false},
        "moral_correctness_established": {"const": false},
        "truth_certified": {"const": false},
        "complete_global_wall_clock_chronology_established": {"const": false},
        "remote_branch_or_ref_canonicality_established": {"const": false},
        "poai_materialization_event_recorded": {"const": false},
        "poai_successor_record_identity_inferred": {"const": false},
        "universal_canonicality_established": {"const": false},
        "poai_v_conformance_established": {"const": false}
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "digest_algorithm", "digest_encoding", "value"],
      "properties": {
        "canonicalization": {"const": "RFC8785-JCS"},
        "digest_algorithm": {"const": "SHA-256"},
        "digest_encoding": {"const": "hex"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "chainBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "artifact_ref", "digest"],
      "properties": {
        "artifact_type": {"const": "ResponsibilityEventChain"},
        "artifact_ref": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event-chain:"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "reobservationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "artifact_ref", "digest"],
      "properties": {
        "artifact_type": {"const": "ResponsibilityEventChainReobservationReceipt"},
        "artifact_ref": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event-chain-reobservation:"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "baseHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "event_id", "event_digest"],
      "properties": {
        "sequence": {"const": 5},
        "event_id": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event:"},
        "event_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "extendedHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "event_id", "event_digest"],
      "properties": {
        "sequence": {"const": 6},
        "event_id": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event:"},
        "event_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "semanticBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target", "operation_ref", "base_revision", "responsible_party_id", "executor_implementation_id"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "operation_ref": {"type": "string", "minLength": 1},
        "base_revision": {"type": "string", "minLength": 1},
        "responsible_party_id": {"type": "string", "minLength": 1},
        "executor_implementation_id": {"type": "string", "minLength": 1}
      }
    },
    "effectObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_object_sha"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "git_object_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "relation", "revision", "commit_sha", "tree_sha", "changed_paths", "effect_objects"],
      "properties": {
        "scope": {"const": "exact_local_git_transition_effect"},
        "relation": {"const": "exact_state_transition_effect"},
        "revision": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "effect_objects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/effectObject"}}
      }
    },
    "assuranceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_observed", "responsibility_chain_traceable", "bounded_causal_association_supported",
        "model_relative_intervention_sensitivity_assessed", "bounded_causal_predicates_qualified",
        "policy_relative_responsibility_attribution_established", "chain_integrity_reobserved",
        "generalized_external_consequence_causality_established", "causal_proof_certified",
        "responsibility_adjudicated", "legal_liability_established", "moral_blame_assigned", "truth_certified"
      ],
      "properties": {
        "outcome_observed": {"const": true},
        "responsibility_chain_traceable": {"const": true},
        "bounded_causal_association_supported": {"const": true},
        "model_relative_intervention_sensitivity_assessed": {"const": true},
        "bounded_causal_predicates_qualified": {"const": true},
        "policy_relative_responsibility_attribution_established": {"const": true},
        "chain_integrity_reobserved": {"const": true},
        "generalized_external_consequence_causality_established": {"const": false},
        "causal_proof_certified": {"const": false},
        "responsibility_adjudicated": {"const": false},
        "legal_liability_established": {"const": false},
        "moral_blame_assigned": {"const": false},
        "truth_certified": {"const": false}
      }
    },
    "appendedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence", "event_id", "event_kind", "stage_time", "source_binding",
        "semantic_binding", "effect_frontier", "predecessor_event_digest",
        "assurance_snapshot", "event_digest"
      ],
      "properties": {
        "sequence": {"const": 6},
        "event_id": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event:"},
        "event_kind": {"const": "responsibility_event_chain_reobserved"},
        "stage_time": {"type": "string", "format": "date-time"},
        "source_binding": {"$ref": "#/$defs/reobservationBinding"},
        "semantic_binding": {"$ref": "#/$defs/semanticBinding"},
        "effect_frontier": {"$ref": "#/$defs/effect"},
        "predecessor_event_digest": {"$ref": "#/$defs/digest"},
        "assurance_snapshot": {"$ref": "#/$defs/assuranceSnapshot"},
        "event_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
