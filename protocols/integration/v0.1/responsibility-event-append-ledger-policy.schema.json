{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/protocols/integration/v0.1/responsibility-event-append-ledger-policy.schema.json",
  "title": "UU-AAP ResponsibilityEventAppendLedgerPolicy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "artifact_type", "artifact_version", "policy_id", "policy_version", "ledger_id",
    "storage_scope", "storage_model", "atomic_publication", "head_authority", "replay_scope",
    "corruption_mode", "accepted_append_artifact", "invariants", "claims"
  ],
  "properties": {
    "$schema": {"const": "../responsibility-event-append-ledger-policy.schema.json"},
    "artifact_type": {"const": "ResponsibilityEventAppendLedgerPolicy"},
    "artifact_version": {"const": "0.1"},
    "policy_id": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event-append-ledger-policy:"},
    "policy_version": {"type": "integer", "minimum": 1},
    "ledger_id": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event-append-ledger:"},
    "storage_scope": {"const": "local_filesystem_append_ledger"},
    "storage_model": {"const": "immutable_entry_files"},
    "atomic_publication": {"const": "temp_fsync_rename_dir_fsync"},
    "head_authority": {"const": "validated_entry_chain_replay"},
    "replay_scope": {"const": "ledger_local_history"},
    "corruption_mode": {"const": "fail_closed"},
    "accepted_append_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "artifact_version"],
      "properties": {
        "artifact_type": {"const": "ResponsibilityEventAppendReceipt"},
        "artifact_version": {"const": "0.1"}
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writer_lock_required", "atomic_publication_required", "file_fsync_required",
        "entries_directory_fsync_required", "immutable_committed_entries", "contiguous_sequence_required",
        "predecessor_entry_digest_required", "predecessor_event_head_required",
        "duplicate_append_receipt_rejected", "duplicate_event_identity_rejected",
        "stale_head_fork_rejected", "recovery_validation_required", "mutable_head_authoritative",
        "temporary_file_authoritative", "scalar_responsibility_score_allowed"
      ],
      "properties": {
        "writer_lock_required": {"const": true},
        "atomic_publication_required": {"const": true},
        "file_fsync_required": {"const": true},
        "entries_directory_fsync_required": {"const": true},
        "immutable_committed_entries": {"const": true},
        "contiguous_sequence_required": {"const": true},
        "predecessor_entry_digest_required": {"const": true},
        "predecessor_event_head_required": {"const": true},
        "duplicate_append_receipt_rejected": {"const": true},
        "duplicate_event_identity_rejected": {"const": true},
        "stale_head_fork_rejected": {"const": true},
        "recovery_validation_required": {"const": true},
        "mutable_head_authoritative": {"const": false},
        "temporary_file_authoritative": {"const": false},
        "scalar_responsibility_score_allowed": {"const": false}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_local_durable_replay_policy_defined", "distributed_consensus_established",
        "global_replay_protection_established", "universal_canonicality_established",
        "new_external_consequence_observed", "causal_proof_certified",
        "responsibility_for_outcome_adjudicated", "legal_liability_established",
        "moral_blame_assigned", "truth_certified", "poai_materialization_event_recorded"
      ],
      "properties": {
        "ledger_local_durable_replay_policy_defined": {"const": true},
        "distributed_consensus_established": {"const": false},
        "global_replay_protection_established": {"const": false},
        "universal_canonicality_established": {"const": false},
        "new_external_consequence_observed": {"const": false},
        "causal_proof_certified": {"const": false},
        "responsibility_for_outcome_adjudicated": {"const": false},
        "legal_liability_established": {"const": false},
        "moral_blame_assigned": {"const": false},
        "truth_certified": {"const": false},
        "poai_materialization_event_recorded": {"const": false}
      }
    }
  }
}
