{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/protocols/integration/v0.1/responsibility-event-append-ledger-entry.schema.json",
  "title": "UU-AAP ResponsibilityEventAppendLedgerEntry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "artifact_type", "artifact_version", "entry_id", "ledger_id", "sequence", "committed_at",
    "previous_entry_binding", "ledger_policy", "ledger_policy_binding", "validation_bundle",
    "base_chain_binding", "append_receipt_binding", "predecessor_event_head", "resulting_event_head",
    "claims", "entry_digest"
  ],
  "properties": {
    "$schema": {"const": "./responsibility-event-append-ledger-entry.schema.json"},
    "artifact_type": {"const": "ResponsibilityEventAppendLedgerEntry"},
    "artifact_version": {"const": "0.1"},
    "entry_id": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event-append-ledger-entry:"},
    "ledger_id": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event-append-ledger:"},
    "sequence": {"type": "integer", "minimum": 0},
    "committed_at": {"type": "string", "format": "date-time"},
    "previous_entry_binding": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/entryBinding"}]},
    "ledger_policy": {"$ref": "#/$defs/ledgerPolicyArtifact"},
    "ledger_policy_binding": {"$ref": "#/$defs/policyBinding"},
    "validation_bundle": {"$ref": "#/$defs/validationBundle"},
    "base_chain_binding": {"$ref": "#/$defs/chainBinding"},
    "append_receipt_binding": {"$ref": "#/$defs/appendBinding"},
    "predecessor_event_head": {"$ref": "#/$defs/head"},
    "resulting_event_head": {"$ref": "#/$defs/head"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_durable_commit_established", "authoritative_successor_head_derivable",
        "embedded_historical_evidence_bound", "ledger_local_durable_replay_protection_established",
        "accepted_append_identity_set_recoverable", "distributed_consensus_established",
        "global_replay_protection_established", "new_external_consequence_observed",
        "causal_proof_certified", "responsibility_for_outcome_adjudicated",
        "legal_liability_established", "moral_blame_assigned", "truth_certified",
        "universal_canonicality_established", "poai_materialization_event_recorded"
      ],
      "properties": {
        "local_durable_commit_established": {"const": true},
        "authoritative_successor_head_derivable": {"const": true},
        "embedded_historical_evidence_bound": {"const": true},
        "ledger_local_durable_replay_protection_established": {"const": true},
        "accepted_append_identity_set_recoverable": {"const": true},
        "distributed_consensus_established": {"const": false},
        "global_replay_protection_established": {"const": false},
        "new_external_consequence_observed": {"const": false},
        "causal_proof_certified": {"const": false},
        "responsibility_for_outcome_adjudicated": {"const": false},
        "legal_liability_established": {"const": false},
        "moral_blame_assigned": {"const": false},
        "truth_certified": {"const": false},
        "universal_canonicality_established": {"const": false},
        "poai_materialization_event_recorded": {"const": false}
      }
    },
    "entry_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "object", "additionalProperties": false,
      "required": ["canonicalization", "digest_algorithm", "digest_encoding", "value"],
      "properties": {
        "canonicalization": {"const": "RFC8785-JCS"},
        "digest_algorithm": {"const": "SHA-256"},
        "digest_encoding": {"const": "hex"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "artifact_ref", "digest"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "entryBinding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"artifact_type": {"const": "ResponsibilityEventAppendLedgerEntry"}, "artifact_ref": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event-append-ledger-entry:"}}}
      ]
    },
    "policyBinding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"artifact_type": {"const": "ResponsibilityEventAppendLedgerPolicy"}, "artifact_ref": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event-append-ledger-policy:"}}}
      ]
    },
    "chainBinding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"artifact_type": {"const": "ResponsibilityEventChain"}, "artifact_ref": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event-chain:"}}}
      ]
    },
    "appendBinding": {
      "allOf": [
        {"$ref": "#/$defs/binding"},
        {"properties": {"artifact_type": {"const": "ResponsibilityEventAppendReceipt"}, "artifact_ref": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event-append-receipt:"}}}
      ]
    },
    "head": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "event_id", "event_digest"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 5},
        "event_id": {"type": "string", "pattern": "^urn:uu-aap:responsibility-event:"},
        "event_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "typedArtifact": {
      "type": "object",
      "required": ["artifact_type", "artifact_version"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "artifact_version": {"const": "0.1"}
      },
      "additionalProperties": true
    },
    "ledgerPolicyArtifact": {
      "allOf": [
        {"$ref": "#/$defs/typedArtifact"},
        {"properties": {"artifact_type": {"const": "ResponsibilityEventAppendLedgerPolicy"}}}
      ]
    },
    "validationBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_chain", "origin_sources", "reobservation", "append_receipt"],
      "properties": {
        "base_chain": {"allOf": [{"$ref": "#/$defs/typedArtifact"}, {"properties": {"artifact_type": {"const": "ResponsibilityEventChain"}}}]},
        "origin_sources": {
          "type": "object", "additionalProperties": false,
          "required": ["outcome_observation", "responsibility_trace", "causal_assessment", "counterfactual_assessment", "causal_qualification", "responsibility_attribution"],
          "properties": {
            "outcome_observation": {"allOf": [{"$ref": "#/$defs/typedArtifact"}, {"properties": {"artifact_type": {"const": "OutcomeObservationReceipt"}}}]},
            "responsibility_trace": {"allOf": [{"$ref": "#/$defs/typedArtifact"}, {"properties": {"artifact_type": {"const": "ResponsibilityTrace"}}}]},
            "causal_assessment": {"allOf": [{"$ref": "#/$defs/typedArtifact"}, {"properties": {"artifact_type": {"const": "CausalAttributionAssessment"}}}]},
            "counterfactual_assessment": {"allOf": [{"$ref": "#/$defs/typedArtifact"}, {"properties": {"artifact_type": {"const": "CounterfactualInterventionAssessment"}}}]},
            "causal_qualification": {"allOf": [{"$ref": "#/$defs/typedArtifact"}, {"properties": {"artifact_type": {"const": "CausalClaimQualification"}}}]},
            "responsibility_attribution": {"allOf": [{"$ref": "#/$defs/typedArtifact"}, {"properties": {"artifact_type": {"const": "ResponsibilityAttributionAssessment"}}}]}
          }
        },
        "reobservation": {"allOf": [{"$ref": "#/$defs/typedArtifact"}, {"properties": {"artifact_type": {"const": "ResponsibilityEventChainReobservationReceipt"}}}]},
        "append_receipt": {"allOf": [{"$ref": "#/$defs/typedArtifact"}, {"properties": {"artifact_type": {"const": "ResponsibilityEventAppendReceipt"}}}]}
      }
    }
  }
}
