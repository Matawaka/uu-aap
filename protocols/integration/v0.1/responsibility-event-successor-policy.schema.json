{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/protocols/integration/v0.1/responsibility-event-successor-policy.schema.json",
  "title": "UU-AAP ResponsibilityEventSuccessorPolicy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "artifact_type", "artifact_version", "policy_id", "policy_version",
    "storage_policy_ref", "sequence_increment", "allowed_source_adapters", "invariants", "claims"
  ],
  "properties": {
    "$schema": {"const": "../responsibility-event-successor-policy.schema.json"},
    "artifact_type": {"const": "ResponsibilityEventSuccessorPolicy"},
    "artifact_version": {"const": "0.1"},
    "policy_id": {"const": "urn:uu-aap:responsibility-event-successor-policy:local-ledger:1"},
    "policy_version": {"const": 1},
    "storage_policy_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "artifact_version", "policy_id", "policy_version", "exact_binding_required"],
      "properties": {
        "artifact_type": {"const": "ResponsibilityEventAppendLedgerPolicy"},
        "artifact_version": {"const": "0.1"},
        "policy_id": {"const": "urn:uu-aap:responsibility-event-append-ledger-policy:local-filesystem:1"},
        "policy_version": {"const": 1},
        "exact_binding_required": {"const": true}
      }
    },
    "sequence_increment": {"const": 1},
    "allowed_source_adapters": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["responsibility_event_append_ledger_reobservation_v0.1"]}
    },
    "invariants": {
      "type": "object", "additionalProperties": false,
      "required": [
        "typed_source_required", "predecessor_head_exact", "predecessor_entry_exact",
        "semantic_binding_immutable", "effect_frontier_immutable", "source_binding_exact",
        "source_stage_time_monotonic", "successor_sequence_exact", "assurance_monotonic",
        "deterministic_identity_required", "scalar_responsibility_score_allowed"
      ],
      "properties": {
        "typed_source_required": {"const": true},
        "predecessor_head_exact": {"const": true},
        "predecessor_entry_exact": {"const": true},
        "semantic_binding_immutable": {"const": true},
        "effect_frontier_immutable": {"const": true},
        "source_binding_exact": {"const": true},
        "source_stage_time_monotonic": {"const": true},
        "successor_sequence_exact": {"const": true},
        "assurance_monotonic": {"const": true},
        "deterministic_identity_required": {"const": true},
        "scalar_responsibility_score_allowed": {"const": false}
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": [
        "generic_successor_append_policy_defined", "new_external_consequence_observed",
        "generalized_external_consequence_causality_established", "causal_proof_certified",
        "responsibility_for_outcome_adjudicated", "legal_liability_established", "legal_effect_established",
        "moral_blame_assigned", "moral_correctness_established", "truth_certified",
        "global_replay_protection_established", "distributed_consensus_established",
        "poai_materialization_event_recorded", "universal_canonicality_established"
      ],
      "properties": {
        "generic_successor_append_policy_defined": {"const": true},
        "new_external_consequence_observed": {"const": false},
        "generalized_external_consequence_causality_established": {"const": false},
        "causal_proof_certified": {"const": false},
        "responsibility_for_outcome_adjudicated": {"const": false},
        "legal_liability_established": {"const": false},
        "legal_effect_established": {"const": false},
        "moral_blame_assigned": {"const": false},
        "moral_correctness_established": {"const": false},
        "truth_certified": {"const": false},
        "global_replay_protection_established": {"const": false},
        "distributed_consensus_established": {"const": false},
        "poai_materialization_event_recorded": {"const": false},
        "universal_canonicality_established": {"const": false}
      }
    }
  }
}
