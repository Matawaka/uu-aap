{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/protocols/integration/v0.1/commit-receipt.schema.json",
  "title": "UU-AAP CommitReceipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "receipt_id",
    "recorded_at",
    "commit_decision_ref",
    "execution_mode",
    "action",
    "target",
    "operation_ref",
    "responsible_party_id",
    "executor_implementation_id",
    "predecessor",
    "successor",
    "effect",
    "git_verification",
    "claims"
  ],
  "properties": {
    "$schema": {"const": "./commit-receipt.schema.json"},
    "artifact_type": {"const": "CommitReceipt"},
    "artifact_version": {"const": "0.1"},
    "receipt_id": {"type": "string", "pattern": "^urn:uu-aap:commit-receipt:"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "commit_decision_ref": {"type": "string", "pattern": "^urn:uu-aap:commit-decision:"},
    "execution_mode": {"const": "ephemeral_local_git_object"},
    "action": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "operation_ref": {"type": "string", "minLength": 1},
    "responsible_party_id": {"type": "string", "minLength": 1},
    "executor_implementation_id": {"type": "string", "minLength": 1},
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "commit_sha", "tree_sha"],
      "properties": {
        "revision": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "commit_sha", "tree_sha", "parent_commit_sha"],
      "properties": {
        "revision": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "parent_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "changed_paths", "changed_path_count"],
      "properties": {
        "kind": {"const": "git_commit"},
        "changed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "changed_path_count": {"type": "integer", "minimum": 1}
      }
    },
    "git_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_frontier_exact",
        "predecessor_commit_exists",
        "successor_commit_exists",
        "single_parent_exact",
        "successor_tree_exact",
        "tree_changed",
        "changed_paths_exact",
        "refs_unchanged",
        "working_tree_unchanged"
      ],
      "properties": {
        "decision_frontier_exact": {"const": true},
        "predecessor_commit_exists": {"const": true},
        "successor_commit_exists": {"const": true},
        "single_parent_exact": {"const": true},
        "successor_tree_exact": {"const": true},
        "tree_changed": {"const": true},
        "changed_paths_exact": {"const": true},
        "refs_unchanged": {"const": true},
        "working_tree_unchanged": {"const": true}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_decision_approved",
        "commit_object_created",
        "state_transition_evidence_established",
        "commit_performed",
        "local_ephemeral_execution_established",
        "remote_repository_mutation_performed",
        "published_branch_or_ref_update_established",
        "poai_materialization_event_recorded",
        "outcome_observed",
        "policy_relative_canonicality_established",
        "universal_canonicality_established",
        "truth_certified",
        "causal_proof_certified",
        "legal_effect_established",
        "poai_v_conformance_established"
      ],
      "properties": {
        "commit_decision_approved": {"const": true},
        "commit_object_created": {"const": true},
        "state_transition_evidence_established": {"const": true},
        "commit_performed": {"const": true},
        "local_ephemeral_execution_established": {"const": true},
        "remote_repository_mutation_performed": {"const": false},
        "published_branch_or_ref_update_established": {"const": false},
        "poai_materialization_event_recorded": {"const": false},
        "outcome_observed": {"const": false},
        "policy_relative_canonicality_established": {"const": false},
        "universal_canonicality_established": {"const": false},
        "truth_certified": {"const": false},
        "causal_proof_certified": {"const": false},
        "legal_effect_established": {"const": false},
        "poai_v_conformance_established": {"const": false}
      }
    }
  }
}