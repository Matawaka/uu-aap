{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:schema:consequence-observation-source-adapter-policy:0.1",
  "title": "ConsequenceObservationSourceAdapterPolicy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "artifact_type", "artifact_version", "policy_id", "policy_version",
    "adapter_scope", "effective_from", "effective_until", "registered_profile",
    "required_predecessor", "invariants", "claims"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "artifact_type": {"const": "ConsequenceObservationSourceAdapterPolicy"},
    "artifact_version": {"const": "0.1"},
    "policy_id": {"const": "urn:uu-aap:consequence-observation-source-adapter-policy:github-actions-runtime:1"},
    "policy_version": {"const": 1},
    "adapter_scope": {"const": "urn:uu-aap:consequence-observation-source-adapter-scope:github-actions-runtime-v0.1"},
    "effective_from": {"type": "string", "format": "date-time"},
    "effective_until": {"type": ["string", "null"], "format": "date-time"},
    "registered_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id", "producer_artifact_type", "producer_artifact_version",
        "repository", "workflow_name", "allowed_event_names", "observation_method",
        "consequence_class"
      ],
      "properties": {
        "producer_id": {"const": "urn:uu-aap:producer:github-actions-runtime"},
        "producer_artifact_type": {"const": "GitHubActionsRuntimeObservation"},
        "producer_artifact_version": {"const": "0.1"},
        "repository": {"const": "Matawaka/uu-aap"},
        "workflow_name": {"const": "ConsequenceObservation Source Adapter validation"},
        "allowed_event_names": {
          "type": "array",
          "prefixItems": [{"const": "pull_request"}, {"const": "push"}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "observation_method": {"const": "system_record"},
        "consequence_class": {"const": "other"}
      }
    },
    "required_predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment_artifact_type", "assessment_artifact_version", "assessment_policy_id", "assessment_status"],
      "properties": {
        "assessment_artifact_type": {"const": "ConsequenceObservationAssessment"},
        "assessment_artifact_version": {"const": "0.1"},
        "assessment_policy_id": {"const": "urn:uu-aap:consequence-observation-assessment-policy:bounded-source-admissibility:1"},
        "assessment_status": {"const": "deferred_source_profile_required"}
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_byte_bindings_required", "live_observed_claim_required", "fixture_source_allowed",
        "event_payload_byte_digest_required", "event_ref_semantics_required",
        "provider_identity_is_runtime_declared_not_cryptographically_attested",
        "typed_successor_source_eligibility_allowed", "successor_append_execution_allowed",
        "successor_append_permission_allowed", "policy_relative_only", "scalar_scores_allowed"
      ],
      "properties": {
        "exact_byte_bindings_required": {"const": true},
        "live_observed_claim_required": {"const": true},
        "fixture_source_allowed": {"const": false},
        "event_payload_byte_digest_required": {"const": true},
        "event_ref_semantics_required": {"const": true},
        "provider_identity_is_runtime_declared_not_cryptographically_attested": {"const": true},
        "typed_successor_source_eligibility_allowed": {"const": true},
        "successor_append_execution_allowed": {"const": false},
        "successor_append_permission_allowed": {"const": false},
        "policy_relative_only": {"const": true},
        "scalar_scores_allowed": {"const": false}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_adapter_policy_defined", "registered_profile_count_one",
        "provider_identity_cryptographically_attested", "github_remote_truth_certified",
        "new_external_consequence_observed", "consequence_truth_certified",
        "causal_proof_certified", "responsibility_for_consequence_attributed",
        "responsibility_for_outcome_adjudicated", "legal_liability_established",
        "legal_effect_established", "moral_blame_assigned", "truth_certified",
        "successor_append_executed", "successor_append_may_proceed",
        "poai_materialization_event_recorded", "universal_canonicality_established"
      ],
      "properties": {
        "source_adapter_policy_defined": {"const": true},
        "registered_profile_count_one": {"const": true},
        "provider_identity_cryptographically_attested": {"const": false},
        "github_remote_truth_certified": {"const": false},
        "new_external_consequence_observed": {"const": false},
        "consequence_truth_certified": {"const": false},
        "causal_proof_certified": {"const": false},
        "responsibility_for_consequence_attributed": {"const": false},
        "responsibility_for_outcome_adjudicated": {"const": false},
        "legal_liability_established": {"const": false},
        "legal_effect_established": {"const": false},
        "moral_blame_assigned": {"const": false},
        "truth_certified": {"const": false},
        "successor_append_executed": {"const": false},
        "successor_append_may_proceed": {"const": false},
        "poai_materialization_event_recorded": {"const": false},
        "universal_canonicality_established": {"const": false}
      }
    }
  }
}
