{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:schema:consequence-observation-source-adapter-main-binding-policy:0.1",
  "title": "ConsequenceObservationSourceAdapterMainBindingPolicy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "artifact_type", "artifact_version", "policy_id", "policy_version",
    "repository", "source_workflow", "artifact_name_prefix", "required_source_artifacts",
    "invariants", "claims"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "artifact_type": {"const": "ConsequenceObservationSourceAdapterMainBindingPolicy"},
    "artifact_version": {"const": "0.1"},
    "policy_id": {"const": "urn:uu-aap:consequence-observation-source-adapter-main-binding-policy:github-actions-main:1"},
    "policy_version": {"const": 1},
    "repository": {"const": "Matawaka/uu-aap"},
    "source_workflow": {"const": "ConsequenceObservation Source Adapter validation"},
    "artifact_name_prefix": {"const": "consequence-source-adapter-"},
    "required_source_artifacts": {
      "type": "array",
      "prefixItems": [
        {"const": "github-actions-runtime-observation.json"},
        {"const": "consequence-observation-source-live.json"},
        {"const": "consequence-observation-claim-live.json"},
        {"const": "consequence-observation-ingress-live.json"},
        {"const": "consequence-observation-assessment-live-deferred.json"},
        {"const": "consequence-observation-source-adapter-receipt.json"},
        {"const": "consequence-observation-source-adapter-summary.json"}
      ],
      "items": false,
      "minItems": 7,
      "maxItems": 7
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_push_event_required", "exact_main_ref_required", "workflow_success_required",
        "artifact_name_revision_bound", "artifact_not_expired_required", "bundle_schema_valid_required",
        "bundle_cross_digest_binding_required", "adapter_receipt_main_bound_required",
        "adapter_receipt_candidate_prohibited", "source_revision_explicit_required",
        "successor_append_permission_allowed", "successor_append_execution_allowed",
        "server_runtime_dependency_required", "scalar_scores_allowed"
      ],
      "properties": {
        "exact_push_event_required": {"const": true},
        "exact_main_ref_required": {"const": true},
        "workflow_success_required": {"const": true},
        "artifact_name_revision_bound": {"const": true},
        "artifact_not_expired_required": {"const": true},
        "bundle_schema_valid_required": {"const": true},
        "bundle_cross_digest_binding_required": {"const": true},
        "adapter_receipt_main_bound_required": {"const": true},
        "adapter_receipt_candidate_prohibited": {"const": true},
        "source_revision_explicit_required": {"const": true},
        "successor_append_permission_allowed": {"const": false},
        "successor_append_execution_allowed": {"const": false},
        "server_runtime_dependency_required": {"const": false},
        "scalar_scores_allowed": {"const": false}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_binding_policy_defined", "provider_identity_cryptographically_attested",
        "github_remote_truth_certified", "new_external_consequence_observed",
        "consequence_truth_certified", "generalized_external_consequence_causality_established",
        "causal_proof_certified", "responsibility_for_consequence_attributed",
        "responsibility_for_outcome_adjudicated", "legal_liability_established",
        "legal_effect_established", "moral_blame_assigned", "moral_correctness_established",
        "truth_certified", "successor_append_may_proceed", "successor_append_executed",
        "global_replay_protection_established", "distributed_consensus_established",
        "poai_materialization_event_recorded", "universal_canonicality_established"
      ],
      "properties": {
        "main_binding_policy_defined": {"const": true},
        "provider_identity_cryptographically_attested": {"const": false},
        "github_remote_truth_certified": {"const": false},
        "new_external_consequence_observed": {"const": false},
        "consequence_truth_certified": {"const": false},
        "generalized_external_consequence_causality_established": {"const": false},
        "causal_proof_certified": {"const": false},
        "responsibility_for_consequence_attributed": {"const": false},
        "responsibility_for_outcome_adjudicated": {"const": false},
        "legal_liability_established": {"const": false},
        "legal_effect_established": {"const": false},
        "moral_blame_assigned": {"const": false},
        "moral_correctness_established": {"const": false},
        "truth_certified": {"const": false},
        "successor_append_may_proceed": {"const": false},
        "successor_append_executed": {"const": false},
        "global_replay_protection_established": {"const": false},
        "distributed_consensus_established": {"const": false},
        "poai_materialization_event_recorded": {"const": false},
        "universal_canonicality_established": {"const": false}
      }
    }
  }
}
