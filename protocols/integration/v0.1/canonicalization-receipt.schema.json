{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/protocols/integration/v0.1/canonicalization-receipt.schema.json",
  "title": "UU-AAP CanonicalizationReceipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "receipt_id",
    "evaluated_at",
    "observation_receipt_ref",
    "lineage",
    "policy",
    "recognized_state",
    "contest_or_stay",
    "conflict_state",
    "verification",
    "canonicality_claim",
    "poai_adapter_boundary",
    "claims"
  ],
  "properties": {
    "$schema": {"const": "./canonicalization-receipt.schema.json"},
    "artifact_type": {"const": "CanonicalizationReceipt"},
    "artifact_version": {"const": "0.1"},
    "receipt_id": {"type": "string", "pattern": "^urn:uu-aap:canonicalization-receipt:"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "observation_receipt_ref": {"type": "string", "pattern": "^urn:uu-aap:observation-receipt:"},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_receipt_ref",
        "commit_decision_ref",
        "decision_input_ref",
        "authority_verification_ref",
        "pre_materialization_ref"
      ],
      "properties": {
        "commit_receipt_ref": {"type": "string", "pattern": "^urn:uu-aap:commit-receipt:"},
        "commit_decision_ref": {"type": "string", "pattern": "^urn:uu-aap:commit-decision:"},
        "decision_input_ref": {"type": "string", "minLength": 1},
        "authority_verification_ref": {"type": "string", "pattern": "^urn:poai:authority-verification:"},
        "pre_materialization_ref": {"type": "string", "pattern": "^urn:poai-ccrp:pre-materialization:"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "canonicality_scope", "digest"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^urn:uu-aap:canonicalization-policy:"},
        "policy_version": {"type": "integer", "minimum": 1},
        "canonicality_scope": {"type": "string", "pattern": "^urn:uu-aap:canonicality-scope:"},
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonicalization", "digest_algorithm", "digest_encoding", "value"],
          "properties": {
            "canonicalization": {"const": "RFC8785-JCS"},
            "digest_algorithm": {"const": "SHA-256"},
            "digest_encoding": {"const": "hex"},
            "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "recognized_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "action",
        "operation_ref",
        "responsible_party_id",
        "executor_implementation_id",
        "revision",
        "commit_sha",
        "tree_sha",
        "changed_paths",
        "changed_path_count"
      ],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "operation_ref": {"type": "string", "pattern": "^urn:ccrp:operation:"},
        "responsible_party_id": {"type": "string", "minLength": 1},
        "executor_implementation_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "changed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "changed_path_count": {"type": "integer", "minimum": 1}
      }
    },
    "contest_or_stay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_stay", "refs"],
      "properties": {
        "active_stay": {"const": false},
        "refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "conflict_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "candidate_revisions"],
      "properties": {
        "status": {"const": "none"},
        "candidate_revisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_predecessor_accepted",
        "canonicalization_after_observation",
        "observation_matches_commit_receipt",
        "commit_lineage_exact",
        "decision_lineage_exact",
        "decision_input_lineage_exact",
        "semantic_binding_exact",
        "successor_binding_exact",
        "authority_input_exact",
        "pre_materialization_input_exact",
        "policy_identity_exact",
        "policy_digest_exact",
        "policy_scope_exact",
        "policy_time_active",
        "no_active_stay",
        "single_head_conflict_rule_satisfied",
        "poai_adapter_boundary_preserved"
      ],
      "properties": {
        "observation_predecessor_accepted": {"const": true},
        "canonicalization_after_observation": {"const": true},
        "observation_matches_commit_receipt": {"const": true},
        "commit_lineage_exact": {"const": true},
        "decision_lineage_exact": {"const": true},
        "decision_input_lineage_exact": {"const": true},
        "semantic_binding_exact": {"const": true},
        "successor_binding_exact": {"const": true},
        "authority_input_exact": {"const": true},
        "pre_materialization_input_exact": {"const": true},
        "policy_identity_exact": {"const": true},
        "policy_digest_exact": {"const": true},
        "policy_scope_exact": {"const": true},
        "policy_time_active": {"const": true},
        "no_active_stay": {"const": true},
        "single_head_conflict_rule_satisfied": {"const": true},
        "poai_adapter_boundary_preserved": {"const": true}
      }
    },
    "canonicality_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope", "policy_ref", "canonicalization_receipt_ref"],
      "properties": {
        "status": {"const": "recognized"},
        "scope": {"type": "string", "pattern": "^urn:uu-aap:canonicality-scope:"},
        "policy_ref": {"type": "string", "pattern": "^urn:uu-aap:canonicalization-policy:"},
        "canonicalization_receipt_ref": {"type": "string", "pattern": "^urn:uu-aap:canonicalization-receipt:"}
      }
    },
    "poai_adapter_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_git_successor_is_poai_successor_record",
        "typed_poai_successor_adapter_present",
        "poai_materialization_equivalence_inferred"
      ],
      "properties": {
        "observed_git_successor_is_poai_successor_record": {"const": false},
        "typed_poai_successor_adapter_present": {"const": false},
        "poai_materialization_equivalence_inferred": {"const": false}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_predecessor_accepted",
        "execution_lineage_exact",
        "authority_input_preserved",
        "pre_materialization_permission_input_preserved",
        "policy_evaluation_passed",
        "policy_relative_canonicality_established",
        "remote_branch_or_ref_canonicality_established",
        "poai_materialization_event_recorded",
        "poai_successor_record_identity_inferred",
        "universal_canonicality_established",
        "truth_certified",
        "causal_proof_certified",
        "legal_responsibility_determined",
        "legal_effect_established",
        "moral_correctness_established",
        "poai_v_conformance_established"
      ],
      "properties": {
        "observation_predecessor_accepted": {"const": true},
        "execution_lineage_exact": {"const": true},
        "authority_input_preserved": {"const": true},
        "pre_materialization_permission_input_preserved": {"const": true},
        "policy_evaluation_passed": {"const": true},
        "policy_relative_canonicality_established": {"const": true},
        "remote_branch_or_ref_canonicality_established": {"const": false},
        "poai_materialization_event_recorded": {"const": false},
        "poai_successor_record_identity_inferred": {"const": false},
        "universal_canonicality_established": {"const": false},
        "truth_certified": {"const": false},
        "causal_proof_certified": {"const": false},
        "legal_responsibility_determined": {"const": false},
        "legal_effect_established": {"const": false},
        "moral_correctness_established": {"const": false},
        "poai_v_conformance_established": {"const": false}
      }
    }
  }
}
