{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.example/protocols/integration/ai-gateway/v0.1/capability-manifest.schema.json",
  "title": "UU-AAP AI Gateway Capability Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "artifact_type",
    "operations",
    "effect_classes",
    "provider_neutral",
    "external_actuator_required",
    "content_hash"
  ],
  "properties": {
    "protocol": {"const": "UU-AAP-AI-GATEWAY"},
    "version": {"const": "0.1"},
    "artifact_type": {"const": "GatewayCapabilityManifest"},
    "operations": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["inspect", "qualify", "authorize", "observe"]}
    },
    "effect_classes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["read_only", "external_effect"]}
    },
    "provider_neutral": {"const": true},
    "external_actuator_required": {"const": false},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
