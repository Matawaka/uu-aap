{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:rerc:suppression-compression-receipt:0.1",
  "title": "RERC Suppression Compression Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type","version","request_id","source_graph_id","source_graph_digest","operational_graph_digest","source_edge_order","suppressed_edge_ids","suppressed_edges","retained_edge_ids","classes_touched","reversible","exact_restore_verified","claims"],
  "properties": {
    "artifact_type": {"const": "RERCSuppressionCompressionReceipt"},
    "version": {"const": "0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "source_graph_id": {"type": "string", "minLength": 1},
    "source_graph_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operational_graph_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_edge_order": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "suppressed_edge_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "suppressed_edges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["edge_id","from","to","relation_type","redundancy_class","redundancy_group","evidence_refs","ontological_status"],
        "properties": {
          "edge_id": {"type": "string", "minLength": 1},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "relation_type": {"type": "string", "minLength": 1},
          "redundancy_class": {"enum": ["REPRESENTATIONAL","CAUSAL","EVIDENTIARY","COORDINATION","PROTECTIVE"]},
          "redundancy_group": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "ontological_status": {"const": "OBSERVED_RELATION"}
        }
      }
    },
    "retained_edge_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "classes_touched": {"type": "array", "uniqueItems": true, "items": {"enum": ["REPRESENTATIONAL","CAUSAL","EVIDENTIARY","COORDINATION"]}},
    "reversible": {"const": true},
    "exact_restore_verified": {"const": true},
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["suppression_is_ontological_deletion","evidence_destroyed","relation_invalidated","authority_created","inference_promoted_to_fact","protective_redundancy_suppressed","permanent_discard_authorized","redundancy_group_is_equivalence_proof"],
      "properties": {
        "suppression_is_ontological_deletion": {"const": false},
        "evidence_destroyed": {"const": false},
        "relation_invalidated": {"const": false},
        "authority_created": {"const": false},
        "inference_promoted_to_fact": {"const": false},
        "protective_redundancy_suppressed": {"const": false},
        "permanent_discard_authorized": {"const": false},
        "redundancy_group_is_equivalence_proof": {"const": false}
      }
    }
  }
}
