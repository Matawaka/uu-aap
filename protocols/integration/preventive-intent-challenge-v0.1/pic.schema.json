{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:schema:preventive-intent-challenge:v0.1",
  "title": "Preventive Intent Challenge v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type","artifact_version","baseline","drift_window","challenge","response","assessment","claims"],
  "properties": {
    "artifact_type": {"const": "PreventiveIntentChallenge"},
    "artifact_version": {"const": "0.1"},
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["intent_ref","observed_at"],
      "properties": {"intent_ref":{"type":"string","minLength":1},"observed_at":{"type":"string","format":"date-time"}}
    },
    "drift_window": {
      "type":"object","additionalProperties":false,
      "required":["starts_at","ends_at","bounded","indicators"],
      "properties": {
        "starts_at":{"type":"string","format":"date-time"},
        "ends_at":{"type":"string","format":"date-time"},
        "bounded":{"const":true},
        "indicators":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1},"uniqueItems":true}
      }
    },
    "challenge": {
      "type":"object","additionalProperties":false,
      "required":["challenge_id","text_origin","provenance_ref","leading","presented","intent_evidence_weight"],
      "properties": {
        "challenge_id":{"type":"string","minLength":1},
        "text_origin":{"enum":["system","human","mixed"]},
        "provenance_ref":{"type":"string","minLength":1},
        "leading":{"const":false},
        "presented":{"const":true},
        "intent_evidence_weight":{"const":0}
      }
    },
    "response": {
      "type":"object","additionalProperties":false,
      "required":["state","fresh_confirmation","silence_is_refusal","delay_is_intentional_delay","prior_approval_carried_forward"],
      "properties": {
        "state":{"enum":["responded","no_response","deferred"]},
        "fresh_confirmation":{"type":"boolean"},
        "silence_is_refusal":{"const":false},
        "delay_is_intentional_delay":{"const":false},
        "prior_approval_carried_forward":{"const":false}
      }
    },
    "assessment": {
      "type":"object","additionalProperties":false,
      "required":["scope","disposition","automatic_block","sanction_recommended","authority_expanded"],
      "properties": {
        "scope":{"type":"string","minLength":1},
        "disposition":{"enum":["no_material_drift","advisory_review","human_gate_required","insufficient_evidence"]},
        "automatic_block":{"const":false},
        "sanction_recommended":{"const":false},
        "authority_expanded":{"const":false}
      }
    },
    "claims": {
      "type":"object","additionalProperties":false,
      "required":["malicious_intent_proven","intent_inferred_from_exposure","responsibility_assigned","liability_established","action_executed","permissions_revoked","kontur_mutated"],
      "properties": {
        "malicious_intent_proven":{"const":false},
        "intent_inferred_from_exposure":{"const":false},
        "responsibility_assigned":{"const":false},
        "liability_established":{"const":false},
        "action_executed":{"const":false},
        "permissions_revoked":{"const":false},
        "kontur_mutated":{"const":false}
      }
    }
  }
}
