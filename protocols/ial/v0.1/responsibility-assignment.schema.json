{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/protocols/ial/v0.1/responsibility-assignment.schema.json",
  "title": "IAL ResponsibilityAssignment v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "assignment_id",
    "assessment_id",
    "responsible_party_id",
    "responsibility_scope",
    "assignment_kind",
    "claims"
  ],
  "properties": {
    "$schema": {"const": "../responsibility-assignment.schema.json"},
    "artifact_type": {"const": "ResponsibilityAssignment"},
    "artifact_version": {"const": "0.1"},
    "assignment_id": {"type": "string", "minLength": 1},
    "assessment_id": {"type": "string", "minLength": 1},
    "responsible_party_id": {"type": "string", "minLength": 1},
    "responsibility_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "assignment_kind": {"enum": ["current_owner", "accepted_handoff"]},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsibility_assignment_recorded",
        "legal_authority_established",
        "execution_admitted",
        "materialization_permitted",
        "outcome_observed"
      ],
      "properties": {
        "responsibility_assignment_recorded": {"const": true},
        "legal_authority_established": {"const": false},
        "execution_admitted": {"const": false},
        "materialization_permitted": {"const": false},
        "outcome_observed": {"const": false}
      }
    }
  }
}