{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/protocols/ial/v0.1/responsibility-handoff-result.schema.json",
  "title": "IAL ResponsibilityHandoffResult v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "assessment_id",
    "offer_id",
    "acceptance_id",
    "status",
    "reason_codes",
    "assignment_after_handoff",
    "claims"
  ],
  "properties": {
    "$schema": {"const": "./responsibility-handoff-result.schema.json"},
    "artifact_type": {"const": "ResponsibilityHandoffResult"},
    "artifact_version": {"const": "0.1"},
    "assessment_id": {"type": "string", "minLength": 1},
    "offer_id": {"type": ["string", "null"]},
    "acceptance_id": {"type": ["string", "null"]},
    "status": {"enum": ["not_required", "accepted", "rejected", "blocked"]},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "assignment_after_handoff": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["responsible_party_id", "responsibility_scope", "basis"],
          "properties": {
            "responsible_party_id": {"type": "string", "minLength": 1},
            "responsibility_scope": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "basis": {"const": "explicit_handoff_acceptance"}
          }
        }
      ]
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_assessed",
        "responsibility_boundary_required",
        "capability_attestation_verified",
        "responsibility_transfer_established",
        "responsibility_accepted",
        "authority_established",
        "context_admission_established",
        "execution_admitted",
        "materialization_permitted",
        "commit_performed",
        "outcome_observed",
        "canonical_state_established",
        "poai_v_conformance_established"
      ],
      "properties": {
        "boundary_assessed": {"const": true},
        "responsibility_boundary_required": {"type": "boolean"},
        "capability_attestation_verified": {"type": "boolean"},
        "responsibility_transfer_established": {"type": "boolean"},
        "responsibility_accepted": {"type": "boolean"},
        "authority_established": {"const": false},
        "context_admission_established": {"const": false},
        "execution_admitted": {"const": false},
        "materialization_permitted": {"const": false},
        "commit_performed": {"const": false},
        "outcome_observed": {"const": false},
        "canonical_state_established": {"const": false},
        "poai_v_conformance_established": {"const": false}
      }
    }
  }
}