{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/protocols/ial/v0.1/responsibility-handoff-offer.schema.json",
  "title": "IAL ResponsibilityHandoffOffer v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "offer_id",
    "boundary_assessment_id",
    "elevation_receipt_id",
    "responsibility_assignment_id",
    "source_responsible_party_id",
    "receiving_party_id",
    "executor_implementation_id",
    "effect_ref",
    "responsibility_scope",
    "required_capability",
    "attestation_policy",
    "claims"
  ],
  "properties": {
    "$schema": {"const": "../responsibility-handoff-offer.schema.json"},
    "artifact_type": {"const": "ResponsibilityHandoffOffer"},
    "artifact_version": {"const": "0.1"},
    "offer_id": {"type": "string", "minLength": 1},
    "boundary_assessment_id": {"type": "string", "minLength": 1},
    "elevation_receipt_id": {"type": "string", "minLength": 1},
    "responsibility_assignment_id": {"type": "string", "minLength": 1},
    "source_responsible_party_id": {"type": "string", "minLength": 1},
    "receiving_party_id": {"type": "string", "minLength": 1},
    "executor_implementation_id": {"type": "string", "minLength": 1},
    "effect_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "action", "target"],
      "properties": {
        "intent_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1}
      }
    },
    "responsibility_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_id",
        "protocol_id",
        "version",
        "logical_uri",
        "release_commit",
        "required_conformance_levels"
      ],
      "properties": {
        "registry_id": {"const": "urn:uu-aap:protocol-registry:v0.1"},
        "protocol_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "logical_uri": {"type": "string", "minLength": 1},
        "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "required_conformance_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "attestation_policy": {"const": "reproducible_attestation_required"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsibility_offered",
        "responsibility_accepted",
        "technical_capability_is_responsibility_acceptance",
        "authority_established",
        "execution_admitted",
        "materialization_permitted",
        "outcome_observed"
      ],
      "properties": {
        "responsibility_offered": {"const": true},
        "responsibility_accepted": {"const": false},
        "technical_capability_is_responsibility_acceptance": {"const": false},
        "authority_established": {"const": false},
        "execution_admitted": {"const": false},
        "materialization_permitted": {"const": false},
        "outcome_observed": {"const": false}
      }
    }
  }
}