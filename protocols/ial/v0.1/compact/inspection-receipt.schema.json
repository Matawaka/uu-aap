{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/protocols/ial/v0.1/compact/inspection-receipt.schema.json",
  "title": "IAL Compact Inspection Receipt v0.1",
  "description": "Deterministic read-only inspection result for one validated IAL Compact Envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "receipt_type",
    "cli_profile",
    "envelope_id",
    "envelope_hash",
    "frontier",
    "consumer_product_id",
    "status",
    "elevation_level",
    "reason_codes",
    "requirements",
    "claims",
    "non_effects"
  ],
  "properties": {
    "protocol": { "const": "IAL" },
    "version": { "const": "0.1" },
    "receipt_type": { "const": "IALCompactInspectionReceipt" },
    "cli_profile": { "const": "parse_validate_inspect_only" },
    "envelope_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$" },
    "envelope_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "observed_at"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "consumer_product_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "status": { "enum": ["IAL_NOT_REQUIRED", "ELEVATED"] },
    "elevation_level": { "enum": ["E0", "E1", "E2", "E3"] },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,95}$" }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_handoff_chain_required",
        "explicit_responsibility_acceptance_required",
        "downstream_action_gate_required",
        "materialization_permission_required",
        "observation_required_after_attempt"
      ],
      "properties": {
        "full_handoff_chain_required": { "type": "boolean" },
        "explicit_responsibility_acceptance_required": { "type": "boolean" },
        "downstream_action_gate_required": { "type": "boolean" },
        "materialization_permission_required": { "type": "boolean" },
        "observation_required_after_attempt": { "type": "boolean" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "syntax_parsed",
        "schema_shape_valid",
        "semantic_consistency_valid",
        "consumer_contract_binding_present",
        "responsibility_boundary_required",
        "responsibility_handoff_requested",
        "materialization_candidate",
        "responsibility_accepted",
        "authority_established",
        "action_permit_established",
        "execution_admitted",
        "materialization_permitted",
        "external_effect_observed",
        "canonical_state_established"
      ],
      "properties": {
        "syntax_parsed": { "const": true },
        "schema_shape_valid": { "const": true },
        "semantic_consistency_valid": { "const": true },
        "consumer_contract_binding_present": { "const": true },
        "responsibility_boundary_required": { "type": "boolean" },
        "responsibility_handoff_requested": { "type": "boolean" },
        "materialization_candidate": { "type": "boolean" },
        "responsibility_accepted": { "const": false },
        "authority_established": { "const": false },
        "action_permit_established": { "const": false },
        "execution_admitted": { "const": false },
        "materialization_permitted": { "const": false },
        "external_effect_observed": { "const": false },
        "canonical_state_established": { "const": false }
      }
    },
    "non_effects": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "elevation_level": { "const": "E0" } } },
      "then": {
        "properties": {
          "status": { "const": "IAL_NOT_REQUIRED" },
          "requirements": {
            "properties": {
              "full_handoff_chain_required": { "const": false },
              "explicit_responsibility_acceptance_required": { "const": false },
              "downstream_action_gate_required": { "const": false },
              "materialization_permission_required": { "const": false },
              "observation_required_after_attempt": { "const": false }
            }
          },
          "claims": {
            "properties": {
              "responsibility_boundary_required": { "const": false },
              "responsibility_handoff_requested": { "const": false },
              "materialization_candidate": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "elevation_level": { "const": "E1" } } },
      "then": {
        "properties": {
          "status": { "const": "ELEVATED" },
          "requirements": {
            "properties": {
              "full_handoff_chain_required": { "const": false },
              "explicit_responsibility_acceptance_required": { "const": false },
              "downstream_action_gate_required": { "const": true },
              "materialization_permission_required": { "const": false },
              "observation_required_after_attempt": { "const": true }
            }
          },
          "claims": {
            "properties": {
              "responsibility_boundary_required": { "const": true },
              "responsibility_handoff_requested": { "const": false },
              "materialization_candidate": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "elevation_level": { "const": "E2" } } },
      "then": {
        "properties": {
          "status": { "const": "ELEVATED" },
          "requirements": {
            "properties": {
              "full_handoff_chain_required": { "const": true },
              "explicit_responsibility_acceptance_required": { "const": true },
              "downstream_action_gate_required": { "const": true },
              "materialization_permission_required": { "const": false },
              "observation_required_after_attempt": { "const": true }
            }
          },
          "claims": {
            "properties": {
              "responsibility_boundary_required": { "const": true },
              "responsibility_handoff_requested": { "const": true },
              "materialization_candidate": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "elevation_level": { "const": "E3" } } },
      "then": {
        "properties": {
          "status": { "const": "ELEVATED" },
          "requirements": {
            "properties": {
              "downstream_action_gate_required": { "const": true },
              "materialization_permission_required": { "const": true },
              "observation_required_after_attempt": { "const": true }
            }
          },
          "claims": {
            "properties": {
              "responsibility_boundary_required": { "const": true },
              "materialization_candidate": { "const": true }
            }
          }
        }
      }
    }
  ]
}
