{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.example/protocols/core/evolution/v0.1/successor-manifest.schema.json",
  "title": "UU-AAP SuccessorManifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "artifact_type",
    "predecessor",
    "successor",
    "compatibility_class",
    "change_scope",
    "preserved_invariants",
    "migration",
    "deprecations",
    "major_version_required",
    "rationale",
    "conformance",
    "independence",
    "issued_at",
    "content_hash"
  ],
  "properties": {
    "protocol": {"const": "UU-AAP-STACK-EVOLUTION"},
    "version": {"const": "0.1"},
    "artifact_type": {"const": "SuccessorManifest"},
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "canonical_commit", "compatibility_surface"],
      "properties": {
        "protocol": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "canonical_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "compatibility_surface": {"type": "string", "minLength": 1}
      }
    },
    "successor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "synthetic"],
      "properties": {
        "protocol": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "synthetic": {"type": "boolean"}
      }
    },
    "compatibility_class": {
      "enum": [
        "fully_compatible",
        "adapter_compatible",
        "semantically_compatible_syntax_breaking",
        "breaking",
        "historical_only"
      ]
    },
    "change_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "representation_only",
          "field_addition",
          "field_deprecation",
          "semantic_refinement",
          "failure_semantics",
          "authority_responsibility_semantics",
          "layer_topology"
        ]
      }
    },
    "preserved_invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "refreshes_frontier",
        "reinterprets_historical_receipts",
        "requires_reobservation_for_freshness"
      ],
      "properties": {
        "mode": {"enum": ["direct", "explicit_adapter", "reobserve_rebind", "historical_only"]},
        "refreshes_frontier": {"const": false},
        "reinterprets_historical_receipts": {"const": false},
        "requires_reobservation_for_freshness": {"const": true}
      }
    },
    "deprecations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "historical_meaning_preserved", "successor_or_reason"],
        "properties": {
          "identifier": {"type": "string", "minLength": 1},
          "historical_meaning_preserved": {"const": true},
          "successor_or_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "major_version_required": {"type": "boolean"},
    "rationale": {"type": "string", "minLength": 1},
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive_fixture_required",
        "negative_fixture_required",
        "cross_version_compatibility_vectors_required",
        "action_gate_bypass_vectors_required",
        "historical_non_reinterpretation_vectors_required"
      ],
      "properties": {
        "positive_fixture_required": {"const": true},
        "negative_fixture_required": {"const": true},
        "cross_version_compatibility_vectors_required": {"const": true},
        "action_gate_bypass_vectors_required": {"const": true},
        "historical_non_reinterpretation_vectors_required": {"const": true}
      }
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_contour_required", "runtime_vendor_required", "kontur_required"],
      "properties": {
        "external_contour_required": {"const": false},
        "runtime_vendor_required": {"const": false},
        "kontur_required": {"const": false}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}