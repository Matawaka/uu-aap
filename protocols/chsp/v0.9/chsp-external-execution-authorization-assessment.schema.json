    "v08_envelope_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"v08_dry_run_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"v08_dry_run_assessment_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"execution_recheck_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"authorization_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"revocation_set_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
