    "metrics":{"type":"object","additionalProperties":false,"required":["authorizer_count","authorizer_domains","recheck_age_seconds","authorization_expired","revocation_count"],"properties":{"authorizer_count":{"type":"integer","minimum":0},"authorizer_domains":{"type":"integer","minimum":0},"recheck_age_seconds":{"type":"integer","minimum":0},"authorization_expired":{"type":"boolean"},"revocation_count":{"type":"integer","minimum":0}}},
