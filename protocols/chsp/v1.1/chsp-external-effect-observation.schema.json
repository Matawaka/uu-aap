  "properties":{"artifact_type":{"const":"CHSPExternalEffectObservation"},"artifact_version":{"const":"1.1"},"observation_id":{"type":"string","minLength":1},"project_id":{"type":"string","minLength":1},"steward_id":{"type":"string","minLength":1},"v10_execution_receipt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"v10_execution_assessment_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"observer_id":{"type":"string","minLength":1},"observer_domain_id":{"type":"string","minLength":1},"observed_at":{"type":"string","format":"date-time"},"observed_role":{"type":"string","minLength":1},"expected_role":{"type":"string","minLength":1},"result":{"enum":["support","drift","indeterminate"]},"evidence_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"contains_credentials":{"const":false},"observation_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"claims":{"type":"object","additionalProperties":false,"required":["post_effect_observation_recorded","external_effect_stabilized","global_provider_state_proven","ownership_proven","credentials_present"],"properties":{"post_effect_observation_recorded":{"const":true},"external_effect_stabilized":{"const":false},"global_provider_state_proven":{"const":false},"ownership_proven":{"const":false},"credentials_present":{"const":false}}}}
