    "metrics":{"type":"object","additionalProperties":false,"required":["recognizer_count","recognizer_domains","transition_authorizer_count","transition_authorizer_domains","recognition_expired","authorization_expired","revocation_count"],"properties":{"recognizer_count":{"type":"integer","minimum":0},"recognizer_domains":{"type":"integer","minimum":0},"transition_authorizer_count":{"type":"integer","minimum":0},"transition_authorizer_domains":{"type":"integer","minimum":0},"recognition_expired":{"type":"boolean"},"authorization_expired":{"type":"boolean"},"revocation_count":{"type":"integer","minimum":0}}},
