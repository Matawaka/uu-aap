    "v06_binding_proposal_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"v06_binding_assessment_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"recognition_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"authorization_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"revocation_set_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
