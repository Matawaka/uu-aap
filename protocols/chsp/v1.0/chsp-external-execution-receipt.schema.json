    "v08_envelope_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"v09_execution_authorization_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"v09_execution_authorization_assessment_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"execution_request_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
