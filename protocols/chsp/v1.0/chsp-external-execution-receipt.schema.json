{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://uu-aap.example/schema/chsp-external-execution-receipt-v1.0.json",
  "title":"CHSPExternalExecutionReceipt v1.0",
  "type":"object","additionalProperties":false,
