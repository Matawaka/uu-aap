{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.example/schema/chsp-delegation-v0.1.json",
  "title": "CHSPDelegation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "artifact_version", "delegation_id", "project_id", "candidate_id",
    "granted_by_id", "granted_at", "starts_at", "expires_at", "delegation_level", "scopes",
    "reversible", "status", "outcome", "delegation_sha256", "claims"
  ],
  "properties": {
    "artifact_type": {"const": "CHSPDelegation"},
    "artifact_version": {"const": "0.1"},
    "delegation_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "granted_by_id": {"type": "string", "minLength": 1},
    "granted_at": {"type": "string", "format": "date-time"},
    "starts_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "delegation_level": {"enum": ["advisory", "reversible_limited", "supervised_stewardship"]},
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "advisory_review", "propose_change", "review_change", "prepare_artifact",
          "supervised_maintenance", "document_rationale"
        ]
      }
    },
    "reversible": {"const": true},
    "status": {"enum": ["active", "completed", "revoked", "expired"]},
    "outcome": {"enum": ["pending", "successful", "adverse", "not_evaluated"]},
    "completion_evidence_sha256": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "delegation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounded_delegation_recorded", "canonical_authority_granted", "canonical_successor_established",
        "ownership_transferred", "kontur_activated", "appeal_path_removed"
      ],
      "properties": {
        "bounded_delegation_recorded": {"const": true},
        "canonical_authority_granted": {"const": false},
        "canonical_successor_established": {"const": false},
        "ownership_transferred": {"const": false},
        "kontur_activated": {"const": false},
        "appeal_path_removed": {"const": false}
      }
    }
  }
}
