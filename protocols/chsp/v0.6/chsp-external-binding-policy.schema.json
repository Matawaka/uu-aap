{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.example/schema/chsp-external-binding-policy-v0.6.json",
  "title": "CHSPExternalBindingPolicy v0.6",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type","artifact_version","project_id","minimum_supporting_attestations","minimum_observer_domains","minimum_evidence_classes","maximum_observation_age_days","strong_possession_classes","allowed_external_system_types","allowed_claimed_roles","requirements","claims"],
  "properties": {
    "artifact_type": {"const": "CHSPExternalBindingPolicy"},
    "artifact_version": {"const": "0.6"},
    "project_id": {"type": "string", "minLength": 1},
    "minimum_supporting_attestations": {"type": "integer", "minimum": 1},
    "minimum_observer_domains": {"type": "integer", "minimum": 1},
    "minimum_evidence_classes": {"type": "integer", "minimum": 1},
    "maximum_observation_age_days": {"type": "integer", "minimum": 1},
    "strong_possession_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["challenge_response","signature_verification"]}},
    "allowed_external_system_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["github_repository","git_host_repository","signing_identity","generic_control_plane"]}},
    "allowed_claimed_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["identity_only","collaborator","maintainer","admin","owner","release_signer"]}},
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["v05_stewardship_state_required","v05_execution_receipt_required","claim_bound_to_exact_stewardship_state","attestation_evidence_digest_required","attestor_domain_declared","contradiction_blocks","strong_possession_required","automatic_external_transition","automatic_ownership_transfer","automatic_canonical_origin_mutation","automatic_kontur_activation"],
      "properties": {
        "v05_stewardship_state_required": {"const": true},
        "v05_execution_receipt_required": {"const": true},
        "claim_bound_to_exact_stewardship_state": {"const": true},
        "attestation_evidence_digest_required": {"const": true},
        "attestor_domain_declared": {"const": true},
        "contradiction_blocks": {"const": true},
        "strong_possession_required": {"const": true},
        "automatic_external_transition": {"const": false},
        "automatic_ownership_transfer": {"const": false},
        "automatic_canonical_origin_mutation": {"const": false},
        "automatic_kontur_activation": {"const": false}
      }
    },
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["descriptive_policy_only","external_binding_established","domain_independence_proven","repository_ownership_transferred","account_control_transferred","canonical_origin_mutated","canonical_publication_executed","kontur_activated","legal_ownership_adjudicated","universal_identity_proven","distributed_consensus_established"],
      "properties": {
        "descriptive_policy_only": {"const": true},
        "external_binding_established": {"const": false},
        "domain_independence_proven": {"const": false},
        "repository_ownership_transferred": {"const": false},
        "account_control_transferred": {"const": false},
        "canonical_origin_mutated": {"const": false},
        "canonical_publication_executed": {"const": false},
        "kontur_activated": {"const": false},
        "legal_ownership_adjudicated": {"const": false},
        "universal_identity_proven": {"const": false},
        "distributed_consensus_established": {"const": false}
      }
    }
  }
}
