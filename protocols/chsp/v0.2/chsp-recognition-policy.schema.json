{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.example/schema/chsp-recognition-policy-v0.2.json",
  "title": "CHSPRecognitionPolicy v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_version", "project_id", "minimum_cooling_days", "minimum_challenge_window_days", "minimum_stage_observation_days", "maximum_envelope_days", "stage_order", "stage_scopes", "higher_stage_independent_authorizer_from", "requirements", "claims"],
  "properties": {
    "artifact_type": {"const": "CHSPRecognitionPolicy"},
    "artifact_version": {"const": "0.2"},
    "project_id": {"type": "string", "minLength": 1},
    "minimum_cooling_days": {"type": "integer", "minimum": 1},
    "minimum_challenge_window_days": {"type": "integer", "minimum": 1},
    "minimum_stage_observation_days": {"type": "integer", "minimum": 1},
    "maximum_envelope_days": {"type": "integer", "minimum": 1},
    "stage_order": {
      "const": ["A1_advisory", "A2_reversible_limited", "A3_supervised_stewardship", "A4_canonical_preparation"]
    },
    "stage_scopes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A1_advisory", "A2_reversible_limited", "A3_supervised_stewardship", "A4_canonical_preparation"],
      "properties": {
        "A1_advisory": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["advisory_review", "issue_triage", "documentation"]}},
        "A2_reversible_limited": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["proposal_preparation", "noncanonical_test_maintenance", "metadata_preparation"]}},
        "A3_supervised_stewardship": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["supervised_release_preparation", "supervised_policy_draft", "supervised_incident_coordination"]}},
        "A4_canonical_preparation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["canonical_publication_preparation", "succession_package_preparation"]}}
      }
    },
    "higher_stage_independent_authorizer_from": {"const": "A3_supervised_stewardship"},
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v01_succession_eligibility_required", "recognizer_distinct_from_candidate", "recognizer_evidence_digest_required", "typed_confirmation_required", "cooling_period_required", "challenge_window_required", "open_or_upheld_challenge_blocks_progression", "candidate_cannot_self_authorize", "stage_progression_must_be_sequential", "completed_positive_predecessor_required", "envelope_must_expire", "envelope_must_be_revocable", "automatic_authority_progression", "automatic_canonical_recognition"],
      "properties": {
        "v01_succession_eligibility_required": {"const": true},
        "recognizer_distinct_from_candidate": {"const": true},
        "recognizer_evidence_digest_required": {"const": true},
        "typed_confirmation_required": {"const": true},
        "cooling_period_required": {"const": true},
        "challenge_window_required": {"const": true},
        "open_or_upheld_challenge_blocks_progression": {"const": true},
        "candidate_cannot_self_authorize": {"const": true},
        "stage_progression_must_be_sequential": {"const": true},
        "completed_positive_predecessor_required": {"const": true},
        "envelope_must_expire": {"const": true},
        "envelope_must_be_revocable": {"const": true},
        "automatic_authority_progression": {"const": false},
        "automatic_canonical_recognition": {"const": false}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptive_policy_only", "canonical_successor_established", "canonical_publication_authorized", "ownership_transferred", "kontur_activated", "universal_trust_established"],
      "properties": {
        "descriptive_policy_only": {"const": true},
        "canonical_successor_established": {"const": false},
        "canonical_publication_authorized": {"const": false},
        "ownership_transferred": {"const": false},
        "kontur_activated": {"const": false},
        "universal_trust_established": {"const": false}
      }
    }
  }
}
