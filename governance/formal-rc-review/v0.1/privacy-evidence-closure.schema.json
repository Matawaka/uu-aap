{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","receipt_type","origin_frontier","evidence_refs","claims","limitations","governance_state","non_effects"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "receipt_type":{"const":"PrivacyGovernanceEvidenceClosure"},
    "origin_frontier":{"type":"string","minLength":40},
    "evidence_refs":{"type":"array","minItems":2,"items":{"type":"string"}},
    "claims":{"type":"object"},
    "limitations":{"type":"array","minItems":1,"items":{"type":"string"}},
    "governance_state":{"const":"PASS_BOUNDED_REPOSITORY_EVIDENCE"},
    "non_effects":{"type":"object"}
  }
}
