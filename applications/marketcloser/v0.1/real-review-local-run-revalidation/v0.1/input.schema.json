{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.example/applications/marketcloser/v0.1/real-review-local-run-revalidation/v0.1/input.schema.json",
  "title": "MarketCloserRealReviewLocalRunRevalidationInput v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol","version","artifact_type","revalidation_id","origin","materialization_source","permit","observed_frontier","revalidated_at","controls","content_hash"],
  "properties": {
    "protocol": {"const": "MARKETCLOSER-REAL-REVIEW-LOCAL-RUN-REVALIDATION"},
    "version": {"const": "0.1"},
    "artifact_type": {"const": "MarketCloserRealReviewLocalRunRevalidationInput"},
    "revalidation_id": {"type": "string", "pattern": "^urn:uu-aap:marketcloser:real-review-local-run-revalidation:[a-z0-9][a-z0-9:-]{2,191}$"},
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["repository","revision","tree"],
      "properties": {
        "repository": {"const": "Matawaka/uu-aap"},
        "revision": {"const": "72f6ea7185b75ecf6ca459c8f88c8c613f3ae968"},
        "tree": {"const": "4610936795b5726eb074d4b0431e6d5b919e0d13"}
      }
    },
    "materialization_source": {
      "type": "object", "additionalProperties": false,
      "required": ["mode","path","expected_materialization_input_hash"],
      "properties": {
        "mode": {"enum": ["repository_synthetic","local_private"]},
        "path": {"type": "string", "minLength": 1},
        "expected_materialization_input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "permit": {"type": ["object","null"]},
    "observed_frontier": {
      "type": "object", "additionalProperties": false,
      "required": ["repository","revision","tree","observed_at"],
      "properties": {
        "repository": {"const": "Matawaka/uu-aap"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "revalidated_at": {"type": "string", "format": "date-time"},
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["local_only","read_only","stress_test_run_available","real_stress_test_adapter_available","network_access_available","filesystem_write_available","provider_invocation_available","platform_mutation_available","response_candidate_available","publication_available","pilot_permit_available","action_permit_available","external_execution_available","external_effect_available"],
      "properties": {
        "local_only": {"const": true}, "read_only": {"const": true},
        "stress_test_run_available": {"const": false}, "real_stress_test_adapter_available": {"const": false},
        "network_access_available": {"const": false}, "filesystem_write_available": {"const": false},
        "provider_invocation_available": {"const": false}, "platform_mutation_available": {"const": false},
        "response_candidate_available": {"const": false}, "publication_available": {"const": false},
        "pilot_permit_available": {"const": false}, "action_permit_available": {"const": false},
        "external_execution_available": {"const": false}, "external_effect_available": {"const": false}
      }
    },
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
