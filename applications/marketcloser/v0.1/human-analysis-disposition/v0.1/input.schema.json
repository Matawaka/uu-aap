{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:schema:marketcloser-human-analysis-disposition-input:v0.1",
  "title": "MarketCloserHumanAnalysisDispositionInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol","version","artifact_type","disposition_id","origin","analysis_source","analysis_receipt","decision","decided_at","controls","content_hash"],
  "properties": {
    "protocol": {"const": "MARKETCLOSER-HUMAN-ANALYSIS-DISPOSITION"},
    "version": {"const": "0.1"},
    "artifact_type": {"const": "MarketCloserHumanAnalysisDispositionInput"},
    "disposition_id": {"type":"string","pattern":"^urn:uu-aap:marketcloser:human-analysis-disposition:[a-z0-9][a-z0-9:-]{2,191}$"},
    "origin": {
      "type":"object","additionalProperties":false,
      "required":["repository","revision","tree"],
      "properties": {
        "repository":{"const":"Matawaka/uu-aap"},
        "revision":{"const":"0dd0b5a041590e44ee12a9bbd923025b87497d25"},
        "tree":{"const":"aca7503ad04c47cd7038ea3a22b02c4273073976"}
      }
    },
    "analysis_source": {
      "type":"object","additionalProperties":false,
      "required":["mode","path","expected_adapter_input_hash"],
      "properties": {
        "mode":{"enum":["repository_synthetic","local_private"]},
        "path":{"type":"string","minLength":1},
        "expected_adapter_input_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
      }
    },
    "analysis_receipt": {"type":["object","null"]},
    "decision": {
      "oneOf": [
        {"type":"null"},
        {
          "type":"object","additionalProperties":false,
          "required":["context","value","reviewer_ref","rationale"],
          "properties": {
            "context":{"enum":["synthetic_conformance","human_supplied"]},
            "value":{"enum":["REJECT","CORRECT","REQUEST_MORE_EVIDENCE","ACCEPT_FOR_HUMAN_USE"]},
            "reviewer_ref":{"type":"string","minLength":1},
            "rationale":{"type":"string","minLength":1}
          }
        }
      ]
    },
    "decided_at": {"oneOf":[{"type":"null"},{"type":"string","format":"date-time"}]},
    "controls": {
      "type":"object","additionalProperties":false,
      "required":["local_only","read_only","human_disposition_recording_available","response_candidate_available","publication_available","provider_invocation_available","network_access_available","platform_mutation_available","campaign_send_available","pilot_permit_available","action_permit_available","external_execution_available","external_effect_available"],
      "properties": {
        "local_only":{"const":true},
        "read_only":{"const":true},
        "human_disposition_recording_available":{"const":true},
        "response_candidate_available":{"const":false},
        "publication_available":{"const":false},
        "provider_invocation_available":{"const":false},
        "network_access_available":{"const":false},
        "platform_mutation_available":{"const":false},
        "campaign_send_available":{"const":false},
        "pilot_permit_available":{"const":false},
        "action_permit_available":{"const":false},
        "external_execution_available":{"const":false},
        "external_effect_available":{"const":false}
      }
    },
    "content_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if":{"properties":{"decision":{"type":"null"}},"required":["decision"]},
      "then":{"properties":{"decided_at":{"type":"null"}}}
    },
    {
      "if":{"properties":{"decision":{"type":"object"}},"required":["decision"]},
      "then":{"properties":{"analysis_receipt":{"type":"object"},"decided_at":{"type":"string","format":"date-time"}}}
    }
  ]
}
