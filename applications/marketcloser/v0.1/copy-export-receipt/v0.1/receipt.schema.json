    "non_effects":{"type":"array","minItems":10,"maxItems":10,"uniqueItems":true,"items":{"type":"string"}},
    "next_safe_action":{"enum":["OBTAIN_APPROVED_FOR_COPY_EXPORT","RECORD_COPY_EXPORT_EVENT","PUBLICATION_OBSERVATION_REQUIRED"]},
    "content_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "allOf":[
    {"if":{"properties":{"classification":{"const":"COPIED_PUBLICATION_UNVERIFIED"}}},"then":{"properties":{"copy_export_event_recorded":{"const":true},"copy_export_event_asserts_performed":{"const":true},"next_safe_action":{"const":"PUBLICATION_OBSERVATION_REQUIRED"},"approval_binding":{"properties":{"copy_export_authorized":{"const":true}}},"event_binding":{"properties":{"present":{"const":true}}}}}},
    {"if":{"properties":{"classification":{"const":"COPY_EXPORT_EVENT_REQUIRED"}}},"then":{"properties":{"copy_export_event_recorded":{"const":false},"copy_export_event_asserts_performed":{"const":false},"next_safe_action":{"const":"RECORD_COPY_EXPORT_EVENT"},"approval_binding":{"properties":{"copy_export_authorized":{"const":true}}},"event_binding":{"properties":{"present":{"const":false}}}}}},
    {"if":{"properties":{"classification":{"const":"APPROVAL_REQUIRED"}}},"then":{"properties":{"copy_export_event_recorded":{"const":false},"copy_export_event_asserts_performed":{"const":false},"next_safe_action":{"const":"OBTAIN_APPROVED_FOR_COPY_EXPORT"},"approval_binding":{"properties":{"copy_export_authorized":{"const":false}}},"event_binding":{"properties":{"present":{"const":false}}}}}}
  ]
}
