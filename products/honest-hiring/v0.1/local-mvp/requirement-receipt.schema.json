{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://uu-aap.example/products/honest-hiring/v0.1/local-mvp/requirement-receipt.schema.json",
  "title":"HonestHiringRequirementReceipt v0.1",
  "type":"object","additionalProperties":false,
  "required":["protocol","version","receipt_type","receipt_id","contract_binding","evaluation_frontier","source_input","role","requirements","coverage","claims","non_effects","next_safe_action","content_hash"],
  "properties":{
    "protocol":{"const":"HONEST-HIRING-LOCAL-MVP"},"version":{"const":"0.1"},"receipt_type":{"const":"HonestHiringRequirementReceipt"},
    "receipt_id":{"type":"string","pattern":"^urn:uu-aap:honest-hiring:requirement-receipt:[0-9a-f]{24}$"},
    "contract_binding":{"type":"object","additionalProperties":false,"required":["contract_id","product_id","product_version","content_hash"],"properties":{"contract_id":{"const":"honest-hiring-product-contract"},"product_id":{"const":"honest-hiring"},"product_version":{"const":"0.1"},"content_hash":{"const":"sha256:796580b9a4dc3eb9f7b7bd9215ed1b9379182786caeafbdb15fada4353f1d2ae"}}},
    "evaluation_frontier":{"$ref":"#/$defs/frontier"},
    "source_input":{"$ref":"#/$defs/source"},
    "role":{"type":"object","additionalProperties":false,"required":["role_id","role_title","owner_role_id","validity_frontier"],"properties":{"role_id":{"type":"string","minLength":1},"role_title":{"type":"string","minLength":1},"owner_role_id":{"type":"string","minLength":1},"validity_frontier":{"$ref":"#/$defs/frontier"}}},
    "requirements":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/requirement"}},
    "coverage":{"type":"object","additionalProperties":false,"required":["material_requirement_count","attributable_material_count","coverage_complete"],"properties":{"material_requirement_count":{"type":"integer","minimum":0},"attributable_material_count":{"type":"integer","minimum":0},"coverage_complete":{"const":true}}},
    "claims":{"type":"object","additionalProperties":false,"required":["requirements_normalized","exact_contract_bound","material_requirements_attributable","job_relevance_rationales_present","evidence_standards_present","challengeability_preserved","candidate_comparison_authorized","employment_decision_authorized","authority_created","responsibility_accepted","action_permit_created","execution_admitted","external_effect_performed","universal_lawfulness_established"],"properties":{"requirements_normalized":{"const":true},"exact_contract_bound":{"const":true},"material_requirements_attributable":{"const":true},"job_relevance_rationales_present":{"const":true},"evidence_standards_present":{"const":true},"challengeability_preserved":{"const":true},"candidate_comparison_authorized":{"const":false},"employment_decision_authorized":{"const":false},"authority_created":{"const":false},"responsibility_accepted":{"const":false},"action_permit_created":{"const":false},"execution_admitted":{"const":false},"external_effect_performed":{"const":false},"universal_lawfulness_established":{"const":false}}},
    "non_effects":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "next_safe_action":{"const":"REQUIREMENT_RECEIPT_READY_FOR_LOCAL_COMPARISON_ONLY"},
    "content_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "$defs":{
    "frontier":{"type":"object","additionalProperties":false,"required":["repository","revision","observed_at"],"properties":{"repository":{"const":"Matawaka/uu-aap"},"revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},"observed_at":{"type":"string","format":"date-time"}}},
    "source":{"type":"object","additionalProperties":false,"required":["input_id","input_hash"],"properties":{"input_id":{"type":"string","minLength":1},"input_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}},
    "requirement":{"type":"object","additionalProperties":false,"required":["requirement_id","text","owner_role_id","job_relevance_rationale","evidence_standard","material","challengeable","accepted_evidence_kinds"],"properties":{"requirement_id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"owner_role_id":{"type":"string","minLength":1},"job_relevance_rationale":{"type":"string","minLength":1},"evidence_standard":{"type":"string","minLength":1},"material":{"type":"boolean"},"challengeable":{"type":"boolean"},"accepted_evidence_kinds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["work_history","skill","work_sample","certification","candidate_explanation"]}}}}
  }
}
