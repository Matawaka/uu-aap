{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.example/products/honest-hiring/v0.1/local-mvp/input.schema.json",
  "title": "Honest Hiring Local Comparison Input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol","version","artifact_type","input_id","contract_binding","evaluation_frontier","role","candidate","review_constraints","freeshield","controls","content_hash"],
  "properties": {
    "protocol": {"const": "HONEST-HIRING-LOCAL-MVP"},
    "version": {"const": "0.1"},
    "artifact_type": {"const": "HonestHiringComparisonInput"},
    "input_id": {"type":"string","pattern":"^urn:uu-aap:honest-hiring:comparison-input:[a-z0-9][a-z0-9:-]{2,191}$"},
    "contract_binding": {
      "type":"object","additionalProperties":false,
      "required":["contract_id","product_id","product_version","content_hash"],
      "properties": {
        "contract_id":{"const":"honest-hiring-product-contract"},
        "product_id":{"const":"honest-hiring"},
        "product_version":{"const":"0.1"},
        "content_hash":{"const":"sha256:796580b9a4dc3eb9f7b7bd9215ed1b9379182786caeafbdb15fada4353f1d2ae"}
      }
    },
    "evaluation_frontier": {"$ref":"#/$defs/frontier"},
    "role": {
      "type":"object","additionalProperties":false,
      "required":["role_id","role_title","owner_role_id","validity_frontier","tasks","requirements"],
      "properties": {
        "role_id":{"type":"string","minLength":1},
        "role_title":{"type":"string","minLength":1},
        "owner_role_id":{"type":"string","minLength":1},
        "validity_frontier":{"$ref":"#/$defs/frontier"},
        "tasks":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "requirements":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/requirement"}}
      }
    },
    "candidate": {
      "type":"object","additionalProperties":false,
      "required":["candidate_packet_id","fictional","evidence_items","claims","declared_context"],
      "properties": {
        "candidate_packet_id":{"type":"string","minLength":1},
        "fictional":{"const":true},
        "evidence_items":{"type":"array","items":{"$ref":"#/$defs/evidence"}},
        "claims":{"type":"array","items":{"$ref":"#/$defs/claim"}},
        "declared_context":{"type":"array","items":{"$ref":"#/$defs/context"}}
      }
    },
    "review_constraints": {
      "type":"object","additionalProperties":false,
      "required":["review_id","allowed_data_classes","prohibited_features","global_ranking_allowed","external_effects_allowed","challenge_supported","employment_decision_in_scope","cross_context_correlation_allowed"],
      "properties": {
        "review_id":{"type":"string","minLength":1},
        "allowed_data_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "prohibited_features":{"type":"array","minItems":14,"maxItems":14,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "global_ranking_allowed":{"const":false},
        "external_effects_allowed":{"const":false},
        "challenge_supported":{"const":true},
        "employment_decision_in_scope":{"const":false},
        "cross_context_correlation_allowed":{"const":false}
      }
    },
    "freeshield": {
      "type":"object","additionalProperties":false,
      "required":["assessment_input","assessment_receipt"],
      "properties": {
        "assessment_input":{"type":"object"},
        "assessment_receipt":{"type":"object"}
      }
    },
    "controls": {
      "type":"object","additionalProperties":false,
      "required":["local_only","read_only","network_access_required","filesystem_write_required","provider_invocation_available","ats_mutation_available","communication_available","global_ranking_available","employment_decision_available","human_disposition_available","action_permit_creation_available","execution_available","external_effect_available","automatic_retry"],
      "properties": {
        "local_only":{"const":true},"read_only":{"const":true},
        "network_access_required":{"const":false},"filesystem_write_required":{"const":false},
        "provider_invocation_available":{"const":false},"ats_mutation_available":{"const":false},
        "communication_available":{"const":false},"global_ranking_available":{"const":false},
        "employment_decision_available":{"const":false},"human_disposition_available":{"const":false},
        "action_permit_creation_available":{"const":false},"execution_available":{"const":false},
        "external_effect_available":{"const":false},"automatic_retry":{"const":false}
      }
    },
    "content_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "frontier": {
      "type":"object","additionalProperties":false,"required":["repository","revision","observed_at"],
      "properties":{"repository":{"const":"Matawaka/uu-aap"},"revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},"observed_at":{"type":"string","format":"date-time"}}
    },
    "requirement": {
      "type":"object","additionalProperties":false,
      "required":["requirement_id","text","owner_role_id","job_relevance_rationale","evidence_standard","material","challengeable","accepted_evidence_kinds"],
      "properties": {
        "requirement_id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},
        "owner_role_id":{"type":"string","minLength":1},"job_relevance_rationale":{"type":"string","minLength":1},
        "evidence_standard":{"type":"string","minLength":1},"material":{"type":"boolean"},"challengeable":{"type":"boolean"},
        "accepted_evidence_kinds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["work_history","skill","work_sample","certification","candidate_explanation"]}}
      }
    },
    "evidence": {
      "type":"object","additionalProperties":false,
      "required":["evidence_id","kind","status","data_class","source_ref","provenance_ref","digest","submitted_for_requirement_ids","feature_tags"],
      "properties": {
        "evidence_id":{"type":"string","minLength":1},"kind":{"enum":["work_history","skill","work_sample","certification","candidate_explanation"]},
        "status":{"enum":["verified","unverified","unavailable","stale","conflicting","UNKNOWN"]},
        "data_class":{"const":"candidate-job-evidence"},"source_ref":{"type":"string","minLength":1},"provenance_ref":{"type":"string","minLength":1},
        "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "submitted_for_requirement_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "feature_tags":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "claim": {
      "type":"object","additionalProperties":false,"required":["claim_id","text","status","requirement_refs","evidence_refs"],
      "properties":{"claim_id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"status":{"enum":["verified","unverified","unavailable","stale","conflicting","UNKNOWN"]},"requirement_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}
    },
    "context": {
      "type":"object","additionalProperties":false,"required":["context_id","text","requirement_refs","data_class","feature_tags"],
      "properties":{"context_id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"requirement_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"data_class":{"const":"candidate-declared-context-data"},"feature_tags":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}
    }
  }
}
