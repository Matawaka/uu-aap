{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:uu-aap:scoped-attestation-bridge-input-schema:0.1",
  "type":"object",
  "required":["schema","artifact","evidence_items","observations"],
  "additionalProperties":false,
  "$defs":{
    "evidence":{"type":"object","required":["id","kind","source_layer","summary","payload"],"additionalProperties":false,"properties":{"id":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"source_layer":{"type":"string","minLength":1},"summary":{"type":"string","minLength":1},"payload":{"type":"object"}}},
    "cawg":{"type":"object","required":["assertion_version","validation_status","named_actor_ref","named_actor_label","roles","credential_type","referenced_assertions","validated_at","validator_details"],"additionalProperties":false,"properties":{"assertion_version":{"const":"1.3"},"validation_status":{"enum":["TRUSTED","WELL_FORMED","REVOKED","INVALID","NETWORK_REQUIRED"]},"named_actor_ref":{"type":"string","minLength":1},"named_actor_label":{"type":"string","minLength":1},"roles":{"type":"array","items":{"type":"string","minLength":1}},"credential_type":{"type":"string","minLength":1},"referenced_assertions":{"type":"array","items":{"type":"string","minLength":1}},"validated_at":{"type":"string"},"validator_details":{"type":"object"}}},
    "review":{"type":"object","required":["vcdm_version","verification_status","issuer_ref","credential_subject_refs","review_scope","limitations","review_date","verifier_details"],"additionalProperties":false,"properties":{"vcdm_version":{"const":"2.0"},"verification_status":{"enum":["VALID","INVALID","UNKNOWN"]},"issuer_ref":{"type":"string","minLength":1},"credential_subject_refs":{"type":"array","items":{"type":"string","minLength":1}},"review_scope":{"type":"string","minLength":1},"limitations":{"type":"array","items":{"type":"string","minLength":1}},"review_date":{"type":"string"},"verifier_details":{"type":"object"}}}
  },
  "properties":{
    "schema":{"const":"urn:uu-aap:scoped-attestation-bridge-input:0.1"},
    "artifact":{"type":"object","required":["id","description"],"additionalProperties":false,"properties":{"id":{"type":"string","minLength":1},"description":{"type":"string","minLength":1}}},
    "evidence_items":{"type":"array","items":{"$ref":"#/$defs/evidence"}},
    "observations":{"type":"array","items":{"oneOf":[
      {"type":"object","required":["id","kind","evidence_refs","payload"],"additionalProperties":false,"properties":{"id":{"type":"string","minLength":1},"kind":{"const":"CAWG_IDENTITY_VALIDATION"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"payload":{"$ref":"#/$defs/cawg"}}},
      {"type":"object","required":["id","kind","evidence_refs","payload"],"additionalProperties":false,"properties":{"id":{"type":"string","minLength":1},"kind":{"const":"W3C_VC_REVIEW_ATTESTATION"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"payload":{"$ref":"#/$defs/review"}}}
    ]}}
  }
}
