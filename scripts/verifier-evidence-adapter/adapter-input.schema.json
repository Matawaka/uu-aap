{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:evidence-adapter-input-schema:0.1",
  "title": "UU-AAP Evidence Adapter Input v0.1",
  "type": "object",
  "required": [
    "schema",
    "artifact",
    "observations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "urn:uu-aap:evidence-adapter-input:0.1"
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "adapter_id",
          "source_layer",
          "summary",
          "loss_notes",
          "payload"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "adapter_id": {
            "type": "string",
            "minLength": 1
          },
          "source_layer": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "loss_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  }
}
