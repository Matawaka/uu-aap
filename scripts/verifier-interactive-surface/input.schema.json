{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:interactive-verifier-input-schema:0.1",
  "title": "UU-AAP Interactive Verifier Input v0.1",
  "type": "object",
  "required": [
    "schema",
    "artifact",
    "evidence_items",
    "dimension_claims",
    "related_observations",
    "warnings",
    "disputes"
  ],
  "additionalProperties": false,
  "$defs": {
    "dimension": {
      "type": "object",
      "required": [
        "value",
        "evaluation",
        "source_layer",
        "evidence_refs",
        "explanation",
        "does_not_establish"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "evaluation": {
          "enum": [
            "OBSERVED",
            "SUPPORTED",
            "NOT_SUPPORTED",
            "UNKNOWN",
            "NOT_EVALUATED",
            "NOT_APPLICABLE"
          ]
        },
        "source_layer": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "explanation": {"type": "string", "minLength": 1},
        "does_not_establish": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "kind", "source_layer", "summary", "payload"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "source_layer": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "payload": {"type": "object"}
      }
    }
  },
  "properties": {
    "schema": {"const": "urn:uu-aap:interactive-verifier-input:0.1"},
    "artifact": {
      "type": "object",
      "required": ["id", "description"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "evidence_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "dimension_claims": {
      "type": "object",
      "required": [
        "integrity",
        "identity",
        "provenance",
        "availability",
        "authority",
        "responsibility",
        "truth"
      ],
      "additionalProperties": false,
      "properties": {
        "integrity": {"$ref": "#/$defs/dimension"},
        "identity": {"$ref": "#/$defs/dimension"},
        "provenance": {"$ref": "#/$defs/dimension"},
        "availability": {"$ref": "#/$defs/dimension"},
        "authority": {"$ref": "#/$defs/dimension"},
        "responsibility": {"$ref": "#/$defs/dimension"},
        "truth": {"$ref": "#/$defs/dimension"}
      }
    },
    "related_observations": {"type": "object"},
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "disputes": {"type": "array", "items": {"type": "object"}}
  }
}
