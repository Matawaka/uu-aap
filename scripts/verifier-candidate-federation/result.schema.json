{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:federated-candidate-set:0.1",
  "title": "UU-AAP P1.9 Federated Candidate Set v0.1",
  "type": "object",
  "required": [
    "schema", "artifact", "dimension_order", "source_order", "source_results",
    "candidate_buckets", "auxiliary_attestations", "source_warnings", "federation_policy",
    "aggregate_score_present", "aggregate_verdict_present"
  ],
  "properties": {
    "schema": {"const": "urn:uu-aap:federated-candidate-set:0.1"},
    "artifact": {"$ref": "#/$defs/artifact"},
    "dimension_order": {
      "const": ["integrity", "identity", "provenance", "availability", "authority", "responsibility", "truth"]
    },
    "source_order": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["P1.4_ADAPTER", "P1.8_ATTESTATION"]}
    },
    "source_results": {
      "type": "object",
      "required": ["P1.4_ADAPTER", "P1.8_ATTESTATION"],
      "properties": {
        "P1.4_ADAPTER": {
          "type": "object",
          "required": ["schema", "artifact"],
          "properties": {
            "schema": {"const": "urn:uu-aap:evidence-adapter-result:0.1"},
            "artifact": {"$ref": "#/$defs/artifact"}
          }
        },
        "P1.8_ATTESTATION": {
          "type": "object",
          "required": ["schema", "artifact"],
          "properties": {
            "schema": {"const": "urn:uu-aap:scoped-attestation-bridge-result:0.1"},
            "artifact": {"$ref": "#/$defs/artifact"}
          }
        }
      },
      "additionalProperties": false
    },
    "candidate_buckets": {
      "type": "object",
      "required": ["integrity", "identity", "provenance", "availability", "authority", "responsibility", "truth"],
      "properties": {
        "integrity": {"$ref": "#/$defs/candidateArray"},
        "identity": {"$ref": "#/$defs/candidateArray"},
        "provenance": {"$ref": "#/$defs/candidateArray"},
        "availability": {"$ref": "#/$defs/candidateArray"},
        "authority": {"$ref": "#/$defs/candidateArray"},
        "responsibility": {"$ref": "#/$defs/candidateArray"},
        "truth": {"$ref": "#/$defs/candidateArray"}
      },
      "additionalProperties": false
    },
    "auxiliary_attestations": {
      "type": "object",
      "required": ["role_attestations", "review_attestations"],
      "properties": {
        "role_attestations": {"type": "array", "items": {"type": "object"}},
        "review_attestations": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "source_warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_family", "code", "message"],
        "properties": {
          "source_family": {"enum": ["P1.4_ADAPTER", "P1.8_ATTESTATION"]},
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "federation_policy": {
      "type": "object",
      "required": [
        "federation_performs_acceptance", "source_count_establishes_confidence",
        "source_order_establishes_priority", "same_dimension_candidates_imply_consensus",
        "multiple_sources_imply_independent_witnesses", "cross_dimension_promotion_permitted",
        "auxiliary_attestations_are_candidates", "identity_to_authority_promotion_permitted",
        "truth_promotion_permitted", "aggregate_score_permitted", "aggregate_verdict_permitted"
      ],
      "properties": {
        "federation_performs_acceptance": {"const": false},
        "source_count_establishes_confidence": {"const": false},
        "source_order_establishes_priority": {"const": false},
        "same_dimension_candidates_imply_consensus": {"const": false},
        "multiple_sources_imply_independent_witnesses": {"const": false},
        "cross_dimension_promotion_permitted": {"const": false},
        "auxiliary_attestations_are_candidates": {"const": false},
        "identity_to_authority_promotion_permitted": {"const": false},
        "truth_promotion_permitted": {"const": false},
        "aggregate_score_permitted": {"const": false},
        "aggregate_verdict_permitted": {"const": false}
      },
      "additionalProperties": false
    },
    "aggregate_score_present": {"const": false},
    "aggregate_verdict_present": {"const": false}
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["value", "evaluation", "source_layer", "evidence_refs", "explanation", "does_not_establish"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "evaluation": {"enum": ["OBSERVED", "SUPPORTED", "NOT_SUPPORTED", "UNKNOWN", "NOT_EVALUATED", "NOT_APPLICABLE"]},
        "source_layer": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "explanation": {"type": "string", "minLength": 1},
        "does_not_establish": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "federated_candidate_id", "source_family", "source_candidate_id",
        "source_observation_id", "source_record_schema", "dimension", "claim"
      ],
      "properties": {
        "federated_candidate_id": {"type": "string", "minLength": 1},
        "source_family": {"enum": ["P1.4_ADAPTER", "P1.8_ATTESTATION"]},
        "source_candidate_id": {"type": "string", "minLength": 1},
        "source_observation_id": {"type": "string", "minLength": 1},
        "source_record_schema": {"enum": ["urn:uu-aap:evidence-adapter-result:0.1", "urn:uu-aap:scoped-attestation-bridge-result:0.1"]},
        "dimension": {"enum": ["integrity", "identity", "provenance", "availability", "authority", "responsibility", "truth"]},
        "claim": {"$ref": "#/$defs/claim"}
      },
      "additionalProperties": false
    },
    "candidateArray": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
  }
}
