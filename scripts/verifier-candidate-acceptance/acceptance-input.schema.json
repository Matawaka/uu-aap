{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uu-aap:candidate-acceptance-input-schema:0.1",
  "title": "UU-AAP Candidate Acceptance Input v0.1",
  "type": "object",
  "required": ["schema", "adapter_result", "acceptance_event"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "urn:uu-aap:candidate-acceptance-input:0.1"},
    "adapter_result": {"type": "object"},
    "acceptance_event": {
      "type": "object",
      "required": ["id", "actor_ref", "scope", "dispositions"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "actor_ref": {"type": "string", "minLength": 1},
        "scope": {"const": "verifier_candidate_materialization"},
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["candidate_id", "decision", "rationale"],
            "additionalProperties": false,
            "properties": {
              "candidate_id": {"type": "string", "minLength": 1},
              "decision": {"enum": ["ACCEPT", "REJECT", "DEFER"]},
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
