{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/server/kontur/v0.1/kontur-activation-intent.schema.json",
  "title": "KONTURActivationIntent v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "artifact_type", "artifact_version", "intent_id", "declared_at",
    "intended_transition", "git_revision", "system_id", "server_instance_id",
    "readiness_epoch", "fencing_epoch", "frontier_binding", "readiness_signal_binding",
    "aggregation_policy_binding", "responsibility_policy_binding", "activation_policy_binding",
    "human_activation_review_decision_binding", "health_binding", "holder_id", "responsibility_scopes",
    "lease", "human_intent", "claims"
  ],
  "properties": {
    "$schema": {"type": "string", "pattern": "(^|.*/)kontur-activation-intent\\.schema\\.json$"},
    "artifact_type": {"const": "KONTURActivationIntent"},
    "artifact_version": {"const": "0.1"},
    "intent_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:activation-intent:"},
    "declared_at": {"type": "string", "format": "date-time"},
    "intended_transition": {"const": "activate"},
    "git_revision": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
    "system_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:system:"},
    "server_instance_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:server:"},
    "readiness_epoch": {"type": "integer", "minimum": 1},
    "fencing_epoch": {"type": "integer", "minimum": 1},
    "frontier_binding": {"$ref": "#/$defs/binding"},
    "readiness_signal_binding": {"$ref": "#/$defs/binding"},
    "aggregation_policy_binding": {"$ref": "#/$defs/policyBinding"},
    "responsibility_policy_binding": {"$ref": "#/$defs/policyBinding"},
    "activation_policy_binding": {"$ref": "#/$defs/policyBinding"},
    "human_activation_review_decision_binding": {"$ref": "#/$defs/harDecisionBinding"},
    "health_binding": {"$ref": "#/$defs/binding"},
    "holder_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:holder:"},
    "responsibility_scopes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "lease": {"$ref": "#/$defs/lease"},
    "human_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_ref", "declaration_type", "declared_at", "nonce", "explicit", "identity_assurance"],
      "properties": {
        "actor_ref": {"type": "string", "minLength": 1},
        "declaration_type": {"const": "explicit_human_activation_intent"},
        "declared_at": {"type": "string", "format": "date-time"},
        "nonce": {"type": "string", "pattern": "^urn:uu-aap:kontur:activation-intent-nonce:"},
        "explicit": {"const": true},
        "identity_assurance": {"const": "declared_not_cryptographically_verified"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_activation_intent_declared", "exact_activation_parameters_bound",
        "human_activation_review_approval_bound", "human_identity_cryptographically_verified",
        "kernel_activated", "responsibility_state_created", "responsibility_accepted",
        "execution_authority_granted", "legal_responsibility_determined", "legal_effect_established",
        "moral_blame_assigned", "truth_certified", "poai_materialization_event_recorded",
        "universal_canonicality_established"
      ],
      "properties": {
        "human_activation_intent_declared": {"const": true},
        "exact_activation_parameters_bound": {"const": true},
        "human_activation_review_approval_bound": {"const": true},
        "human_identity_cryptographically_verified": {"const": false},
        "kernel_activated": {"const": false},
        "responsibility_state_created": {"const": false},
        "responsibility_accepted": {"const": false},
        "execution_authority_granted": {"const": false},
        "legal_responsibility_determined": {"const": false},
        "legal_effect_established": {"const": false},
        "moral_blame_assigned": {"const": false},
        "truth_certified": {"const": false},
        "poai_materialization_event_recorded": {"const": false},
        "universal_canonicality_established": {"const": false}
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object", "additionalProperties": false,
      "required": ["canonicalization", "digest_algorithm", "digest_encoding", "value"],
      "properties": {
        "canonicalization": {"const": "RFC8785-JCS"},
        "digest_algorithm": {"const": "SHA-256"},
        "digest_encoding": {"const": "hex"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "artifact_ref", "digest"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "harDecisionBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "artifact_ref", "digest"],
      "properties": {
        "artifact_type": {"const": "KONTURHumanActivationReviewDecision"},
        "artifact_ref": {"type": "string", "pattern": "^urn:uu-aap:kontur:human-activation-review-decision:"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "policyBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "artifact_ref", "policy_version", "digest"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1},
        "policy_version": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "lease": {
      "type": "object", "additionalProperties": false,
      "required": ["lease_id", "holder_id", "server_instance_id", "issued_at", "expires_at"],
      "properties": {
        "lease_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:lease:"},
        "holder_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:holder:"},
        "server_instance_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:server:"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
