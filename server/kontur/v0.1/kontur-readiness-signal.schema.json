{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/server/kontur/v0.1/kontur-readiness-signal.schema.json",
  "title": "KONTURReadinessSignal v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "artifact_type", "artifact_version", "signal_id", "system_id", "server_instance_id", "readiness_epoch", "emitted_at", "valid_until", "source_ref", "checks", "ready", "claims"],
  "properties": {
    "$schema": {"type": "string", "pattern": "(^|.*/)kontur-readiness-signal\\.schema\\.json$"},
    "artifact_type": {"const": "KONTURReadinessSignal"},
    "artifact_version": {"const": "0.1"},
    "signal_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:readiness:"},
    "system_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:system:"},
    "server_instance_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:server:"},
    "readiness_epoch": {"type": "integer", "minimum": 1},
    "emitted_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "source_ref": {"type": "string", "minLength": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "observed_at", "evidence_ref"],
        "properties": {
          "check_id": {
            "enum": [
              "protocol_registry_ready",
              "coordination_ready",
              "authority_ready",
              "provenance_ready",
              "causal_qualification_ready",
              "server_health_ready"
            ]
          },
          "status": {"enum": ["pass", "fail"]},
          "observed_at": {"type": "string", "format": "date-time"},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "ready": {"type": "boolean"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness_observed", "execution_authority_granted", "responsibility_accepted", "kernel_activated", "legal_responsibility_determined", "moral_blame_assigned", "truth_certified", "poai_materialization_event_recorded", "universal_canonicality_established"],
      "properties": {
        "readiness_observed": {"const": true},
        "execution_authority_granted": {"const": false},
        "responsibility_accepted": {"const": false},
        "kernel_activated": {"const": false},
        "legal_responsibility_determined": {"const": false},
        "moral_blame_assigned": {"const": false},
        "truth_certified": {"const": false},
        "poai_materialization_event_recorded": {"const": false},
        "universal_canonicality_established": {"const": false}
      }
    }
  }
}
