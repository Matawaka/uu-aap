{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/server/kontur/v0.1/kontur-current-main-frontier-verification.schema.json",
  "title": "KONTURCurrentMainFrontierVerificationReceipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "artifact_type", "artifact_version", "verification_id", "verified_at",
    "repository", "workflow_context", "frontier_binding", "frontier_git_revision",
    "decision", "claims"
  ],
  "properties": {
    "$schema": {"type": "string", "pattern": "(^|.*/)kontur-current-main-frontier-verification\\.schema\\.json$"},
    "artifact_type": {"const": "KONTURCurrentMainFrontierVerificationReceipt"},
    "artifact_version": {"const": "0.1"},
    "verification_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:current-main-frontier-verification:"},
    "verified_at": {"type": "string", "format": "date-time"},
    "repository": {"const": "Matawaka/uu-aap"},
    "workflow_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_name", "ref", "github_sha", "checkout_sha"],
      "properties": {
        "event_name": {"const": "push"},
        "ref": {"const": "refs/heads/main"},
        "github_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "checkout_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "frontier_binding": {"$ref": "#/$defs/binding"},
    "frontier_git_revision": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
    "decision": {"const": "current_main_frontier_verified_for_workflow_event"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_context_is_main_push", "github_sha_matches_checkout_sha",
        "frontier_revision_matches_github_sha", "frontier_revision_matches_checkout_sha",
        "current_main_frontier_verified_for_workflow_event", "activation_prompt_may_be_requested",
        "human_activation_step_still_required", "kernel_activated", "responsibility_state_created",
        "responsibility_accepted", "execution_authority_granted", "repository_ownership_transferred",
        "canonical_origin_mutated", "legal_responsibility_determined", "truth_certified",
        "universal_canonicality_established"
      ],
      "properties": {
        "workflow_context_is_main_push": {"const": true},
        "github_sha_matches_checkout_sha": {"const": true},
        "frontier_revision_matches_github_sha": {"const": true},
        "frontier_revision_matches_checkout_sha": {"const": true},
        "current_main_frontier_verified_for_workflow_event": {"const": true},
        "activation_prompt_may_be_requested": {"const": true},
        "human_activation_step_still_required": {"const": true},
        "kernel_activated": {"const": false},
        "responsibility_state_created": {"const": false},
        "responsibility_accepted": {"const": false},
        "execution_authority_granted": {"const": false},
        "repository_ownership_transferred": {"const": false},
        "canonical_origin_mutated": {"const": false},
        "legal_responsibility_determined": {"const": false},
        "truth_certified": {"const": false},
        "universal_canonicality_established": {"const": false}
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "digest_algorithm", "digest_encoding", "value"],
      "properties": {
        "canonicalization": {"const": "RFC8785-JCS"},
        "digest_algorithm": {"const": "SHA-256"},
        "digest_encoding": {"const": "hex"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "artifact_ref", "digest"],
      "properties": {
        "artifact_type": {"const": "KONTURActivationFrontierReceipt"},
        "artifact_ref": {"type": "string", "pattern": "^urn:uu-aap:kontur:activation-frontier:"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
