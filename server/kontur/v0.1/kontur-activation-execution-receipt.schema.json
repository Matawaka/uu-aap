{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/server/kontur/v0.1/kontur-activation-execution-receipt.schema.json",
  "title": "KONTURActivationExecutionReceipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "artifact_type", "artifact_version", "receipt_id", "execution_mode", "status",
    "completed_at", "git_revision", "system_id", "server_instance_id", "execute_command_binding",
    "activation_preflight_binding", "transition_receipt_binding", "ledger_entry_binding",
    "recovered_head_binding", "ledger_sequence", "responsibility_generation", "lifecycle_state",
    "holder_id", "responsibility_scopes", "fencing_epoch", "claims"
  ],
  "properties": {
    "$schema": {"type": "string", "pattern": "(^|.*/)kontur-activation-execution-receipt\\.schema\\.json$"},
    "artifact_type": {"const": "KONTURActivationExecutionReceipt"},
    "artifact_version": {"const": "0.1"},
    "receipt_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:activation-execution:"},
    "execution_mode": {"enum": ["test_only", "live"]},
    "status": {"enum": ["activation_completed_test_only", "activation_completed_live"]},
    "completed_at": {"type": "string", "format": "date-time"},
    "git_revision": {"type": "string", "pattern": "^git:[0-9a-f]{40}$"},
    "system_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:system:"},
    "server_instance_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:server:"},
    "execute_command_binding": {"$ref": "#/$defs/binding"},
    "activation_preflight_binding": {"$ref": "#/$defs/binding"},
    "transition_receipt_binding": {"$ref": "#/$defs/binding"},
    "ledger_entry_binding": {"$ref": "#/$defs/binding"},
    "recovered_head_binding": {"$ref": "#/$defs/binding"},
    "ledger_sequence": {"const": 1},
    "responsibility_generation": {"const": 1},
    "lifecycle_state": {"const": "active"},
    "holder_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:holder:"},
    "responsibility_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fencing_epoch": {"type": "integer", "minimum": 1},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_human_execute_command_verified", "kernel_activation_transition_produced",
        "genesis_ledger_entry_durably_committed", "authoritative_active_head_recovered",
        "structural_responsibility_state_established", "local_kontur_activation_completed",
        "live_kontur_activated", "execution_authority_granted", "legal_responsibility_determined",
        "legal_effect_established", "moral_blame_assigned", "truth_certified",
        "distributed_consensus_established", "poai_materialization_event_recorded",
        "universal_canonicality_established"
      ],
      "properties": {
        "final_human_execute_command_verified": {"const": true},
        "kernel_activation_transition_produced": {"const": true},
        "genesis_ledger_entry_durably_committed": {"const": true},
        "authoritative_active_head_recovered": {"const": true},
        "structural_responsibility_state_established": {"const": true},
        "local_kontur_activation_completed": {"const": true},
        "live_kontur_activated": {"type": "boolean"},
        "execution_authority_granted": {"const": false},
        "legal_responsibility_determined": {"const": false},
        "legal_effect_established": {"const": false},
        "moral_blame_assigned": {"const": false},
        "truth_certified": {"const": false},
        "distributed_consensus_established": {"const": false},
        "poai_materialization_event_recorded": {"const": false},
        "universal_canonicality_established": {"const": false}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"execution_mode": {"const": "test_only"}}}, "then": {"properties": {"status": {"const": "activation_completed_test_only"}, "claims": {"properties": {"live_kontur_activated": {"const": false}}}}}},
    {"if": {"properties": {"execution_mode": {"const": "live"}}}, "then": {"properties": {"status": {"const": "activation_completed_live"}, "claims": {"properties": {"live_kontur_activated": {"const": true}}}}}}
  ],
  "$defs": {
    "digest": {"type": "object", "additionalProperties": false, "required": ["canonicalization", "digest_algorithm", "digest_encoding", "value"], "properties": {"canonicalization": {"const": "RFC8785-JCS"}, "digest_algorithm": {"const": "SHA-256"}, "digest_encoding": {"const": "hex"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["artifact_type", "artifact_ref", "digest"], "properties": {"artifact_type": {"type": "string", "minLength": 1}, "artifact_ref": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}}
  }
}
