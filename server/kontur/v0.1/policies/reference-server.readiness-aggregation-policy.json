      "allowed_artifact_type": "PoAIAuthorityVerificationResult"
    },
    {
      "check_id": "provenance_ready",
      "producer_id": "urn:uu-aap:producer:origin-provenance-validator",
      "allowed_artifact_type": "ProvenanceCompletionReceipt"
    },
    {
      "check_id": "causal_qualification_ready",
      "producer_id": "urn:uu-aap:producer:causal-qualification-validator",
