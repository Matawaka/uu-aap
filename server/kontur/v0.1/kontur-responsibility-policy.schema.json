{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/raw/main/server/kontur/v0.1/kontur-responsibility-policy.schema.json",
  "title": "KONTURResponsibilityPolicy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "artifact_type", "artifact_version", "policy_id", "policy_version", "responsibility_scope_id", "system_id", "server_instance_id", "required_readiness_checks", "responsibility_scope_allowlist", "invariants", "state_machine", "claims"],
  "properties": {
    "$schema": {"type": "string", "pattern": "(^|.*/)kontur-responsibility-policy\\.schema\\.json$"},
    "artifact_type": {"const": "KONTURResponsibilityPolicy"},
    "artifact_version": {"const": "0.1"},
    "policy_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:responsibility-policy:"},
    "policy_version": {"type": "integer", "minimum": 1},
    "responsibility_scope_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:responsibility-scope:"},
    "system_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:system:"},
    "server_instance_id": {"type": "string", "pattern": "^urn:uu-aap:kontur:server:"},
    "required_readiness_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "protocol_registry_ready",
          "coordination_ready",
          "authority_ready",
          "provenance_ready",
          "causal_qualification_ready",
          "server_health_ready"
        ]
      }
    },
    "responsibility_scope_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "server.readiness.consume",
          "server.responsibility.maintain",
          "server.degradation.control",
          "server.transition.audit"
        ]
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["single_active_holder", "epoch_monotonic", "fencing_required", "lease_required", "successor_generation_increment", "health_fail_closed", "fresh_readiness_required_for_recovery", "retired_terminal", "scalar_responsibility_score_allowed"],
      "properties": {
        "single_active_holder": {"const": true},
        "epoch_monotonic": {"const": true},
        "fencing_required": {"const": true},
        "lease_required": {"const": true},
        "successor_generation_increment": {"const": 1},
        "health_fail_closed": {"const": true},
        "fresh_readiness_required_for_recovery": {"const": true},
        "retired_terminal": {"const": true},
        "scalar_responsibility_score_allowed": {"const": false}
      }
    },
    "state_machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "transitions"],
      "properties": {
        "states": {
          "const": ["inactive", "active", "degraded", "suspended", "retired"]
        },
        "transitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["activate", "heartbeat", "degrade", "suspend", "resume", "retire"],
          "properties": {
            "activate": {"const": {"from": ["inactive"], "to": "active"}},
            "heartbeat": {"const": {"from": ["active"], "to": "active"}},
            "degrade": {"const": {"from": ["active"], "to": "degraded"}},
            "suspend": {"const": {"from": ["active", "degraded"], "to": "suspended"}},
            "resume": {"const": {"from": ["degraded", "suspended"], "to": "active"}},
            "retire": {"const": {"from": ["active", "degraded", "suspended"], "to": "retired"}}
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_responsibility_determined", "legal_effect_established", "moral_blame_assigned", "moral_correctness_established", "truth_certified", "universal_causality_established", "poai_materialization_event_recorded", "universal_canonicality_established"],
      "properties": {
        "legal_responsibility_determined": {"const": false},
        "legal_effect_established": {"const": false},
        "moral_blame_assigned": {"const": false},
        "moral_correctness_established": {"const": false},
        "truth_certified": {"const": false},
        "universal_causality_established": {"const": false},
        "poai_materialization_event_recorded": {"const": false},
        "universal_canonicality_established": {"const": false}
      }
    }
  }
}
