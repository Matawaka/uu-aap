{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Matawaka/uu-aap/protection/evidence/replication/v0.1/evidence-replication-receipt.schema.json",
  "title": "EvidenceReplicationReceipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "artifact_version", "replication_id", "observed_at",
    "source_snapshot", "destination_snapshot", "replication_evidence_digest",
    "result", "claims"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "artifact_type": { "const": "EvidenceReplicationReceipt" },
    "artifact_version": { "const": "0.1" },
    "replication_id": { "type": "string", "pattern": "^urn:uu-aap:evidence:replication:[0-9a-f]{24}$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "source_snapshot": { "$ref": "#/$defs/snapshot" },
    "destination_snapshot": { "$ref": "#/$defs/snapshot" },
    "replication_evidence_digest": { "$ref": "#/$defs/digest" },
    "result": { "const": "byte_equivalent_set_verified" },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_equivalent_set_verified",
        "source_destination_descriptor_sets_match",
        "distinct_carrier_refs_declared",
        "physical_independence_proven",
        "origin_established",
        "canonical_successor_established",
        "authority_transferred",
        "custody_transferred",
        "evidence_truth_certified",
        "legal_liability_determined",
        "rescue_authorized",
        "kontur_readiness_established",
        "kontur_activation_authorized",
        "kontur_activated"
      ],
      "properties": {
        "byte_equivalent_set_verified": { "const": true },
        "source_destination_descriptor_sets_match": { "const": true },
        "distinct_carrier_refs_declared": { "const": true },
        "physical_independence_proven": { "const": false },
        "origin_established": { "const": false },
        "canonical_successor_established": { "const": false },
        "authority_transferred": { "const": false },
        "custody_transferred": { "const": false },
        "evidence_truth_certified": { "const": false },
        "legal_liability_determined": { "const": false },
        "rescue_authorized": { "const": false },
        "kontur_readiness_established": { "const": false },
        "kontur_activation_authorized": { "const": false },
        "kontur_activated": { "const": false }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "digest_algorithm", "digest_encoding", "value"],
      "properties": {
        "canonicalization": { "const": "RFC8785-JCS" },
        "digest_algorithm": { "const": "SHA-256" },
        "digest_encoding": { "const": "hex" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_ref", "carrier_ref", "file_count", "files", "file_set_digest"],
      "properties": {
        "snapshot_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "carrier_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "file_count": { "type": "integer", "minimum": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/file" }
        },
        "file_set_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
