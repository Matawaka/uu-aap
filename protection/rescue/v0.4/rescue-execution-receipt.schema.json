{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.example/schema/rescue-execution-receipt-v0.4.json",
  "title": "RescueExecutionReceipt v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_version", "receipt_id", "executed_at", "project_id", "plan_sha256", "authorization_sha256", "authorization_nonce_sha256", "capsule_manifest_sha256", "recovery_source_binding_sha256", "recovery_payload_sha256", "recovered_frontier_commit", "recovered_ref_set_sha256", "git_fsck_full_success", "git_remote_count", "state_replay_scope", "receipt_sha256", "claims"],
  "properties": {
    "artifact_type": {"const": "RescueExecutionReceipt"},
    "artifact_version": {"const": "0.4"},
    "receipt_id": {"type": "string", "minLength": 1},
    "executed_at": {"type": "string", "format": "date-time"},
    "project_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_nonce_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capsule_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery_source_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovered_frontier_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "recovered_ref_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_fsck_full_success": {"const": true},
    "git_remote_count": {"const": 0},
    "state_replay_scope": {"const": "local_state_directory"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_authorization_validated", "noncanonical_recovery_executed", "recovered_repository_integrity_checked", "no_git_remotes", "canonical_successor_established", "ownership_transferred", "kontur_activated", "distributed_consensus_established", "global_replay_prevention_established", "legal_effect_established", "truth_certified"],
      "properties": {
        "human_authorization_validated": {"const": true},
        "noncanonical_recovery_executed": {"const": true},
        "recovered_repository_integrity_checked": {"const": true},
        "no_git_remotes": {"const": true},
        "canonical_successor_established": {"const": false},
        "ownership_transferred": {"const": false},
        "kontur_activated": {"const": false},
        "distributed_consensus_established": {"const": false},
        "global_replay_prevention_established": {"const": false},
        "legal_effect_established": {"const": false},
        "truth_certified": {"const": false}
      }
    }
  }
}
