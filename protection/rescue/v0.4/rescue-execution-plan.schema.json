{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uu-aap.example/schema/rescue-execution-plan-v0.4.json",
  "title": "RescueExecutionPlan v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "artifact_version", "plan_id", "prepared_at", "project_id", "capsule_manifest_sha256", "assessment_sha256", "authorization_sha256", "recovery_source_binding_sha256", "recovery_payload_sha256", "selected_recovery_source_id", "authorized_scope", "frontier_commit", "destination_label", "plan_sha256", "claims"],
  "properties": {
    "artifact_type": {"const": "RescueExecutionPlan"},
    "artifact_version": {"const": "0.4"},
    "plan_id": {"type": "string", "minLength": 1},
    "prepared_at": {"type": "string", "format": "date-time"},
    "project_id": {"type": "string", "minLength": 1},
    "capsule_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assessment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery_source_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_recovery_source_id": {"type": "string", "minLength": 1},
    "authorized_scope": {"const": "reconstruct_noncanonical_git_copy"},
    "frontier_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "destination_label": {"type": "string", "minLength": 1, "maxLength": 255},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capsule_verified", "rescue_eligibility_verified", "human_authorization_validated", "limited_execution_authority_validated", "execution_performed", "canonical_successor_established", "ownership_transferred", "kontur_activated", "distributed_consensus_established"],
      "properties": {
        "capsule_verified": {"const": true},
        "rescue_eligibility_verified": {"const": true},
        "human_authorization_validated": {"const": true},
        "limited_execution_authority_validated": {"const": true},
        "execution_performed": {"const": false},
        "canonical_successor_established": {"const": false},
        "ownership_transferred": {"const": false},
        "kontur_activated": {"const": false},
        "distributed_consensus_established": {"const": false}
      }
    }
  }
}
